## DESCRIPTION
## DBsubject(Statistics)
## DBchapter(Sample survey methods)
## DBsection(Concepts)
## Institution(Northern Arizona University)
## Author('Juhee Park')
## Date (7/22/2014)
## KEYWORDS('statistic', 'sample', 'definition')
## Level(1)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'parserRadioButtons.pl', 'PGcourse.pl');

@slice = num_sort(random_subset(3, 0 .. 4));

@question = (
    'Identify the population',
    'Identify the parameter',
    'Identify the statistic.',
    'Identify the sample',
    'What is the sample size?'
);

$m1 = random(1000,2000);
$m2 = random(600,700,2);
$m3 = random(15,30);

@opts = (
    [
        "entire singers ",
        "$m3/$m1", "percentage of entire singers who are professional"
    ],
    [
        'percentage of entire singers who are professional',
        'range of values in which 95% values fall',
        "$m3 "
    ],
    [ "$m3/$m2 ",               $m1,        'entire choir members' ],
    [ "singers who were asked", "$m3/$m1 ", "$m2 " ],
    [ "$m2 ",                   "$m1 ",     "$m3 " ]
);

@rb =
    map { RadioButtons([ $opts[$_], 'None of the above' ], 0, labels => 'ABC') }
    (0 .. $#opts);

BEGIN_PGML
A choral conductor has [$m1] singers in her choir, some of them are professional singers. The conductor wants to estimate what percentage of singers are professional, 
but can't ask all [$m1], so she instead asks [$m2] singers in front and finds [$m3] who are professionals.

a) [$question[$slice[0]]] [_]{$rb[$slice[0]]}

b) [$question[$slice[1]]] [_]{$rb[$slice[1]]}

c) [$question[$slice[2]]] [_]{$rb[$slice[2]]}

END_PGML

BEGIN_PGML_SOLUTION
a) [$question[$slice[0]]] [$rb[$slice[0]]]

b) [$question[$slice[1]]] [$rb[$slice[1]]]

c) [$question[$slice[2]]] [$rb[$slice[2]]]
END_PGML_SOLUTION

ENDDOCUMENT();  