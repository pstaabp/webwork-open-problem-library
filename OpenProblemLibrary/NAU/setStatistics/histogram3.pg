##DESCRIPTION
## DBsubject(Statistics)
## DBchapter(Exploratory data analysis/descriptive statistics)
## DBsection(Description of distributions)
## Institution(NAU)
## Author(N.Spencer Sitton)
## Level(3)
## KEYWORDS('histogram')
##ENDDESCRIPTION

# File Created: 07/14/05
# Location: Northern Arizona University
# Course: Qauntitative Reasoning

DOCUMENT();
loadMacros(
    'PGstandard.pl',       'PGML.pl',
    'parserPopUp.pl',      'PGnauStats.pl',
    'StatisticalPlots.pl', 'PGcourse.pl'
);

@list = ('Right',               'Left',               'Bi',      'Norm');
@opts = ('skewed to the right', 'skewed to the left', 'bimodal', 'symmetric');
$ind  = random(0, 3);
@data = SpecialData($list[$ind]);
$dx   = 10;                              # bin size
$min  = floor(min(@data) / $dx) * $dx;
$max  = ceil(max(@data) / $dx) * $dx;

$stat_plot = StatPlot(
    xmin            => $min - 10,
    xmax            => $max + 20,
    xtick_delta     =>  10,
    ymin            => -25,
    ytick_delta     =>  25,
    show_grid       =>  0,
    rounded_corners =>  1,
);

$hist_data = $stat_plot->add_histogram(
    ~~@data,
    min          => $min,
    max          => $max,
    bins         => ($max - $min) / $dx,
    fill_color   => 'blue',
    fill_opacity => 0.4,
    stroke_width => 1
);
$stat_plot->axes->yaxis(max => max(@$hist_data) + 25);
$stat_plot->axes->style(aspect_ratio => $max / max(@$hist_data));
$ans = $ans[$ind];

$alt =
    'A histgoram with '
    . scalar(@$hist_data)
    . " bins from $min to $max."
    . 'The heights of the bars are '
    . join(', ', @$hist_data);

$dd = DropDown(~~@opts, $ind);

BEGIN_PGML
Which of the following attributes best describes the histogram below? 

    [_]{$dd}

>>[![$alt]!]{$stat_plot}{400}<<

END_PGML

@explanation = (
    'Because the tail of the data stretched to the right, ',
    'Because the tail of the data stretched to the left, ',
    'Because there are two distinct humps of data, ',
    'Because the data is roughly the same on both sides of the maximum, '
);

BEGIN_PGML_SOLUTION
[$explanation[$ind]] the answer is *[$opts[$ind]]****.
END_PGML_SOLUTION

ENDDOCUMENT();      