##DESCRIPTION
##  A problem that asks students to match a mathematical symbol (less than, greater than)
## to words.
##ENDDESCRIPTION

## ProblemTester('Laura Travis')
## Publisher('Prentice Hall')
## DBsubject(Arithmetic)
## DBchapter(Integers)
## DBsection(Inequalities)
## Date(9/19/2012)
## Institution(Mississippi College)
## Author(John Travis)
## Level(2)
## MO(1)
## TitleText1('Pre-Algebra')
## KEYWORDS('prealgebra','common core','inequality')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'parserPopUp.pl', 'PGcourse.pl');

Context('Numeric');

@slice = random_subset(6, 0 .. 5);

@opts    = ('\(<\)', '\(\leq\)', '\(>\)', '\(\geq\)');
@answers = (0, 1, 2, 3, 1, 3);
@phrases = (
    'Less than...',
    'No more than...',
    'More than...',
    'No less than...',
    'At most...',
    'At least...'
);

@dd = map { DropDown([@opts], $answers[$_], useHTMLSelect => 0) } @slice;

$exp[ $r[0] ]   = "Less than...";
$popup[ $r[0] ] = PopUp([ "?", "<", "<=", ">", ">=" ], "<");

$exp[ $r[1] ]   = "No more than...";
$popup[ $r[1] ] = PopUp([ "?", "<", "<=", ">", ">=" ], "<=");

$exp[ $r[2] ]   = "More than...";
$popup[ $r[2] ] = PopUp([ "?", "<", "<=", ">", ">=" ], ">");

$exp[ $r[3] ]   = "No Less than...";
$popup[ $r[3] ] = PopUp([ "?", "<", "<=", ">", ">=" ], ">=");

$exp[ $r[4] ]   = "At most...";
$popup[ $r[4] ] = PopUp([ "?", "<", "<=", ">", ">=" ], "<=");

$exp[ $r[5] ]   = "At least...";
$popup[ $r[5] ] = PopUp([ "?", "<", "<=", ">", ">=" ], ">=");

#  Text

BEGIN_PGML
Determine which inequality symbol matches each expression:

a) [_]{$dd[0]} [$phrases[$slice[0]]]
b) [_]{$dd[1]} [$phrases[$slice[1]]]
c) [_]{$dd[2]} [$phrases[$slice[2]]]
d) [_]{$dd[3]} [$phrases[$slice[3]]]
e) [_]{$dd[4]} [$phrases[$slice[4]]]
f) [_]{$dd[5]} [$phrases[$slice[5]]]

END_PGML

BEGIN_PGML_SOLUTION
a) [`[$dd[0]]`]
b) [`[$dd[1]]`]
c) [`[$dd[2]]`]
d) [`[$dd[3]]`]
e) [`[$dd[4]]`]
f) [`[$dd[5]]`]
END_PGML_SOLUTION

ENDDOCUMENT();        