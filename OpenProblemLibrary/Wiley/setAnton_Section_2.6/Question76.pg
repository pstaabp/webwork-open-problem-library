#   Comments + Keyword Clarification

#    Anton, Calculus, 2.6.76
# DESCRIPTION
# Find the derivative of a function using the product rule and chain rule

# ENDDESCRIPTION
## DBsubject(Calculus - single variable)
## DBchapter(Differentiation)
## DBsection(Chain rule (without trigonometric functions))
## Institution(John Wiley & Sons)
## Level(2)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('9')
## Section1('2.6')
## Problem1('76')
## KEYWORDS('Derivative', 'Chain rule')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Numeric")->variables->add(u => 'Real');

$a = random(2, 5);
$b = random(3, 7);
$c = random(1, 3);
if ($b - $a * $c == 0) { $c = $c + 1; }
$bmac = $b - $a * $c;

$f  = Formula(" sqrt($a*x+$b)");
$g  = Formula(" x**2 -$c");
$gp = Formula(" 2*x ");
$fg = $f->substitute(x => $g);

$Df  = Formula(" 2*x*$fg ")->reduce;
$Df1 = Formula(" 2*x*sqrt($a*x**2+$bmac) ")->reduce;

BEGIN_PGML
Given that [``f'(x) = [$f] ``] and [` g(x) = [$g]`], find [`F'(x)`] if [`F(x) = f(g(x)) `].

[`F'(x) =`] [_]{$Df1}{50}

END_PGML

BEGIN_PGML_SOLUTION

Since [``f'(x) = [$f] ``] and [` g'(x) = [$gp]`],and
 [` \frac{d}{dx}\left( f(g(x))\right)  = f'(g(x))g'(x)`]

we have
 [`f'(x)  = [$Df] = [$Df1]`]
END_PGML_SOLUTION

ENDDOCUMENT();
