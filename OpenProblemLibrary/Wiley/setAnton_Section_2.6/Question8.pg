#   Comments + Keyword Clarification

#    Anton, Calculus, 2.6.8
# DESCRIPTION
# Find the derivative of a function using the chain rule

# ENDDESCRIPTION
## DBsubject(Calculus - single variable)
## DBchapter(Differentiation)
## DBsection(Chain rule (without trigonometric functions))
## Institution(John Wiley & Sons)
## Level(2)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('9')
## Section1('2.6')
## Problem1('8')
## KEYWORDS('Derivative','Chain rule')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Numeric")->variables->add(u => 'Real');

$a   = random(2, 5);
$a2  = 2 * $a;
$b   = random( 3,  9);
$c   = random(-8, -1);
$p   = random( 4,  7);
$pm1 = $p - 1;

$f = Formula(" u^{$p}")->reduce;
$g = Formula(" $a*x^2+$b*x+$c")->reduce;

$fdisp = $f->substitute(u => $g);
$Df    = $f->D('u');
$Df    = Formula(" $Df ")->reduce;
$Dg    = $g->D('x');
$Dfg   = $Df->substitute(u => $g);
$Dfg   = Formula("$Dfg")->reduce;

#$fP = Formula( "$Df")->reduce;
$output = Formula(" $Dg*$Df ")->reduce;
$deriv  = $output->substitute(u => $g);

BEGIN_PGML

Let [` f(x) =\displaystyle [$fdisp]`].  Find [` f'(x)`].

    [`f'(x) =`] [_]{$deriv}

END_PGML

BEGIN_PGML_SOLUTION
Taking [`  u(x) = [$g] `] in the generalized derivative formula for [` [$f]`] yields

 [```\frac{d \;[$fdisp]}{dx}  = \frac{d \; [[$f]]}{dx} = [$Df] \frac{du}{dx} = [$deriv] .```]

END_PGML_SOLUTION

ENDDOCUMENT();
