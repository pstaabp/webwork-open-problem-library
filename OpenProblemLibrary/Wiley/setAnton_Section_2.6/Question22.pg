#   Comments + Keyword Clarification

#    Anton, Calculus, 2.6.22
# DESCRIPTION
# Find the derivative of a function using the chain rule

# ENDDESCRIPTION
## DBsubject(Calculus - single variable)
## DBchapter(Differentiation)
## DBsection(Chain rule (with trigonometric functions))
## Institution(John Wiley & Sons)
## Level(2)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('9')
## Section1('2.6')
## Problem1('22')
## KEYWORDS('Derivative', 'Chain rule')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Numeric")->variables->add(u => 'Real');

$p   = random(2, 5);
$b   = random(2, 5);
$M   = $p * $b;
$pm1 = $p - 1;
$bm1 = $b - 1;
if ($pm1 == 1) { $pm1 = "" }

$f = Formula(" cos^$p(u)")->reduce;
$u = Formula(" cos(x/(x+$b))")->reduce;
$g = Formula(" x/(x+$b) ")->reduce;

$fdisp = $f->substitute(u => $g);
$Df    = $f->D('u');
$Df    = Formula(" $Df ")->reduce;
$Dg    = $g->D('x')->reduce;
$Dfg   = $Df->substitute(u => $g);
$Dfg   = Formula("$Dfg")->reduce;

$output = Formula(" $Dg*$Df ")->reduce;
$output = $output->substitute(u => $g);
$output = Compute(" $output ")->reduce;

BEGIN_PGML

Let [`` f(x) = [$fdisp] ``].  Find [`f'(x)`].

[`f'(x) =`] [_]{$output}

END_PGML

BEGIN_PGML_SOLUTION
Taking [` u(x) = [$u] `] in the generalized derivative formula for [`u^[$p]`] yields

 [``` 
 \begin{aligned}
  \frac{d \;[$fdisp]}{dx}  & = \frac{d \; [u^[$p]]}{dx} \qquad \text{with} \quad
  u=\frac{x}{x+[$b]}\\
  & = [$p] u^{[$pm1]} \frac{du}{dx} \\
  & =[$p] \cos^{[$pm1]}\left(\frac{x}{x+[$b]}\right)\frac{d}{dx}\left[\cos(\frac{x}{x+[$b]})\right]\\
  & =[$p] \cos^{[$pm1]}\left(\frac{x}{x+[$b]}\right)\cdot \left(-\sin\left(\frac{x}{x+[$b]}\right) \frac{d}{dx}\left[\frac{x}{x+[$b]}\right]\right) \\
  & = -\frac{[$M]}{(x+[$b])^2}\cos^{[$pm1]}\left(\frac{x}{x+[$b]}\right)
      \sin\left(\frac{x}{x+[$b]}\right)
 \end{aligned}
```]

END_PGML_SOLUTION

ENDDOCUMENT();
