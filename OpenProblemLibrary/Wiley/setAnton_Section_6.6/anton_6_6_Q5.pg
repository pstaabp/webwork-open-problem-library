## DBsubject(Calculus - single variable)
## DBchapter(Applications of integration)
## DBsection(Work)
## KEYWORDS('definite integral', 'work')
## Institution(John Wiley & Sons)
## Author(Brian Burns)
## Level(2)
## MO(1)
## TitleText1('Calculus')
## AuthorText1('Anton')
## EditionText1('9')
## Section1('6.6')
## Problem1('5')
DOCUMENT();
loadMacros(
    'PGstandard.pl',      'PGML.pl', 'plots.pl',
    'contextFraction.pl', 'PGcourse.pl'
);

Context("Numeric");

$a = random(2, 8, 2);
$b = random(3, 5, 2);
$B = $a * $b / 2;
$c = random(10, 50, 10);
$m = Compute("$a/$b");

$f = Formula("$m*x")->reduce;
($D, $N) = reduce($m, 2);
$H  = Formula("$c*x")->reduce;
$g1 = $f->string;
Context("Fraction");
$C2 = Compute("($B)*$c");
$md = Compute("$a/$b");

$plot = Plot(
    xmin            => -1,
    xmax            => $b + 1,
    xtick_delta     => 1,
    xminor          => 0,
    xlabel          => 'time (s)',
    ymin            => -1,
    ymax            => $f->eval(x => 4) + 1,
    ytick_delta     => 1,
    yminor          => 0,
    ylabel          => 'Velocity (ft/s)',
    show_grid       => 0,
    rounded_corners => 1
);
$plot->add_function($g1, 'x', 0, $b, color => 'blue');

BEGIN_PGML

A constant force of [$c] lb in the positive [`\small{x}`]-direction is applied to a particle whose velocity versus time curve is shown in the accompanying figure. Find the work done by the force on the particle from time [`t = 0`] to [`t = [$b]`]. 

>> [!A plot of a line from the origin to the point ([$b],[$b*$m]).!]{$plot}{300}<<

        Work Done [`=`] [_]{$C2} ft[`\cdot`]lb

END_PGML

BEGIN_PGML_SOLUTION
With [`F(x)=[$c],\; v(t)=\frac{dx}{dt}=[$md] t`]

[```
\begin{aligned}
\text{Work done} & =\int_{x=a}^{x=b} F(x) \;dx \\
& =[$c]\int_{x=a}^{x=b}dx \\
& =[$c]\int_{t=0}^{t=[$b]}  \left( \frac{dx}{dt}\right) \;dt\\
& =[$c]\int_{0}^{[$b]}  \left( [$md] t\right) \;dt =[$C2]
\end{aligned}
```]

The Work Done is [`[$C2]`] ft[`\cdot`]lb.

END_PGML_SOLUTION

ENDDOCUMENT();
