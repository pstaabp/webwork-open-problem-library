## DESCRIPTION
## Trigonometric functions

## DBsubject(Trigonometry)
## DBchapter(Triangle trigonometry)
## DBsection(Sine, cosine, and tangent of an angle in a right triangle)
## Date(01/01/10)
## Institution(Fort Lewis College)
## Author(Paul Pearson)
## Level(2)
## MO(1)
## TitleText1('Functions Modeling Change')
## TitleText2('Functions Modeling Change')
## AuthorText1('Connally')
## AuthorText2('Connally')
## EditionText1('3')
## EditionText2('5')
## Section1(6.Tools)
## Section2('7.4')
## Problem1(6)
## Problem2('6')
## KEYWORDS('trig')


DOCUMENT();  

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'plots.pl', 'PGcourse.pl');

Context("Fraction-NoDecimals");

do { 
    $x = random(3,9);    
    $y = random(3,9); } until $x != $y;

$sumofsquares = $x**2 + $y**2;

$anscos = Compute("$x / sqrt($sumofsquares)");
$anssin = Compute("$y / sqrt($sumofsquares)");
$anstan = Compute("$y / $x");



# Right Triangle Plot
$plot = Plot(
    xmin     => -1,
    xmax     =>  6,
    xvisible =>  0,
    ymin     => -1,
    ymax     =>  4.5,
    yvisible => 0, 
    aspect_ratio => 1,
    rounded_corners => 1
);
$plot->add_multipath(
    [
        [ '(2/3)*cos(t)', '(2/3)*sin(t)', '0', atan(4/5) ],
        [ 0, 0 ],
    ],
    't',
    color => 'green',
    fill  => 'self',
    cycle => 1
);
$plot->add_rectangle([4.5,0],[5,0.5], fill_color => 'green');
$plot->add_multipath(
    [
        [ '(2/3)*cos(t)+5', '(2/3)*sin(t)+4', 
          pi + atan(4/5), '3pi/2' ],
        [ 5,4 ],
    ],
    't',
    color => 'green',
    fill  => 'self',
    cycle => 1
);
$plot->add_dataset([ 0, 0 ], [ 5, 0 ], [ 5, 4 ], [ 0, 0 ]);
$plot->add_label([0.95,0.3,'\\(\\theta\\)', fontsize => 'Large'],
                [4.5,3,'\\(\\phi\\)', fontsize => 'Large'],
                [2.5,0,'\\(x\\)', fontsize => 'Large', v_align => 'top'],
                [5.2,2 ,'\\(y\\)', fontsize => 'Large', h_align => 'left'],
                [2.5,2.75,'\\(z\\)', fontsize => 'Large']);

$altText = "A right triangle with the hypotenuse labelled z, the two sides "
    . "labelled x and y. The angle opposite x is phi and the one "
    . "opposite y is theta.";


$questionTable = LayoutTable(
    [
        [ 'a.', "\(\cos(\theta)=\)", PGML('[_]{$anscos}') ],
        [ 'b.', "\(\sin(\theta)=\)", PGML('[_]{$anssin}') ],
        [ 'c.', "\(\tan(\theta)=\)", PGML('[_]{$anstan}') ],
    ],
    valign  => 'middle',
    align   => 'lrl',
    padding => [ 0.2, 0.1 ]
);

Context()->functions->disable("All");
Context()->functions->enable("sqrt");


BEGIN_PGML
Suppose [`x = [$x]`] and [`y = [$y],`] in the figure, which is not drawn to scale.  Find the following.  Enter exact answers as fractions, not decimal approximations.

[# [. [$questionTable]* .] [. [!$altText!]{$plot}{300} .] #]{padding => [0,0.5]}


END_PGML

ENDDOCUMENT();