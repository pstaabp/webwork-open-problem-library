## DESCRIPTION
## Trigonometric functions

## DBsubject(Trigonometry)
## DBchapter(Triangle trigonometry)
## DBsection(Applications of special triangles & right triangles)
## Date(01/01/10)
## Institution(Fort Lewis College)
## Author(Paul Pearson)
## Level(2)
## MO(1)
## TitleText1('Functions Modeling Change')
## TitleText2('Functions Modeling Change')
## TitleText3('Functions Modeling Change')
## AuthorText1('Connally')
## AuthorText2('Connally')
## AuthorText3('Connally')
## EditionText1('3')
## EditionText2('4')
## EditionText3('5')
## Section1(6.Tools)
## Section2(7.4)
## Section3('8.Review')
## Problem1(8b)
## Problem2(8b)
## Problem3('4b')
## KEYWORDS('trig')

DOCUMENT();

loadMacros(
    'PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'plots.pl',
    'PGcourse.pl'
);

$refreshCachedImages = 1;

Context("Fraction-NoDecimals");

$z = random(3, 19, 1);

$anscos = Compute("sqrt(3)/2");
$anssin = Compute("1/2");
$anstan = Compute("1/sqrt(3)");

# Right Triangle Plot
$plot = Plot(
    xmin            => -1,
    xmax            =>  6,
    xvisible        =>  0,
    ymin            => -1,
    ymax            => 4.5,
    yvisible        =>  0,
    aspect_ratio    =>  1,
    rounded_corners => 1
);
$plot->add_multipath(
    [ [ '(2/3)*cos(t)', '(2/3)*sin(t)', '0', atan(4 / 5) ], [ 0, 0 ], ],
    't',
    color => 'green',
    fill  => 'self',
    cycle => 1
);
$plot->add_rectangle([ 4.5, 0 ], [ 5, 0.5 ], fill_color => 'green');
$plot->add_multipath(
    [
        [ '(2/3)*cos(t)+5', '(2/3)*sin(t)+4', pi + atan(4 / 5), '3pi/2' ],
        [ 5, 4 ],
    ],
    't',
    color => 'green',
    fill  => 'self',
    cycle => 1
);
$plot->add_dataset([ 0, 0 ], [ 5, 0 ], [ 5, 4 ], [ 0, 0 ]);
$plot->add_label(
    [ 0.95, 0.3,  '\\(\\theta\\)', fontsize => 'Large' ],
    [ 4.5,  3,    '\\(\\phi\\)',   fontsize => 'Large' ],
    [ 2.5,  0,    '\\(x\\)', fontsize => 'Large', v_align => 'top' ],
    [ 5.2,  2,    '\\(y\\)', fontsize => 'Large', h_align => 'left' ],
    [ 2.5,  2.75, '\\(z\\)', fontsize => 'Large' ]
);

$altText =
    "A right triangle with the hypotenuse labelled z, the two sides "
    . "labelled x and y. The angle opposite x is phi and the one "
    . "opposite y is theta.";

$questionTable = LayoutTable(
    [
        [ 'a.', "\(\cos(\theta)=\)", PGML('[_]{$anscos}') ],
        [ 'b.', "\(\sin(\theta)=\)", PGML('[_]{$anssin}') ],
        [ 'c.', "\(\tan(\theta)=\)", PGML('[_]{$anstan}') ],
    ],
    valign  => 'middle',
    align   => 'lrl',
    padding => [ 0.2, 0.1 ]
);

Context()->functions->disable("All");
Context()->functions->enable("sqrt");

BEGIN_PGML
Suppose [`\phi = 2\theta`] in the figure, which is not drawn to scale.  Find the following.  Enter exact answers as fractions, not decimal approximations.

[# [. [$questionTable]* .] [. [!$altText!]{$plot}{300} .] #]{padding => [0,0.5]}


END_PGML

BEGIN_PGML_SOLUTION
Note that if [`\phi = 2\theta`], then [`\phi = 60^{\circ}`] and
[`\theta = 30^{\circ}`], so that the sum of the angles in the
triangle is [`180^{\circ}`].  Then we can think of this triangle
as half of an equilateral triangle formed by reflecting it across
the leg [`x`].  Thus [`y = \frac12\,z`], and by the Pythagorean
theorem
[``` x^2 + y^2 = x^2 + \frac14\,z^2 = z^2, ```]
so that [`x^2 = \frac34\, z^2`], and [`x = \frac{\sqrt3}2\,z`].  Then
[```\begin{aligned}
\cos\theta &= \frac{x}{z} = \frac{z\sqrt3}{2z} = \frac{\sqrt{3}}{2},\\
\sin\theta &= \frac{y}{z} = \frac{z}{2z} = \frac12,
\quad\mbox{and}\\
\tan\theta &= \frac{y}{x} = \frac{z/2}{z\sqrt3/2} = \frac{1}{\sqrt3}.
\end{aligned}
```]

END_PGML_SOLUTION

COMMENT('30-60-90 triangle, so the answers are not randomized');

ENDDOCUMENT();
