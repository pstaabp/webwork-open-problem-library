## DESCRIPTION
## Trigonometric functions

## DBsubject(Trigonometry)
## DBchapter(Triangle trigonometry)
## DBsection(Applications of special triangles & right triangles)
## Date(01/01/10)
## Institution(Fort Lewis College)
## Author(Paul Pearson)
## Level(2)
## MO(1)
## TitleText1('Functions Modeling Change')
## TitleText2('Functions Modeling Change')
## TitleText3('Functions Modeling Change')
## AuthorText1('Connally')
## AuthorText2('Connally')
## AuthorText3('Connally')
## EditionText1('3')
## EditionText2('4')
## EditionText3('5')
## Section1(6.Tools)
## Section2(7.4)
## Section3('8.Review')
## Problem1(8a)
## Problem2(8a)
## Problem3('4a')
## KEYWORDS('trig')

DOCUMENT();

loadMacros(
    'PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'plots.pl',
    'PGcourse.pl'
);

Context("Fraction-NoDecimals");

$anscos = Compute("sqrt(2)/2");
$anssin = Compute("sqrt(2)/2");
$anstan = Compute("1");

# Right Triangle Plot
$plot = Plot(
    xmin            => -1,
    xmax            =>  6,
    xvisible        =>  0,
    ymin            => -1,
    ymax            => 4.5,
    yvisible        =>  0,
    aspect_ratio    =>  1,
    rounded_corners => 1
);
$plot->add_multipath(
    [ [ '(2/3)*cos(t)', '(2/3)*sin(t)', '0', atan(4 / 5) ], [ 0, 0 ], ],
    't',
    color => 'green',
    fill  => 'self',
    cycle => 1
);
$plot->add_rectangle([ 4.5, 0 ], [ 5, 0.5 ], fill_color => 'green');
$plot->add_multipath(
    [
        [ '(2/3)*cos(t)+5', '(2/3)*sin(t)+4', pi + atan(4 / 5), '3pi/2' ],
        [ 5, 4 ],
    ],
    't',
    color => 'green',
    fill  => 'self',
    cycle => 1
);
$plot->add_dataset([ 0, 0 ], [ 5, 0 ], [ 5, 4 ], [ 0, 0 ]);
$plot->add_label(
    [ 0.95, 0.3,  '\\(\\theta\\)', fontsize => 'Large' ],
    [ 4.5,  3,    '\\(\\phi\\)',   fontsize => 'Large' ],
    [ 2.5,  0,    '\\(x\\)', fontsize => 'Large', v_align => 'top' ],
    [ 5.2,  2,    '\\(y\\)', fontsize => 'Large', h_align => 'left' ],
    [ 2.5,  2.75, '\\(z\\)', fontsize => 'Large' ]
);

$altText =
    "A right triangle with the hypotenuse labelled z, the two sides "
    . "labelled x and y. The angle opposite x is phi and the one "
    . "opposite y is theta.";

$questionTable = LayoutTable(
    [
        [ 'a.', "\(\cos(\theta)=\)", PGML('[_]{$anscos}') ],
        [ 'b.', "\(\sin(\theta)=\)", PGML('[_]{$anssin}') ],
        [ 'c.', "\(\tan(\theta)=\)", PGML('[_]{$anstan}') ],
    ],
    valign  => 'middle',
    align   => 'lrl',
    padding => [ 0.2, 0.1 ]
);

Context()->functions->disable("All");
Context()->functions->enable("sqrt");

BEGIN_PGML
Suppose [`\theta = \phi`] in the figure, which is not drawn to scale.  Find the following.  Enter exact answers as fractions, not decimal approximations.

[# [. [$questionTable]* .] [. [!$altText!]{$plot}{300} .] #]{padding => [0,0.5]}


END_PGML

BEGIN_PGML_SOLUTION
Because the two angles are the same, we know that the two legs
of the triangle must have equal length.  Therefore, in the figure,
[`x = y`] and by the Pythagorean theorem
[``` x^2 + y^2 = 2\,x^2 = z^2, ```]
so that [`x = y = z/\sqrt2`].  Then
[```\begin{aligned}
\cos\theta &= \frac{x}{z} = \frac{z}{z\sqrt{2}} = \frac1{\sqrt2},\\
\sin\theta &= \frac{y}{z} = \frac{z}{z\sqrt{2}} = \frac1{\sqrt2},
\quad\mbox{and}\\
\tan\theta &= \frac{y}{x} = 1.
\end{aligned}
```]

END_PGML_SOLUTION

COMMENT('45-45-90 triangle, so the answers are not randomized');

ENDDOCUMENT();
