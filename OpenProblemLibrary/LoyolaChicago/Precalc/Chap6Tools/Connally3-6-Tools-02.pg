## DESCRIPTION
## Trigonometric Functions
## ENDDESCRIPTION

## DBsubject(Trigonometry)
## DBchapter(Triangle trigonometry)
## DBsection(Sine, cosine, and tangent of an angle in a right triangle)
## Date(01/01/10)
## Institution(Fort Lewis College)
## Author(Paul Pearson)
## Level(2)
## MO(1)
## TitleText1('Functions Modeling Change')
## AuthorText1('Connally')
## EditionText1('3')
## Section1(6.Tools)
## Problem1(2)
## KEYWORDS('trig')

DOCUMENT();

loadMacros(
    'PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'plots.pl',
    'PGcourse.pl'
);

Context("Fraction-NoDecimals");

# Pythagorean triples
@xyz = (
    [ 3,  4,  5 ],
    [ 8,  6,  10 ],
    [ 5,  12, 13 ],
    [ 15, 8,  17 ],
    [ 12, 16, 20 ],
    [ 7,  24, 25 ],
    [ 24, 10, 26 ],
    [ 21, 20, 29 ],
    [ 16, 30, 34 ],
    [ 9,  40, 41 ]
);

$i = random(0, 9);

($x, $y, $z) = ($xyz[$i]->[0], $xyz[$i]->[1], $xyz[$i]->[2]);

$cost = Fraction("$x", "$z");
$sint = Fraction("$y", "$z");
$tant = Fraction("$y", "$x");
$cosp = Fraction("$y", "$z");
$sinp = Fraction("$x", "$z");
$tanp = Fraction("$x", "$y");

$plot = Plot(
    xmin            => -1,
    xmax            =>  6,
    xvisible        =>  0,
    ymin            => -1,
    ymax            => 4.5,
    yvisible        =>  0,
    aspect_ratio    =>  1,
    show_grid       =>  0,
    rounded_corners => 1
);
$plot->add_multipath(
    [ [ '(2/3)*cos(t)', '(2/3)*sin(t)', '0', atan(4 / 5) ], [ 0, 0 ], ],
    't',
    color => 'green',
    fill  => 'self',
    cycle => 1
);
$plot->add_rectangle([ 4.5, 0 ], [ 5, 0.5 ], fill_color => 'green');
$plot->add_multipath(
    [
        [ '(2/3)*cos(t)+5', '(2/3)*sin(t)+4', pi + atan(4 / 5), '3pi/2' ],
        [ 5, 4 ],
    ],
    't',
    color => 'green',
    fill  => 'self',
    cycle => 1
);
$plot->add_dataset([ 0, 0 ], [ 5, 0 ], [ 5, 4 ], [ 0, 0 ]);
$plot->add_label(
    [ 0.95, 0.3,  '\\(\\theta\\)', fontsize => 'Large' ],
    [ 4.5,  3,    '\\(\\phi\\)',   fontsize => 'Large' ],
    [ 2.5,  0,    '\\(x\\)', fontsize => 'Large', v_align => 'top' ],
    [ 5.2,  2,    '\\(y\\)', fontsize => 'Large', h_align => 'left' ],
    [ 2.5,  2.75, '\\(z\\)', fontsize => 'Large' ]
);

Context()->functions->disable("All");

$questionTable = LayoutTable(
    [
        [ 'a.', '&nbsp;', "\(\cos(\theta)=\)", PGML('[_]{$cost}') ],
        [ 'b.', '&nbsp;', "\(\sin(\theta)=\)", PGML('[_]{$sint}') ],
        [ 'c.', '&nbsp;', "\(\tan(\theta)=\)", PGML('[_]{$tant}') ],
        [ 'd.', '&nbsp;', "\(\cos(\phi)=\)",   PGML('[_]{$cosp}') ],
        [ 'e.', '&nbsp;', "\(\sin(\phi)=\)",   PGML('[_]{$sinp}') ],
        [ 'f.', '&nbsp;', "\(\tan(\phi)=\)",   PGML('[_]{$tanp}') ]
    ],
    valign  => 'middle',
    align   => 'lrl',
    padding => [ 0.2, 0.1 ]
);

$altText =
    "A right triangle with the hypotenuse labelled z, the two sides "
    . "labelled x and y. The angle opposite x is phi and the one "
    . "opposite y is theta.";

BEGIN_PGML
Suppose [`x = [$x], y = [$y],`] and [`z = [$z]`] in the figure, which is not drawn to scale.  Find the following.  Enter exact answers as fractions, not decimal approximations.

[# [. [$questionTable]* .] [. [!$altText!]{$plot}{300} .] #]{padding => [0,0.5]}


END_PGML
ENDDOCUMENT();
