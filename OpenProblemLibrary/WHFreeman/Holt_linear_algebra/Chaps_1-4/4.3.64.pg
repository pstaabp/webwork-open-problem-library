# updated on 2024.01.19 by Peter Staab (Fitchburg State University)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'MatrixReduce.pl', 'PGcourse.pl');

# For a given matrix $mat, return the submatrix with rows in
# arrayref $rows and cols in arrayref $cols.

sub subMatrix {
    my ($mat, $rows, $cols) = @_;
    my $sub_mat = [];
    for $r (@$rows) {
        my $row = [];
        push(@$row,     $mat->element($r, $_)) for (@$cols);
        push(@$sub_mat, $row);
    }
    return Matrix($sub_mat);
}

$num_rows = random(5, 7);
$num_cols = random(4, 5);

$rank = random(2, 4);

do {
    # Fill the first $rank rows with random numbers and the rest with 
    # rows of zeros.
    $arr =
        [ map { [ map { random(-4, 4) } (1 .. $num_cols) ] } (1 .. $rank) ];
    push(@$arr, [ map {0} (1 .. $num_cols) ]) for ($rank + 1 .. $num_rows);
    $A = Matrix($arr);

    # Test to ensure that the $rank rows are linearly independent
    # by adding the absolute values of the determinants.  If
    # that value is 0, then they are dependent.
    $abs_det = 0;
    for $i (1 .. 1 + $num_cols - $rank) {
        $S = subMatrix($A, [ 1 .. $rank ], [ $i .. $rank + $i - 1 ]);
        $abs_det += abs($S->det);
    }
} while $abs_det == 0;

# This fills the rest of the matrix with row combinations of
# the first $rank rows.
for ($k = $rank + 1; $k <= $num_rows; $k++) {
    for ($j = 1; $j <= $rank; $j++) {
        $A = row_add($A, $k, $j, non_zero_random(-3, 3));
    }
}

$nullity = Real($num_cols - $rank);

BEGIN_PGML
Determine the rank and nullity of the matrix.

[``` [$A] ```]

The rank of the matrix is [_]{Real($rank)}

The nullity of the matrix is [_]{$nullity}
END_PGML
Context('Fraction');
$rref = rref(apply_fraction_to_matrix_entries($A));

BEGIN_PGML_SOLUTION
If we put the matrix in row-echelon or reduced row-echelon form, we get
[``` [$rref] ```]

And notice that there are [$rank] non-zero rows, so the rank of the matrix is [$rank], and since rank(A) + nullity(A) = number of columns in A, the nullity must be [$nullity].

END_PGML_SOLUTION

ENDDOCUMENT();
