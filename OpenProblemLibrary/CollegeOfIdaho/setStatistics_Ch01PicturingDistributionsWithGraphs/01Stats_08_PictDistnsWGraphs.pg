## DESCRIPTION
## DBsubject(Statistics)
## DBchapter(Exploratory data analysis/descriptive statistics)
## DBsection(Graphical representations)
## Institution(The College of Idaho)
## Author(R Cruz, L Danielson, J Guild)
## Level(1)
## TitleText1('The Basic Practice of Statistics')
## AuthorText1('David Moore')
## EditionText1('5e')
## Section1('1')
## KEYWORDS('statistics', 'quantitative data', 'categorical data', 'histogram')

DOCUMENT();

loadMacros(
    'PGstandard.pl',         'PGML.pl',
    'StatisticalPlots.pl',   'parserPopUp.pl',
    'PGstatisticsmacros.pl', 'PGcourse.pl'
);

# generate some data is is skewed right

do {
    @rand_nums = urand(5, 20, 150, 1);
    push(@rand_nums, random(25, 99)) for (1 .. random(8, 15));
    @rand_nums = grep { $_ > 0 } @rand_nums;

    @h = ();
    for my $i (0 .. 9) {
        $h[$i] =
            scalar(grep { $_ >= 10 * $i && $_ < 10 * ($i + 1) } @rand_nums);
    }

} until $h[0] <= 30 && $h[1] <= 30;

$num_students = scalar(@rand_nums);

$stat_plot = StatPlot(
    xmin            => 0,
    xmax            => 100,
    xtick_delta     => 10,
    xminor          => 4,
    xmajor          => 0,
    xlabel          => 'amount of money (dollars)',
    xlocation       => 'bottom',
    ymin            => 0,
    ymax            => 35,
    ytick_delta     => 5,
    yminor          => 4,
    ylabel          => 'Number of Students',
    ylocation       => 'left',
    rounded_corners => 1,
    aspect_ratio    => 2
);

$stat_plot->add_histogram(
    [@rand_nums],
    min          => 0,
    max          => 100,
    bins         => 10,
    fill_color   => 'goldenrod',
    stroke_width => 1
);

$dol   = random(30, 60, 10);
$num_b = 0;
$num_b += $h[$_] for (0.1 * $dol .. 9);
$ans_b = Real(100 * $num_b / $num_students);

$dd = DropDown([ 'skewed left', 'skewed right', 'symmetric' ], 1);

BEGIN_PGML
In a statistics class with [$num_students] students, the professor records 
how much money each student has in their possession during the first class
of the semester. The histogram below is of the data collected.

>> [! alt text !]{$stat_plot}{400} <<

a) The number of students with less than ten dollars in their posession is
[_]{Real($h[0])}

b) The percentage of students with more than $[$dol] in their possession is
[_]{$ans_b}

c) The histogram is [_]{$dd}

END_PGML

BEGIN_PGML_SOLUTION
a) The number of students with less than ten dollars in their possession from the histogram is [$h[0]]. 

b) To determine the percentage of students with more than $[$dol] in their possession,
first use the histogram to count the number of students.  This is 
[```[@ join('+', @h[0.1*$dol..9]) @] = [$num_b] ```]
Then find the percentage using
[``` 100 \frac{[$num_b]}{[$num_students]} = [$ans_b] ```]

c) The peak to the left and a long tail to the right, so this is skewed right.
END_PGML_SOLUTION

ENDDOCUMENT();    # This should be the last executable line in the problem.
