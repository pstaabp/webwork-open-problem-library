## DESCRIPTION
## DBsubject(Statistics)
## DBchapter(Exploratory data analysis/descriptive statistics)
## DBsection(Graphical representations)
## Institution(The College of Idaho)
## Author(R Cruz, L Danielson, J Guild)
## Level(1)
## TitleText1('The Basic Practice of Statistics')
## AuthorText1('David Moore')
## EditionText1('5e')
## Section1('1')
## KEYWORDS('statistics', 'time plot')

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros(
    'PGstandard.pl',         'PGML.pl',
    'parserRadioButtons.pl', 'PGchoicemacros.pl',
    'PGcourse.pl'
);

Context('Numeric');

@questions = (
    'The maximum price per share for this time period was about',
    'Which of the following is a true statement?',
    'If you bought a single share of stock at the maximum price and sold it at the '
        . 'minimum price during this one-year period, you would have lost about'
);

@options = (
    [ [ '$41', '$45', '$25', '$20' ], 'None of the above.' ],
    [
        [
            "There has been a general downward trend in the stock price over this time period.",
            "The price of General Electric stock has been stable for this year. ",
            "The price should return to 40 dollars within six months because of the cycle. ",
            "There has been a general upward trend in the stock price over this time period. "
        ],
        'None of the above.'
    ],
    [ [ '$15', '$25', '$35', '$45' ], 'None of the above.' ]
);

@order = random_subset(3, 0 .. 2);

@rb = map { RadioButtons($options[$_], 0, labels => 'ABC') } @order;

$showPartialCorrectAnswers = 0;

BEGIN_PGML
The timeplot below gives the share price in dollars of General Electric stock, 
with the bar chart giving the volume in millions of shares.  The plots are 
for the one-year period September 2001-September 2002.
(*Click on the image for a larger view.*)

>>[!!]{'Ref_1_1.gif'}{400}<<

a) [$questions[$order[0]]]

    [_]{$rb[0]}

b) [$questions[$order[1]]]

    [_]{$rb[1]}

c) [$questions[$order[2]]]

    [_]{$rb[2]}


END_PGML

@explanations = (
    'The largest value is about $41',
    'From the graph the curve is generally trending down left to right.',
    'The lowest value during the year was about $25, so the difference is $15.'
);

BEGIN_PGML_SOLUTION

a) [$explanations[$order[0]]]  Answer [$rb[0]]

b) [$explanations[$order[1]]]  Answer [$rb[1]]

c) [$explanations[$order[2]]]  Answer [$rb[2]]

END_PGML_SOLUTION

ENDDOCUMENT();        # This should be the last executable line in the problem.