## DESCRIPTION
## DBsubject(Statistics)
## DBchapter(Exploratory data analysis/descriptive statistics)
## DBsection(Graphical representations)
## Institution(The College of Idaho)
## Author(R Cruz, L Danielson, J Guild)
## Level(1)
## MO(1)
## TitleText1('The Basic Practice of Statistics')
## AuthorText1('David Moore')
## EditionText1('5e')
## Section1('1')
## KEYWORDS('statistics', 'quantitative data', 'categorical data', 'histogram')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'parserRadioButtons.pl', 'PGcourse.pl');

## @data = (116, 118, 121, 124, 128, 133, 137, 142, 146, 179);
@data = num_sort(map { random(100, 200) } (1 .. random(10, 15)));

@stems = ();
($min, $max) = (min(@data), max(@data));
for my $i (0 .. 9) {
    $stems[$i] = [
        map  { $_ % 10 }
        grep { 100 + 10 * $i <= $_ && $_ < 100 + 10 * ($i + 1) } @data
    ];
}

@stem_rows = map { [ "1$_", join(', ', @{ $stems[$_] }) ] } (0 .. 9);
$tab       = DataTable([@stem_rows], align => 'r|l');

$rb1 = RadioButtons(
    [
        [
            'a histogram with class intervals between 110 and 120, between 120 and 130, etc. ',
            'a time plot of the data with the observations taken in increasing order.',
            'a boxplot of the data.',
            'reporting the 5-point summary for the data, with the mean.'
        ],
        'None of the Above'
    ],
    0,
    labels => 'ABC'
);

$rb2 = RadioButtons(
    [ [
        join(', ', @data),
        join(', ', map { $_ % 100 } @data),
        join(', ', map { $_ % 10 } @data),
        "All integers between $min and $max"
    ] ],
    0,
    labels => 'ABC'
);

$showPartialCorrectAnswers = 0;

BEGIN_PGML
For a Physics course containing [@ scalar(@data) @] students,
the maximum point total for the quarter was 200.
The point totals for the [@ scalar(@data) @] students are given in the stemplot below.

[$tab]*

a) This stemplot is most similar to

    [_]{$rb1}

b) To which of the following data sets does this stemplot correspond?

    [_]{$rb2}

c)  The lowest score in the class as a percentage of the total 
    possible points is  [_]{Real($data[0]/2)}%
END_PGML

BEGIN_PGML_SOLUTION
a) a stemplot is similar to a histogram with the data shown itself.  The correct answer is *[$rb1]****

b) To determine the actual data, we add the digits in the leaves to each of the stems.  The result for this problem is 
[``` [@ join(', ', @data) @] ```]
so the correct answer is *[$rb2]****

c) The smallest value in the dataset is [$data[0]] and since there are 200 points available in the class, the percentage is [$data[0]/2]%.
END_PGML_SOLUTION

ENDDOCUMENT();       # This should be the last executable line in the problem.