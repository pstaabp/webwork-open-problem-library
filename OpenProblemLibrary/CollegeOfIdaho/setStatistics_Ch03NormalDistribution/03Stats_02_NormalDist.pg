## DESCRIPTION
## DBsubject(Probability)
## DBchapter(Continuous distributions)
## DBsection(Application of a normal distribution)
## Institution(The College of Idaho)
## Author(R Cruz, L Danielson, J Guild)
## Level(3)
## TitleText1('The Basic Practice of Statistics')
## AuthorText1('David Moore')
## EditionText1('5e')
## Section1('3')
## Problem1('')
## KEYWORDS('statistic', 'normal distribution', 'z score')

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros('PGstandard.pl', 'PGML.pl', 'PGchoicemacros.pl', 'parserRadioButtons.pl', 'PGcourse.pl');

#  Set-up

@ThreeProblems = (0, 1, 2, 3);                #Order the problems
@scramble      = NchooseK(4, 3);
@order         = @ThreeProblems[@scramble];

# --- Questions Array ---
@questions = (
    'Which of these variables is least likely to have a Normal distribution? ',
    'To completely specify the shape of a Normal distribution, you must give ',
    'The length of human pregnancies from conception to birth varies according to a distribution that is approximately Normal with mean 266 days and standard deviation 16 days. About 95% of all pregnancies last between ',
    'The scores of adults on an IQ test is approximately Normal with mean 100 and standard deviation 15. Corinne scores 118 on such test. Her z-score is about '
);

# --- RadioButtons Array ---
@rb = (
    RadioButtons(
        [
            [
                "Income per person for 150 different countries. ",
                "Lengths of 50 newly hatched pythons. ",
                "Heights of 100 white pine trees in a forest.  "
            ],
            'None of the above. '
        ],
        0,
        labels => 'ABC'
    ),

    RadioButtons(
        [
            [
                "the mean and the standard deviation. ",
                "the five-number summary. ",
                "the mean and the median. ",
                "the median and the standard deviation. "
            ],
            'All of the above. '
        ],
        0,
        labels => 'ABC'
    ),

    RadioButtons(
        [
            [
                "234 and 298 days. ",
                "250 and 282 days. ",
                "218 and 314 days. ",
                "260 and 320 days. "
            ],
            'None of the above. '
        ],
        0,
        labels => 'ABC'
    ),

    RadioButtons(
        [ [ "1.2 ", "7.87 ", "18 ", "0.67 " ], 'None of the above. ' ],
        0, labels => 'ABC'
    )
);

BEGIN_PGML
For each problem, select the best response.

a) [$questions[$order[0]]]

    [_]{$rb[$order[0]]}

b) [$questions[$order[1]]]

    [_]{$rb[$order[1]]}

c) [$questions[$order[2]]]

    [_]{$rb[$order[2]]}

END_PGML

BEGIN_PGML_SOLUTION

a) *[$rb[$order[0]]]****

b) *[$rb[$order[1]]]****

c) *[$rb[$order[2]]]****
END_PGML_SOLUTION

ENDDOCUMENT();       # This should be the last executable line in the problem.