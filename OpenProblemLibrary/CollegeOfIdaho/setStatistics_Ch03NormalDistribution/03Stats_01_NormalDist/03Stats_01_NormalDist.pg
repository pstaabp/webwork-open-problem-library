## DESCRIPTION
## DBsubject(Statistics)
## DBchapter(Exploratory data analysis/descriptive statistics)
## DBsection(Description of distributions)
## Institution(The College of Idaho)
## Author(R Cruz, L Danielson, J Guild)
## Level(1)
## MO(1)
## TitleText1('The Basic Practice of Statistics')
## AuthorText1('David Moore')
## EditionText1('5e')
## Section1('3')
## KEYWORDS('statistic', 'normal distribution', 'z score')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'parserPopUp.pl', 'PGcourse.pl');

Context('Numeric');

@pic     = ('1-815316.gif', '1-318321.gif', '1-712333.gif');
@shape   = ('skewed right', 'skewed left',  'symmetric');
@mean    = ('C',            'A',            'B');
@median  = ('B',            'B',            'B');
@options = random_subset(2, 0 .. 2);

$dd1a = DropDown([ 'A', 'B', 'C' ], $mean[ $options[0] ]);
$dd1b = DropDown([ 'A', 'B', 'C' ], $median[ $options[0] ]);
$dd1c = DropDown([ 'skewed right', 'symmetric', 'skewed left' ],
    $shape[ $options[0] ]);
$dd2a = DropDown([ 'A', 'B', 'C' ], $mean[ $options[1] ]);
$dd2b = DropDown([ 'A', 'B', 'C' ], $median[ $options[1] ]);
$dd2c = DropDown([ 'skewed right', 'symmetric', 'skewed left' ],
    $shape[ $options[1] ]);

BEGIN_PGML
For the density curves shown below, indicate which value is closest to the mean and
which value is closest to the median.  State whether the distribution is skewed left, skewed right or symmetric.

1)

    >>[!!]{$pic[$options[0]]}{250}<<

    a) The mean is closest to: [_]{$dd1a}
    b) The median is closest to: [_]{$dd1b}
    c)  Is this data skewed to the right, symmetric, or skewed to the left? [_]{$dd1c}

2)

    >>[!!]{$pic[$options[1]]}{250}<<

    a) The mean is closest to: [_]{$dd2a}
    b) The median is closest to: [_]{$dd2b}
    c)  Is this data skewed to the right, symmetric, or skewed to the left? [_]{$dd2c}

END_PGML

ENDDOCUMENT();        # This should be the last executable line in the problem.