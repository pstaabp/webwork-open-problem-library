## DESCRIPTION
## DBsubject(Probability)
## DBchapter(Continuous distributions)
## DBsection(Gaussian normal)
## Institution(The College of Idaho)
## Author(R Cruz, L Danielson, J Guild)
## MLT(Zinv-cdf)
## Level(2)
## MO(1)
## TitleText1('The Basic Practice of Statistics')
## AuthorText1('David Moore')
## EditionText1('5e')
## Section1('3')
## Problem1('')
## KEYWORDS('statistic', 'normal distribution', 'z score')

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros(
    'PGstandard.pl',  'PGML.pl',
    'answerHints.pl', 'PGstatisticsmacros.pl',
    'PGcourse.pl'
);

Context('Numeric')->flags->set(tolerance => 0.007, tolType => 'absolute');

$pval1 = random(0.01, 0.48, 0.0001);
$pval2 = random(0.01, 0.48, 0.0001);

$ans_a = Compute(-1 * normal_distr(.5 - $pval1));
$cmp_a = $ans_a->cmp->withPostFilter(AnswerHints(
    sub {
        my ($correct, $student, $anshash) = @_;
        return abs($student - $correct) < .007;
    } => ["Close!"],
    -1 * $ans_a => [
        "It might help to sketch the Normal curve and mark the area representing the proportion less than the z score."
    ]
));

$ans_b = Compute(normal_distr(.5 - $pval2));
$cmp_b = $ans_b->cmp->withPostFilter(AnswerHints(
    sub {
        my ($correct, $student, $anshash) = @_;
        return abs($student - $correct) < .007;
    } => ["You are close."],
    -1 * $ans_b => [
        "It might help to sketch the Normal curve and mark the area representing the proportion greater than the z score."
    ]
));

BEGIN_PGML
Find the z-score from a standard normal distribution that
satisfies each of the following statements.

a)  The point _z_ with [$pval1*100] percent of the observations falling below it.

    [`z=`] [_]{$cmp_a}

b)  The closest point _z_ with [$pval2*100] percent of the observations falling above it.
  
    [`z=`] [_]{$cmp_b}
END_PGML

BEGIN_PGML_SOLUTION
For this, we look up the values on a standard normal table or use software:

a) [`` P(Z < z_0) = [$pval1] ``] results in [` z_0 = [$ans_a] `].

a) [`` P(Z > z_0) = [$pval2] ``] results in [` z_0 = [$ans_b] `].
END_PGML_SOLUTION

ENDDOCUMENT();
