## DESCRIPTION
## DBsubject(Probability)
## DBchapter(Continuous distributions)
## DBsection(Application of a normal distribution)
## Institution(The College of Idaho)
## Author(R Cruz, L Danielson, J Guild)
## MLT(IQ)
## Level(1)
## MO(1)
## TitleText1('The Basic Practice of Statistics')
## AuthorText1('David Moore')
## EditionText1('5e')
## Section1('3')
## KEYWORDS('statistic', 'normal distribution', 'z score')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'randomPerson.pl', 'PGcourse.pl');

$score = 100 + 3 * (random(0, 9) + 1);

$diff   = Compute($score - 100);
$zscore = Compute($diff / 15);

$p = randomPerson();

#  Main

BEGIN_PGML
IQ scores have a mean of 100 and a standard deviation of 15. [$p] has an IQ of [$score]. 

a) What is the difference between [$p]'s IQ and the mean?

    Answer: [_]{$diff}

b) Convert [$p]'s IQ score to a z-score. 

    Answer: [_]{$zscore}
END_PGML

BEGIN_PGML_SOLUTION

a) The difference is just [`[$score]-100 = [$diff]`].

b) The [`z`]-score is 

[```z = \frac{[$score]-100}{15} = [$zscore]```]
END_PGML_SOLUTION

ENDDOCUMENT();       # This should be the last executable line in the problem.