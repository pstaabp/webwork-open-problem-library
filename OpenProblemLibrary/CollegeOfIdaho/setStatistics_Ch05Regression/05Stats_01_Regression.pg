## DESCRIPTION
## DBsubject(Statistics)
## DBchapter(Simple linear regression)
## DBsection(Regression)
## Institution(The College of Idaho)
## Author(R Cruz, L Danielson, J Guild)
## MLT(InterpretLine)
## Level(2)
## TitleText1('The Basic Practice of Statistics')
## AuthorText1('David Moore')
## EditionText1('5e')
## Section1('5')
## Problem1('')
## KEYWORDS('statistic', 'regression')

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros('PGstandard.pl', 'PGML.pl', 'parserRadioButtons.pl', 'randomPerson.pl', 'PGcourse.pl');

@order         = random_subset(3,0..2);

$m1 = random(1,   9,   1);
$b1 = random(1,   9,   1);
$r1 = random(400, 700, 50);
$r2 = random(50,  200, 25);

$p = randomPerson();

@questions = (
    "Smokers don't live as long (on the average) as nonsmokers, and heavy smokers don't live as long as light smokers. You regress the age at death of a group of male smokers on the number of packs per day they smoked. The slope of your regression line ",
    PGML(
        '[$p] keeps [$p->their] savings in [$p->their] mattress. [$p->They] began with $[$r1] from [$p->their] mother and adds $[$r2] each year. [$p->Their] total savings [`y`] after [`x`] years are given by the equation '
    ),
    PGML(
        qq/Measurements on young children in Mumbai, India, found this least-squares line for predicting height [`y`] from armspan [`x`]:
    [```\hat{y} = 6.4 + 0.93 x```]
All measurements are in centimeters (cm). How much on the average does height increase for each additional centimeter of armspan?/
    )
);

@opts = (
    [
        [
            "will be less than zero.",
            "will be greater than zero.",
            "must be between -1 and 1."
        ],
        "can't tell without seeing the data."
    ],

    [
        [
            " \( y = $r1 + $r2 x  \)",
            "\( y = $r2 + $r1 x  \)",
            "\( y = $r2 + x  \) ",
            "\( y = $r1 - $r2 x  \) "
        ],
        'None of the above. '
    ],

    [
        [ "0.93 cm ", "6.4 cm ", "7.33 cm ", "0.64 cm " ],
        'None of the above. '
    ]
);

@rb = map { RadioButtons($opts[$_], 0, labels => 'ABC' )} @order;

$showPartialCorrectAnswers = 0;

BEGIN_PGML
For each problem, select the best response.

a) [$questions[$order[0]]]*

    [_]{$rb[0]}

b) [$questions[$order[1]]]*

    [_]{$rb[1]}

c) [$questions[$order[2]]]*

    [_]{$rb[2]}
END_PGML

BEGIN_PGML_SOLUTION
a) [$rb[0]]

b) [$rb[1]]

c) [$rb[2]]
END_PGML_SOLUTION

ENDDOCUMENT();       # This should be the last executable line in the problem.