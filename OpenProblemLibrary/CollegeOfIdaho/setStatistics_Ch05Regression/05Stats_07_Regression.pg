## DESCRIPTION
## DBsubject(Statistics)
## DBchapter(Simple linear regression)
## DBsection(Prediction)
## Institution(The College of Idaho)
## Author(R Cruz, L Danielson, J Guild)
## MLT(FindLineAndPredict)
## Level(2)
## MO(1)
## TitleText1('The Basic Practice of Statistics')
## AuthorText1('David Moore')
## EditionText1('5e')
## Section1('5')
## KEYWORDS('statistic', 'regression','correlation')

DOCUMENT();

loadMacros(
    'PGstandard.pl',         'PGML.pl',
    'answerHints.pl',        'contextCurrency.pl',
    'PGstatisticsmacros.pl', 'parserPopUp.pl',
    'PGcourse.pl'
);

do {
    @bill        = map { random(50, 120, 0.01) } (1 .. 6);
    $avg_tip_pct = random(0.15, 0.20, 0.1);
    @tip         = map { random(-3, 15, 0.01) + $avg_tip_pct * $_ } @bill;
    # round some of the tips to the nearest dollar
    @tip = map { random(1, 4) < 4 ? Round($_, 0) : Round($_, 2) } @tip;

    $r = sample_correlation(~~@bill, ~~@tip);
    ($b1, $b0) = linear_regression(~~@bill, ~~@tip);
} until $r > 0.85 && $b0 > -3;

Context('Currency');
@bill_c = map { Currency($_) } @bill;
@tip_c  = map { Currency($_) } @tip;

$bill = random(40, 100, 5);
$tip  = $b0 + $b1 * $bill;

$increase  = random(5, 10, 5);
$changetip = $increase * $b1;

Context('Numeric');

$ans_a = Compute($r)->with(tolType => 'absolute', tolerance => '0.005');
$cmp_a = $ans_a->cmp->withPostFilter(AnswerHints(
    sub {
        my ($correct, $student, $anshash) = @_;
        return abs($student - $correct) < .02;
    } => ["Your answer is close.  Try the calculation using more accuracy."]
));

$dd_b = DropDown([ 'yes', 'no' ], 0);

$ans_c = Formula("$b0 + $b1 x");

Context("Currency");
$ans_d = Currency($tip);

$dd_e = DropDown([ 'increase', 'decrease' ], 0);

$tab = DataTable([ [ 'Bill', @bill_c ], [ 'Tip', @tip_c ] ]);

$ans_e = Currency($changetip);

BEGIN_PGML
The amounts of 6 restaurant bills and the corresponding amounts of the tips are given in the below. Assume that bill amount is the explanatory variable and tip amount the response variable.

[$tab]*

a)  Find the correlation: [` r =`] [_]{$cmp_a}

b)  Does there appear to be a significant correlation? [_]{$dd_b}

c)  The regression equation is [`\hat{y}=`] [_]{$ans_c->with(tolType=>'absolute', tolerance=>'0.0005')}

d)  If the amount of the bill is $[`[$bill],`] the best prediction for the amount of the tip is 

    [_]{$ans_d->with(tolType=>'absolute', tolerance=>'0.04');}

e)  According to the regression equation, for every $[` [$increase] `] increase in the bill, the
tip should [_]{$dd_e} by [_]{$ans_e}

*Note: for d) and e), the answers should be in dollars in the form $xx.xx*
END_PGML

BEGIN_PGML_SOLUTION
a) using software, the correlation coefficient is [$r].

b) Since this is close to 1, this is a significant correlation.

c) using software, the slope is [@Round($b1,5)@] and the intercept is  [@ Round($b0,5) @]. Therefore the regression line is 
    [``` \hat{y} = [$ans_c]```]

d) Use the line in part c) to find 
    [``` [$bill]([@Round($b1,4)@]) + [@ Round($b0,3) @] = [$ans_d]```]

e) The answer to this is an interpretation of the regression line.  Since the slope of the regression line is positive, the tip should increase and increase by [`[$increase]\cdot [@ Round($b1,4)@] = [$ans_e]`]

END_PGML_SOLUTION

ENDDOCUMENT();