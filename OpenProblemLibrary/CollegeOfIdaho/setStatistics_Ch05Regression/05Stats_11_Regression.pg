## DESCRIPTION
## DBsubject(Statistics)
## DBchapter(Simple linear regression)
## DBsection(Diagnostics)
## Institution(The College of Idaho)
## Author(R Cruz, L Danielson, J Guild)
## Level(1)
## TitleText1('The Basic Practice of Statistics')
## AuthorText1('David Moore')
## EditionText1('5e')
## Section1('5')
## KEYWORDS('statistic', 'regression','correlation')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'parserRadioButtons.pl', 'PGcourse.pl');

Context('Numeric');

@order = random_subset(3, 0 .. 2);

@questions = (
    'Suppose a straight line is fit to data having response variable \( y \) and
	explanatory variable \( x \).  Predicting  values of \( y \) for values of \( x \)
     	outside the range of the observed data is called',
    'A plot of the residuals will indicate if a line is a good fit to the data if the plot ',
    'A lurking variable is',
);

# --- RadioButtons Array ---
@opts = (
    [
        [ "extrapolation.", "contingency.", "causation.", "correlation." ],
        'None of the above. '
    ],

    [
        [
            "has no
	systematic pattern.",
            "shows a curved pattern.",
            "shows increasing or decreasing spread about a line.",
            "shows large residuals in a symmetric pattern."
        ],
        'None of the above.'
    ],

    [
        [
            "a variable that is not among the variables studied but that affects the response variable.",
            "the true cause of a response.",
            "and variable that produces a large residual.",
            "the true variable that is explained by the explanatory variable."
        ],
        'None of the above.'
    ]
);

@rb = map { RadioButtons($opts[$_], 0, labels => 'ABC') } @order;

#  Main

BEGIN_PGML
For each problem, select the best response.

a) [$questions[$order[0]]]*

    [_]{$rb[0]}

b) [$questions[$order[1]]]*

    [_]{$rb[1]}

c) [$questions[$order[2]]]*

    [_]{$rb[2]}

END_PGML

BEGIN_PGML_SOLUTION

a) [$rb[0]]

b) [$rb[1]]

c) [$rb[2]]
END_PGML_SOLUTION

ENDDOCUMENT(); 