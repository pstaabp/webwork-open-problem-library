## DBsubject(Statistics)
## DBchapter(Simple linear regression)
## DBsection(Correlation)
## Institution(The College of Idaho)
## Author(R Cruz, L Danielson, J Guild)
## Level(1)
## TitleText1('The Basic Practice of Statistics')
## AuthorText1('David Moore')
## EditionText1('5e')
## Section1('4')
## KEYWORDS('statistic', 'correlation')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'parserRadioButtons.pl', 'PGcourse.pl');

@questions = (
    "The Columbus Zoo conducts a study to determine whether a household's income can be 
	used to predict the amount of money the household will give to the zoo's annual fund drive. 
	The response variable in this study is ",
    'A researcher wishes to determine whether the rate of water flow (in liters
	per second) over an experimental soil bed can be used to predict the amount of soil 
	washed away (in kilograms). In this study, the explanatory variable is the',
    'A researcher measures the correlation between two variables.  This correlation tells us',
);

@opts = (
    [
        [
            "the amount of money a household gives to the zoo's annual fund drive. ",
            "the Columbus Zoo. ",
            "a household's income. ",
            "all households in Columbus. "
        ],
        'None of the above. '
    ],

    [
        [
            "rate of water flow.",
            "amount of eroded soil. ",
            "size of the soil bed. ",
            "depth of the soil bed. "
        ],
        'None of the above. '
    ],

    [
        [
            "the strength of a straight line relation between two variables.",
            "whether there is a relation between two variables.",
            "whether or not a scatterplot shows an interesting pattern. ",
            "whether a cause-and-effect relation exists between two variables."
        ],
        'None of the above. '
    ]
);

@order = random_subset(3, 0 .. 2);
@rb    = map { RadioButtons($opts[$_], 0, labels => 'ABC') } @order;

BEGIN_PGML
For each problem, select the best response.

a) [$questions[$order[0]]]

    [_]{$rb[0]}

b) [$questions[$order[1]]]

    [_]{$rb[1]}

c) [$questions[$order[2]]]

    [_]{$rb[2]}
END_PGML

BEGIN_PGML_SOLUTION
a) [$rb[0]]

b) [$rb[1]]

c) [$rb[2]]
END_PGML_SOLUTION

ENDDOCUMENT();       # This should be the last executable line in the problem.