## DBsubject(Statistics)
## DBchapter(Simple linear regression)
## DBsection(Correlation)
## Institution(The College of Idaho)
## Author(R Cruz, L Danielson, J Guild)
## Level(1)
## TitleText1('The Basic Practice of Statistics')
## AuthorText1('David Moore')
## EditionText1('5e')
## Section1('4')
## Problem1('')
## KEYWORDS('statistic', 'correlation')

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros('PGstandard.pl', 'PGML.pl', 'parserRadioButtons.pl', 'PGcourse.pl');

$r  = random(0.1, 0.9, 0.1);
$r1 = $r / 10;
$r2 = $r * 10;

@questions = (
    PGML(
        "For a biology project, you measure the weight in grams and the tail length in millimeters of a group of mice. The correlation is [`r = $r`]. If you had measured tail length in centimeters instead of millimeters, what would be the correlation? (There are 10 millimeters in a centimeter.) "
    ),
    PGML(
        'A study found a correlation of [` r = -0.61`] between the gender of a worker and his or her income.  You may correctly conclude '
    )
);

# --- RadioButtons Array ---
@opts = (
    [ [ "$r ", "$r/10 = $r1", "($r)(10) = $r2 " ], 'None of the above. ' ],

    [
        [
            'this is incorrect because \(r\) makes no sense here.',
            "women earn more than men on average.",
            "an arithmetic mistake was made.  Correlation must be positive.",
            "women earn less than men on average."
        ],
        'None of the above.'
    ]
);
@order = random_subset(2, 0 .. 1);
@rb    = map { RadioButtons($opts[$_], 0, labels => 'ABC') } @order;

$showPartialCorrectAnswers = 0;

BEGIN_PGML
For each problem, select the best response.

a) [$questions[$order[0]]]*

    [_]{$rb[0]}

b) [$questions[$order[1]]]*

    [_]{$rb[1]}

END_PGML

BEGIN_PGML_SOLUTION
a) *[$rb[0]]****

b) *[$rb[1]]****
END_PGML_SOLUTION

ENDDOCUMENT(); # This should be the last executable line in the problem.