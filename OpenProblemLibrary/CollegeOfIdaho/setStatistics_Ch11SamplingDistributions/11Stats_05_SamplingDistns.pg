## DESCRIPTION
## A problem that explores bias and variation in sampling
## ENDDESCRIPTION
## DBsubject(Statistics)
## DBchapter(Sampling distributions)
## DBsection(General)
## Institution(The College of Idaho)
## Author(R Cruz, L Danielson, J Guild)
## Level(1)
## TitleText1('The Basic Practice of Statistics')
## AuthorText1('David Moore')
## EditionText1('5e')
## Section1('11')
## Problem1('')
## KEYWORDS('statistic', 'parameter', 'sampling distribution', 'sample')

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros(
    'PGstandard.pl',     'PGML.pl',
    'PGchoicemacros.pl', 'parserRadioButtons.pl',
    'PGcourse.pl'
);

#  Setup

@ThreeProblems = (0, 1, 2);                   #Order the problems
@scramble      = NchooseK(3, 3);
@order         = @ThreeProblems[@scramble];

@questions = (
    'The sampling distribution of a statistic is ',
    'Sampling variation is caused by ',
    "A statistic is said to be unbiased if "
);

$rb[0] = RadioButtons(
    [ [
        'the distribution of values taken by a statistic in all possible '
            . 'samples of the same size from the same population. ',
        'the probability that we obtain the  statistic in repeated random samples. ',
        'the mechanism that determines whether or not randomization was effective. ',
        'the extent to which the sample results differ systematically from the truth. '
    ] ],
    0,
    labels => 'ABC'
);

$rb[1] = RadioButtons(
    [ [
        'the mean of its sampling distribution is equal to the true '
            . 'value of the parameter being estimated.',
        'the survey used to obtain the statistic was designed so as to '
            . 'avoid even the hint of racial or sexual prejudice. ',
        'both the person who calculated the statistic and the subjects '
            . 'whose responses make up the statistic were truthful. ',
        'it is used for only honest purposes. '
    ] ],
    0,
    labels => 'ABC'
);

$rb[2] = RadioButtons(
    [ [
        'random selection of a sample.',
        'changes in a population parameter from sample to sample.',
        'systematic errors in our procedure.',
        'changes in a population parameter that cannot be predicted.'
    ] ],
    0,
    labels => 'ABC'
);

@slice = random_subset(3, 0 .. 2);
$showPartialCorrectAnswers = 0;

BEGIN_PGML
For the following problems, select the best response:

1. [$questions[$slice[0]]] [_]{$rb[$slice[0]]}

2. [$questions[$slice[1]]] [_]{$rb[$slice[1]]}

3. [$questions[$slice[2]]] [_]{$rb[$slice[2]]}
END_PGML

BEGIN_PGML_SOLUTION

1. [$questions[$slice[0]]]:  *[$rb[$slice[0]]]****

2. [$questions[$slice[1]]]: *[$rb[$slice[1]]]****

3. [$questions[$slice[2]]]: *[$rb[$slice[2]]]****


END_PGML_SOLUTION


ENDDOCUMENT();       # This should be the last executable line in the problem.