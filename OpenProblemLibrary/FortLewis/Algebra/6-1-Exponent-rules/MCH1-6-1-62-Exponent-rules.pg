## DESCRIPTION
## exponents
## ENDDESCRIPTION

## BookTitle('Algebra: Form and Function')
## BookChapter('Rules for Exponents and the Reasons for Them')
## DBsubject(Algebra)
## DBchapter(Properties of exponents, rational exponents and radicals)
## DBsection(Properties of exponents)
## Date(01/01/10)
## Institution(Fort Lewis College)
## Author(Paul Pearson)
## MLT(Quotient_in_power)
## Level(2)
## MO(1)
## TitleText1('Algebra: Form and Function')
## AuthorText1('McCallum, Connally, and Hughes-Hallett')
## EditionText1('1')
## Section1('6.1')
## Problem1('62')
## KEYWORDS('exponents')

DOCUMENT();

loadMacros(
    'PGstandard.pl',  'PGML.pl','contextLimitedPolynomial.pl',
    'PGcourse.pl'
);

Context("LimitedPolynomial-Strict")->variables->are(p => "Real", q => "Real");

$a = random(2, 3);
$b = random(3, 4);
$c = random(5, 9);

$atob = $a**$b;
$bc   = $b * $c;

$fraction = "\left( \frac{$a p}{ q^{$c} } \right)^{$b}";

$num = Formula("$atob * p^$b")->reduce;
$den = Formula("q^$bc")->reduce;

BEGIN_PGML
Rewrite the following expression without parentheses.
Simplify your answer as much as possible, and 
assume that all variables are positive.
[@  helpLink('formulas')  @]*

[# [. [``[$fraction]=\;``] .] [.
  [# [.[_]{$num} .]*{bottom => 2} [. [_]{$den} .]* #]{padding => '0.25'} .]*#]{valign => 'middle'}
END_PGML
ENDDOCUMENT();
