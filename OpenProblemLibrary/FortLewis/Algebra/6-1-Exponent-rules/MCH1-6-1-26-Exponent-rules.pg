## DESCRIPTION
## exponents
## ENDDESCRIPTION

## BookTitle('Algebra: Form and Function')
## BookChapter('Rules for Exponents and the Reasons for Them')
## DBsubject(Algebra)
## DBchapter(Properties of exponents, rational exponents and radicals)
## DBsection(Properties of exponents)
## Date(01/01/10)
## Institution(Fort Lewis College)
## Author(Paul Pearson)
## MLT(Quotient_in_power)
## Level(2)
## MO(1)
## TitleText1('Algebra: Form and Function')
## AuthorText1('McCallum, Connally, and Hughes-Hallett')
## EditionText1('1')
## Section1('6.1')
## Problem1('26')
## KEYWORDS('exponents')


DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'contextLimitedPolynomial.pl', 'PGcourse.pl');

Context("LimitedPolynomial-Strict");

$a = random(2,3,1);
$b = random(4,5,1);
$c = random(6,7,1);

$e2 = ($c - $a) * $b;



BEGIN_PGML
Write the following expression in the form
[` x^n `], assuming [` x \not= 0 `].  
Simplify your answer as much as possible.  
  
[` \displaystyle \left( \frac{x^{[$c]}}{x^{[$a]}} \right)^{[$b]} `] =
[@  ans_rule(10)  @]*
[@  helpLink('formulas')  @]*
END_PGML





ANS(Formula("x^($e2)")->cmp() );

;
ENDDOCUMENT();