## DESCRIPTION
## exponents
## ENDDESCRIPTION

## BookTitle('Algebra: Form and Function')
## BookChapter('Rules for Exponents and the Reasons for Them')
## DBsubject(Algebra)
## DBchapter(Operations on polynomial and rational expressions)
## DBsection(Polynomials: multiply)
## Date(01/01/10)
## Institution(Fort Lewis College)
## Author(Paul Pearson)
## Level(2)
## MO(1)
## TitleText1('Algebra: Form and Function')
## AuthorText1('McCallum, Connally, and Hughes-Hallett')
## EditionText1('1')
## Section1('6.1')
## Problem1('40')
## KEYWORDS('exponents')


DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl','PGcourse.pl');

Context("Numeric")->variables->are(x=>"Real",y=>"Real");

$a = random(2,9);
$base = Formula("(x^2+y)*(x+y^2)");
$exponent = Formula("$a");

BEGIN_PGML
Rewrite the following using a single exponent.
[@  helpLink('formulas')  @]*
  
[# [. [`(x^2+y)^{[$a]} (x+y^2)^{[$a]}=\;`] .] [.[`(`] [_]{$base} [`)`] .] 
   [.[# [. [_]{$exponent} .]* [. [`\phantom{I}`].]* #]{valign => 'top'}
 .]*#]{align => 'rcl', valign => 'bottom', padding => 0}
END_PGML
ENDDOCUMENT();