## DESCRIPTION
## exponents
## ENDDESCRIPTION

## BookTitle('Algebra: Form and Function')
## BookChapter('Rules for Exponents and the Reasons for Them')
## DBsubject(Algebra)
## DBchapter(Properties of exponents, rational exponents and radicals)
## DBsection(Properties of exponents)
## Date(01/01/10)
## Institution(Fort Lewis College)
## Author(Paul Pearson)
## Level(2)
## MO(1)
## TitleText1('Algebra: Form and Function')
## AuthorText1('McCallum, Connally, and Hughes-Hallett')
## EditionText1('1')
## Section1('6.1')
## Problem1('42')
## KEYWORDS('exponents')
## MLT(ExponentsFillBoxes)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Numeric")->variables->are(a => "Real", b => "Real");

$c        = random(3, 7);
$base     = Formula("a+b");
$exponent = Formula("2*$c");

BEGIN_PGML
Rewrite the following using a single exponent.
[@  helpLink('formulas')  @]*

[# [. [`\left( (a+b)^2 \right)^{[$c]}=\;`] .] [.[`(`] [_]{$base} [`)`] .] 
   [.[# [. [_]{$exponent} .]* [. [`\phantom{I}`].]* #]{valign => 'top'}
 .]*#]{align => 'rcl', valign => 'bottom', padding => 0}
END_PGML

ENDDOCUMENT();
