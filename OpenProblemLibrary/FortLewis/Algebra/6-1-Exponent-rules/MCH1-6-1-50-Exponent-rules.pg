## DESCRIPTION
## exponents
## ENDDESCRIPTION

## BookTitle('Algebra: Form and Function')
## BookChapter('Rules for Exponents and the Reasons for Them')
## DBsubject(Arithmetic)
## DBchapter(Integers)
## DBsection(Exponentiation)
## Date(01/01/10)
## Institution(Fort Lewis College)
## Author(Paul Pearson)
## Level(2)
## TitleText1('Algebra: Form and Function')
## AuthorText1('McCallum, Connally, and Hughes-Hallett')
## EditionText1('1')
## Section1('6.1')
## Problem1('50 52 54 56 58')
## KEYWORDS('exponents')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'parserPopUp.pl', 'PGcourse.pl');

for my $i (0 .. 5) {
    $a[$i] = random(1, 99, 2);    # odds
    $b[$i] = random(2, 98, 2);    # evens
}

@opts = (
    "\( (-$a[0])^{$b[0]} \)",
    "\( $a[1]^{-1} \)",
    "\( - $a[2]^{-$b[1]} \)",
    "\( (-$a[3])^0 \)",
    "\( (-$a[4])^{-$a[5]} \)"
);

@ans = (0, 0, 1, 0, 1);

@shuffle = random_subset(5, 0 .. 4);

@dd = map { DropDown([ 'positive', 'negative' ], $_) } @ans;

@rows = map { [
    ('a' .. 'e')[$_] . '.',
    $opts[ $shuffle[$_] ],
    # PGML('[_]{$dd[$shuffle[$_]]}')
    $dd[ $shuffle[$_] ]->menu
] } (0 .. 4);

BEGIN_PGML
Without a calculator, determine whether the following quantities are positive or negative.

[# [..]*{rows => ~~@rows} #]{padding => 0.4, center => 0}

END_PGML

ANS($dd[ $shuffle[$_] ]->cmp) for (0 .. 4);

ENDDOCUMENT(); 