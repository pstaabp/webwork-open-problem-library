## TitleText1('Algebra: Form and Function')
## AuthorText1('McCallum, Connally, and Hughes-Hallett')
## EditionText1('1')
## Section1('6.1')
## Problem1('42')
## KEYWORDS('exponents')
## MLT(Algebra_PropExp_PropExp)


DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl','PGcourse.pl');

Context("Numeric")->variables->are(y=>"Real");

$b = random(2,6);
$b2 = 2 * $b;
$c = 2**$b;
$base = Formula("2*y");
$exponent = Formula("$b2");

BEGIN_PGML
Rewrite the following using a single exponent.
[@  helpLink('formulas')  @]*
  
[# [. [`[$c]^2 y^{[$b2]}=\;`] .] [.[`(`] [_]{$base} [`)`] .] 
   [.[# [. [_]{$exponent} .]* [. [`\phantom{I}`].]* #]{valign => 'top'}
 .]*#]{align => 'rcl', valign => 'bottom', padding => 0}
END_PGML

ENDDOCUMENT();