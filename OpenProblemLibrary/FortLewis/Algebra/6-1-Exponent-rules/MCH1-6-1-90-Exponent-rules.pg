## DESCRIPTION
## exponents
## ENDDESCRIPTION

## BookTitle('Algebra: Form and Function')
## BookChapter('Rules for Exponents and the Reasons for Them')
## DBsubject(Algebra)
## DBchapter(Properties of exponents, rational exponents and radicals)
## DBsection(Properties of exponents)
## Date(01/01/10)
## Institution(Fort Lewis College)
## Author(Paul Pearson)
## Level(2)
## MO(1)
## TitleText1('Algebra: Form and Function')
## AuthorText1('McCallum, Connally, and Hughes-Hallett')
## EditionText1('1')
## Section1('6.1')
## Problem1('90')
## KEYWORDS('exponents')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Numeric")->variables->are(t => "Real");

$b = random(3, 5);
$c = random(2, 9);

$num = Formula("e^t * (t+$c)")->reduce;
$den = Formula("e^$b")->reduce;

BEGIN_PGML
Using laws of exponents, rewrite the following
expression as a quotient.
[@  helpLink('numbers')  @]*

[# [. [``e^{t-[$b]} (t+[$c])=\;``] .] [.
  [# [.[_]{$num} .]*{bottom => 2} [. [_]{$den} .]* #]{padding => '0.25'} .]*#]{valign => 'middle'}
END_PGML

ENDDOCUMENT();
