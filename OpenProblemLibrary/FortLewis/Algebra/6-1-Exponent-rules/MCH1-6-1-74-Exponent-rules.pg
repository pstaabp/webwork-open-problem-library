## DESCRIPTION
## exponents
## ENDDESCRIPTION

## BookTitle('Algebra: Form and Function')
## BookChapter('Rules for Exponents and the Reasons for Them')
## DBsubject(Algebra)
## DBchapter(Properties of exponents, rational exponents and radicals)
## DBsection(Properties of exponents)
## Date(01/01/10)
## Institution(Fort Lewis College)
## Author(Paul Pearson)
## Level(2)
## TitleText1('Algebra: Form and Function')
## AuthorText1('McCallum, Connally, and Hughes-Hallett')
## EditionText1('1')
## Section1('6.1')
## Problem1('74')
## KEYWORDS('exponents')
## MLT(Algebra_PropExp_PropExp)


DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl',  'parserCheckboxList.pl', 'PGcourse.pl');

$a = random(3,9,2);
$b = 2;
$adb = $a / $b;

$cb = CheckboxList([[
    "\( \displaystyle \left( \frac{$a}{$b} \right)^{n}\)",
    "\( \displaystyle \left( \frac{$b}{$a} \right)^{-n}\)",
    "\( \displaystyle \left( \frac{1}{ \frac{$b}{$a} } \right)^{n} \)",
    "\( \displaystyle \frac{$b^{-n}}{$a^{-n}} \)",
    "\( \displaystyle \left( $adb \right)^{n} \)",
    "\( \displaystyle -\left( \frac{$a}{$b} \right)^{n} \)"
]],[0..4], labels => 'ABC', separator => '<div style="height: 11px"></div>');

$showPartialCorrectAnswers = 0;
BEGIN_PGML
"Select all expressions that are equivalent to
[`` \frac{[$a]^n}{[$b]^n}``].  There may be more than one correct answer."

[_]{$cb}

END_PGML

ENDDOCUMENT();