## Problem1('32')
## KEYWORDS('exponents')


DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Numeric")->variables->are(n=>"Real");

$a = random(2,9,1);
$answera = Formula("$a + n");

$b = random(3,9,1);
#$answerb = Formula("$b");



BEGIN_PGML
Rewrite the following using a single exponent.
  
[` 4^{[$a]} \cdot 4^n = 4^x `] for [` x `] = [@  ans_rule(10)  @]*
[@  helpLink('formulas')  @]*
END_PGML





ANS($answera->cmp() );
#ANS($answerb->cmp() );

;
ENDDOCUMENT();