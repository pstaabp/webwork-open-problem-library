## DESCRIPTION
## exponents
## ENDDESCRIPTION

## BookTitle('Algebra: Form and Function')
## BookChapter('Rules for Exponents and the Reasons for Them')
## DBsubject(Arithmetic)
## DBchapter(Integers)
## DBsection(Multiple operations)
## Date(01/01/10)
## Institution(Fort Lewis College)
## Author(Paul Pearson)
## MLT(WithExponents)
## Level(2)
## MO(1)
## TitleText1('Algebra: Form and Function')
## AuthorText1('McCallum, Connally, and Hughes-Hallett')
## EditionText1('1')
## Section1('6.1')
## Problem1('2 4 6')
## KEYWORDS('exponents')

DOCUMENT();

loadMacros(
    'PGstandard.pl',      'PGML.pl',
    'contextFraction.pl', 'answerHints.pl',
    'PGcourse.pl'
);

Context("Numeric");

$a = random(3, 9, 1);
$b = list_random(2, 4, 5);

$c1   = random(3, 7, 2);
$c2   = random(2, 3);
$c2c2 = $c2 * $c2;

@ans = (
    Real("-($a^2)")
        ->cmp()
        ->withPostFilter(AnswerHints(Real("$a^2") => "Is -1 being squared?")),
    Real("9*$b"), Real("-1")
);

Context()->operators->undefine("+", "-", "*", "^", "**", "/");
Context()->functions->disable("All");

BEGIN_PGML
Evaluate the following expressions without using
a calculator.  Simplify your answers as much
as possible.  

a) [` -[$a]^2= \;`] [_]{$ans[0]}

b) [` [$b]^1 \cdot 1^7 \cdot 3^2= \;`] [_]{$ans[1]}

c) [``\frac{-1^{[$c1]} \cdot (-[$c2])^4}{[$c2c2]^2} \;``] [_]{$ans[2]}

[@  helpLink('numbers')  @]*
END_PGML
ENDDOCUMENT();
