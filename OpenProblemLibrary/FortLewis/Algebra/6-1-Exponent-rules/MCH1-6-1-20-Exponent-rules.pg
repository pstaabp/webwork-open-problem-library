## DESCRIPTION
## exponents
## ENDDESCRIPTION

## BookTitle('Algebra: Form and Function')
## BookChapter('Rules for Exponents and the Reasons for Them')
## DBsubject(Algebra)
## DBchapter(Algebra of real numbers and simplifying expressions)
## DBsection(Evaluating expressions)
## Date(01/01/10)
## Institution(Fort Lewis College)
## Author(Paul Pearson)
## Level(2)
## MO(1)
## TitleText1('Algebra: Form and Function')
## AuthorText1('McCallum, Connally, and Hughes-Hallett')
## EditionText1('1')
## Section1('6.1')
## Problem1('20 22')
## KEYWORDS('exponents')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

Context('Fraction-NoDecimals');

$x = 2;                   #random(2,3,1);
$y = random(-4, -2, 1);
while (abs($y) == $x) { $y = random(-4, -2, 1); }
$z = random(-5, -3, 1);
if ($y == $z) { $z = -5; }

@ans = (
    Fraction($x**6 * $y**2, 4 * $z**2),
    Fraction(($x + $y)**$x, ($x - $z)**$x)
);

Context()->operators->undefine("+", "-", "*", "^", "**");
Context()->functions->disable("All");

BEGIN_PGML
Evaluate the following expressions for [` x = [$x] `],
[` y = [$y] `], and [` z = [$z] `] without using
a calculator.  Simplify your answers as much
as possible, and enter your answers as fractions.  


a) [``\left( \frac{x^3 y}{2z} \right)^2 =\;``][_]{$ans[0]}

b) [``\left( \frac{x+y}{x-z} \right)^x =\; ``] [_]{$ans[1]}

[@  helpLink('fractions')  @]*
END_PGML

ENDDOCUMENT();
