## DESCRIPTION
## exponents
## ENDDESCRIPTION

## BookTitle('Algebra: Form and Function')
## BookChapter('Rules for Exponents and the Reasons for Them')
## DBsubject(Algebra)
## DBchapter(Algebra of real numbers and simplifying expressions)
## DBsection(Evaluating expressions)
## Date(01/01/10)
## Institution(Fort Lewis College)
## Author(Paul Pearson)
## Level(2)
## MO(1)
## TitleText1('Algebra: Form and Function')
## AuthorText1('McCallum, Connally, and Hughes-Hallett')
## EditionText1('1')
## Section1('6.1')
## Problem1('68')
## KEYWORDS('exponents')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl',  'PGcourse.pl');

Context("Numeric");

$a = random(2, 3, 1);
if   ($a == 2) { $b = 3; }
else           { $b = 2; }
$c = random(3, 4, 1);

$atoc = $a**$c;
$btoc = $b**$c;

$num = Formula("$atoc")->reduce;
$den = Formula("$btoc")->reduce;

Context()->operators->undefine("+", "-", "*", "^", "**", "/");

BEGIN_PGML
Rewrite the following expression without parentheses.
Simplify your answer as much as possible, and 
assume that all variables are positive.
[@  helpLink('formulas')  @]*
  
[# [. [``\left( \frac{[$a]}{[$b]} \right)^{[$c]}=\;``] .] [.
  [# [.[_]{$num} .]*{bottom => 2} [. [_]{$den} .]* #]{padding => '0.25'} .]*#]{valign => 'middle'}
END_PGML

ENDDOCUMENT();
