## AuthorText1('McCallum, Connally, and Hughes-Hallett')
## EditionText1('1')
## Section1('6.1')
## Problem1('38')
## KEYWORDS('exponents')


DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Numeric")->variables->are(A=>"Real",B=>"Real",n=>"Real");

$a = random(3,9);
$base = Formula("A*B");
$exponent = Formula("n+$a");


BEGIN_PGML
Rewrite the following using a single exponent.
[@  helpLink('formulas')  @]*
  
[# [. [`A^{n+[$a]} B^{n} B^{[$a]}=\;`] .] [.[`(`] [_]{$base} [`)`] .] 
   [.[# [. [_]{$exponent} .]* [. [`\phantom{I}`].]* #]{valign => 'top'}
 .]*#]{align => 'rcl', valign => 'bottom', padding => 0}
END_PGML

ENDDOCUMENT();