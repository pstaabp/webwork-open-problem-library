## DESCRIPTION
## exponents
## ENDDESCRIPTION

## BookTitle('Algebra: Form and Function')
## BookChapter('Rules for Exponents and the Reasons for Them')
## DBsubject(Arithmetic)
## DBchapter(Fractions/rational numbers)
## DBsection(Multiple operations)
## Date(01/01/10)
## Institution(Fort Lewis College)
## Author(Paul Pearson)
## MLT(RationalWithExponent)
## Level(2)
## MO(1)
## TitleText1('Algebra: Form and Function')
## AuthorText1('McCallum, Connally, and Hughes-Hallett')
## EditionText1('1')
## Section1('6.1')
## Problem1('8 10 12')
## KEYWORDS('exponents')

DOCUMENT();

loadMacros(
    'PGstandard.pl',      'PGML.pl',
    'contextFraction.pl', 'answerHints.pl',
    'PGcourse.pl'
);

Context("Numeric");

$a = random(3, 5);
$c = random(3, 7);

@ans = (
    Real("4*$a^3")->cmp()->withPostFilter(
        AnswerHints(Real("-4*$a^3") => "Is -1 being squared or cubed?")
    ),
    Real("64"),
    Real("1"),
    Real("0")
);

Context()->operators->undefine("+", "-", "*", "^", "**", "/");
Context()->functions->disable("All");

BEGIN_PGML
Evaluate the following expressions without using
a calculator.  Simplify your answers as much
as possible.  
[@  helpLink('numbers')  @]*
  
a) [`\quad-[$a]^3 \cdot -2^2=\;`][_]{$ans[0]}

b) [``\quad\left(\frac{-4^3}{-2^3}\right)^2=\; ``] [_]{$ans[1]}

c) [``\quad[$c]^0=\; ``] [_]{$ans[2]}

d) [``\quad0^[$c]=\; ``] [_]{$ans[3]}
END_PGML

ENDDOCUMENT();
