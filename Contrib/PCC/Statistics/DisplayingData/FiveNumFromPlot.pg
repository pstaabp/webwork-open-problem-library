##DESCRIPTION
##ENDDESCRIPTION
## DBsubject('Statistics')
## DBchapter('What is Statistics?')
## DBsection('Characterizing a Set of Measurements: Graphical Methods')
## KEYWORDS('boxplot', 'five number summary')
## Author('Edgar Fisher')
## Institution('NAU')

# File Created: 6/6/05
# Location: Northern Arizona University

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'StatisticalPlots.pl', 'PGcourse.pl');

$statPlot = StatPlot(
    xmin         => 10,
    xmax         => 110,
    xtick_delta  => 10,
    xminor       => 9,
    xlabel       => '',
    ymin         => -1,
    ymax         =>  3,
    show_grid    =>  0,
    aspect_ratio => 10

);

($min, $q1, $median, $q3, $max) = (
    random(15, 30),
    random(35, 43),
    random(45, 70),
    random(72, 85),
    random(89, 100)
);

$statPlot->add_boxplot(
    {
        min    => $min,
        q1     => $q1,
        median => $median,
        q3     => $q3,
        max    => $max
    },
    fill_color   => 'lightyellow',
    stroke_width => 1
);

@slice = num_sort(random_subset(2, 0 .. 4));

@labels = ("Minimum", "First quartile", "Median", "Third quartile", "Maximum");

@dat = ($min, $q1, $median, $q3, $max);

BEGIN_PGML
Consider the following box and whisker plot.  Find the indicated values of the represented data.

>>[!!]{$statPlot}{600}<<

a) [$labels[$slice[0]]]: [_]{$dat[$slice[0]]}
a) [$labels[$slice[1]]]: [_]{$dat[$slice[1]]}

END_PGML

BEGIN_PGML_SOLUTION

The markers from left to right on a boxplot are the minimum, quartile [`1`], the median, quartile [`3`] and the maximum.  As such, we have the following,

a) The [$labels[$slice[0]]] is [`[$dat[$slice[0]]]`]

b) The [$labels[$slice[1]]] is [`[$dat[$slice[1]]]`]
END_PGML_SOLUTION

ENDDOCUMENT();
