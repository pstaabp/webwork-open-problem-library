## DESCRIPTION
## Calculus
## ENDDESCRIPTION

## Tagged by tda2d

## DBsubject(Calculus - single variable)
## DBchapter(Applications of differentiation)
## DBsection(Optimization - general)
## Date(8/23/07)
## Institution(ASU)
## MLT(Optimization_FenceCost)
## MLTleader(1)
## Level(5)
## MO(1)
## KEYWORDS('derivative' 'extrema' 'optimization','Optimization' 'Maximum' 'Minimum')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'plots.pl', 'scaffold.pl',
    'PGcourse.pl');

#  The scaffold

Scaffold::Begin(
    can_open                  => "when_previous_correct",
    is_open                   => "always",
    instructor_can_open       => "always",
    after_AnswerDate_can_open => "always",
    hardcopy_is_open          => "always",
);

Context("Numeric");
Context()->variables->add(y => 'Real');

$a  = random(200, 320, 10);
$b  = random(3,   6);
$c  = random(12,  16);
$C  = Formula("$b(2y+x) + $c*x");
$d  = Formula("x*y ");
$t  = Formula("$a/x");
$r  = Formula("$b((2*$a)/x+x) + $c*x");
$dr = $r->D('x');
$l  = sqrt(2 * $a / ($c / $b + 1));
$w  = $a / sqrt(2 * $a / ($c / $b + 1));

BEGIN_PGML
A fence is to be built to enclose a rectangular area of [$a] square
feet.  The fence along three sides is to be made of material that
costs [$b] dollars per foot, and the material for the fourth side
costs [$c] dollars per foot.  Find the dimensions of the enclosure
that is most economical to construct.

END_PGML

$plot = Plot(
    xmin            => -1,
    xmax            =>  8,
    xvisible        =>  0,
    ymin            => -1,
    ymax            =>  5,
    yvisible        =>  0,
    show_grid       =>  0,
    rounded_corners =>  1,
    aspect_ratio    => 1
);
$plot->add_rectangle([ 0, 0 ], [ 7, 4 ]);
$plot->add_label(
    [ 3.5, 0, "\\(x\\)", v_align => 'top' ],
    [ 7,   2, "\\(y\\)", h_align => 'left' ]
);

BEGIN_PGML_HINT
Use this image to find the perimeter that minimizes the total length of fence.

>>[!A rectangle of height [y] and width [x].!]{$plot}{200}<<
END_PGML_HINT

Section::Begin(
    "Part 1: State the cost of the perimeter of this rectangle as a function of x and y."
);

BEGIN_PGML
  
[`C(x,y) =\;`] [_]{$C}
END_PGML

Section::End();

Section::Begin(
    "Part 2: State the area of this rectangle as a function of x and y.");

BEGIN_PGML

 [`A(x, y) =\;`] [_]{$d}
END_PGML
Section::End();

Section::Begin(
    "Part 3: Find y as a function of x, using the given value of the area of the rectangle."
);

BEGIN_PGML
 [` y =\;`]  [_]{$t}
END_PGML

Section::End();

Section::Begin("Part 4: Rewrite the cost as a function of x.");

BEGIN_PGML

 [` C(x)=\;`]  [_]{$r}
END_PGML

Section::End();

Section::Begin(
    "Part 5: Find the derivative of the cost of the perimeter of the rectangle with respect to x."
);

BEGIN_PGML

 [` C'(x)=\;`] [_]{$dr}

END_PGML

Section::End();

Section::Begin(
    "Part 6: Find the x and y values that minimize the cost of the perimeter of the rectangular fence."
);

BEGIN_PGML

[` x = \;`]  [_]{$l}
END_PGML

BEGIN_PGML

[` y = \;`]  [_]{$w} ft.   

END_PGML

Section::End();

Scaffold::End();

ENDDOCUMENT();
