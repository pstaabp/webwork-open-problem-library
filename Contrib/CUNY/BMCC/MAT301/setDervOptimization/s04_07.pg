DOCUMENT();    # This should be the first executable line in the problem.

loadMacros(
    'PGstandard.pl',            'PGML.pl',
    'plots.pl',                 'PGgraders.pl',
    'parserNumberWithUnits.pl', 'scaffold.pl',
    'PGcourse.pl'
);

## Show partial correct answers

#  The scaffold

Scaffold::Begin(
    can_open                  => "when_previous_correct",
    is_open                   => "always",
    instructor_can_open       => "always",
    after_AnswerDate_can_open => "always",
    hardcopy_is_open          => "always",
);

Context("Numeric");
Context()->variables->add(h => 'Real');

$b   = random(2, 8, 2);
$a   = $b**3 / 2;
$d   = Formula("x^2 + 4xh");
$v   = Formula("x^2*h");
$h   = Formula("$a/x^2");
$ar  = Formula("x^2 + 4*$a/x");
$dar = $ar->D('x');
$n   = (2 * $a)**(1 / 3);
$k   = $a / ($n)**2;

$length = NumberWithUnits("$n", "m");
$height = NumberWithUnits("$k", "m");

BEGIN_PGML
A box with an open top has vertical sides, a square bottom, and a
volume of [$a] cubic meters. If the box has the least possible surface
area, find its dimensions.

END_PGML

$plot = Plot(
    xmin            => -1,
    xmax            =>  9,
    xvisible        =>  0,
    ymin            => -1,
    ymax            =>  9,
    yvisible        =>  0,
    show_grid       =>  0,
    rounded_corners =>  1,
    aspect_ratio    => 1
);
$plot->add_rectangle([ 0, 0 ], [ 6, 3 ], fill_color => 'lightblue');
$plot->add_dataset(
    [
        [ 6, 0 ], [ 8, 4 ], [ 8, 7 ], [ 6, 3 ], [ 6, 0 ],
        fill       => 'self',
        fill_color => 'lightgreen'
    ],
    [
        [ 8, 7 ], [ 2, 7 ], [ 0, 3 ], [ 6, 3 ], [ 8, 7 ],
        fill       => 'self',
        fill_color => 'lightpink'
    ],
    [ [ 2, 7 ], [ 2, 4 ] ],
    [
        [ 1.5, 3 ], [ 2, 4 ], [ 6.5, 4 ], [ 6, 3 ], [ 1.5, 3 ],
        fill       => 'self',
        fill_color => 'lightyellow',
        opacity    => 0.9
    ]
);
$plot->add_label(
    [ 3.5, 0, "\\(x\\)", v_align => 'top' ],
    [ 7,   2, "\\(x\\)", h_align => 'left', v_align => 'top' ],
    [ 8,   5, "\\(h\\)", h_align => 'left' ]
);

BEGIN_PGML_HINT
Use this image to find the dimensions of the open box that will minimize the surface area.


>>[!An open top box.  The bottom of the box have sides of length x and the vertical dimension is h!]{$plot}{300}<<

END_PGML_HINT

Section::Begin(
    "Part 1: Find the surface area of the open box as a function of x and h, where x represents the length of the sides of the square base and h the height of the open box.."
);

BEGIN_PGML
  
[`A(x,h) =`] [_]{$d}
END_PGML

Section::End();

Section::Begin(
    "Part 2: Find the volume of the open box as a function of x and h.");

BEGIN_PGML

 [`V(x, y) =`] [_]{$v}
 
END_PGML

Section::End();

Section::Begin(
    "Part 3: Find the value of h as a function of x, using the given value of the volume."
);

BEGIN_PGML

 [` h =`] [_]{$h}
 
END_PGML

Section::End();

Section::Begin(
    "Part 4: Rewrite the surface area of the open box as a function of x only."
);

BEGIN_PGML

 [` A(x)=`] [_]{$ar}

END_PGML

Section::End();

Section::Begin(
    "Part 5: Find the derivative of the surface area of the open box with respect to x."
);

BEGIN_PGML

[` A'(x)=`] [_]{$dar}

END_PGML

Section::End();

Section::Begin(
    "Part 6: Find the height and length values that minimize the surface area of the open box."
);

BEGIN_PGML
  
- Height = [_]{$height}

- Length of base = [_]{$length}

(include [@  helpLink('units')  @]*)
END_PGML

Section::End();

Scaffold::End();

ENDDOCUMENT();  # This should be the last executable line in the problem.