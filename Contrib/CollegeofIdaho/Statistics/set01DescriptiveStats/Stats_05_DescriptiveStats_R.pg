## DESCRIPTION
##   Using R to find descriptive statistics
## ENDDESCRIPTION

## DBsubject(Statistics)
## DBchapter(Exploratory data analysis/descriptive statistics)
## DBsection(Summary statistics)
## Date(01/01/14)
## Institution(The College of Idaho)
## Author(R Cruz)
## Level(2)
## KEYWORDS('Descriptive Statistics')

DOCUMENT();

loadMacros(
    'PGstandard.pl',         'PGML.pl',
    'PGstatisticsmacros.pl', 'contextArbitraryString.pl',
    'PGcourse.pl'
);

Context('Numeric');

$dataName = list_random("dog", "pounds", "wts", "d");

@data   = num_sort(map { random(10, 20, 0.1) } (0 .. 8));
$median = $data[4];
$mean   = stats_mean(@data);
$sd     = stats_sd(@data);
@data   = @data[ random_subset(9, 0 .. 8) ];                # scramble the data.

Context("ArbitraryString");
$check = sub {
    my ($correct, $student, $ans) = @_;
    return $correct->value eq $student->value;
};

$mean_cmd   = Compute("mean($dataName)");
$median_cmd = Compute("median($dataName)");
$sd_cmd     = Compute("sd($dataName)");

BEGIN_PGML
The table below gives the weights (in pounds) of nine dogs:

>>[@ join(', ', @data) @]<<

  
In RStudio, enter the data by hand. Call the dataset  *[$dataName]****. Use RStudio to compute the following descriptive statistics.  State the *R* command and the value:

a) *R* command to find the mean: [_]{$mean_cmd->cmp(checker => $checker)}

    Mean: [_]{$mean}

b) *R* command to find the median: [_]{$median_cmd->cmp(checker => $checker)}

    Median: [_]{$median} pounds

c) *R* command to find the standard deviation: [_]{$sd_cmd->cmp(checker => $checker)}

    Standard deviation: [_]{$sd} pounds

END_PGML

BEGIN_PGML_SOLUTION

a) *R* command: [$mean_cmd]

    Mean: [$mean]

b)  *R* command: [$median_cmd]

    Median: [$median]

c) *R* command: [$sd_cmd]

    Standard deviation: [$sd]
END_PGML_SOLUTION

ENDDOCUMENT();
