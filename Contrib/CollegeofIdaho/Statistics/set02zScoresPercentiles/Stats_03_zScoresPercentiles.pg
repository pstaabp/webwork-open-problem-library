## DESCRIPTION
## DBsubject(Statistics)
## DBchapter(Sampling distributions)
## DBsection(Sample mean)
## Institution(The College of Idaho)
## Author(R Cruz, L Danielson, J Guild)
## Level(2)
## TitleText1('The Basic Practice of Statistics')
## AuthorText1('David Moore')
## EditionText1('5e')
## Section1('3')

## KEYWORDS('Measure', 'Mean', 'Standard Deviation', 'Score','statistics','measures','mean','standard deviation','z score')

DOCUMENT();

loadMacros(
    'PGstandard.pl',   'PGML.pl',
    'randomPerson.pl', 'parserRadioButtons.pl',
    'PGcourse.pl'
);

$p = randomPerson();

@sub = (
    'Calculus', 'Biology',    'Spanish',    'History',
    'Physics',  'Statistics', 'Literature', 'Chemistry'
);
@slice = random_subset(4, 0 .. 5);
@ssub  = @sub[@slice];

@mean  = (70, 77, 44, 53, 60, 69);
@smean = @mean[@slice];

@dev  = (12, 10, 12, 16, 14, 8);
@sdev = @dev[@slice];

@z      = map { -1 + $_ * 0.25 } (0 .. 12);
@zslice = random_subset(4, 0 .. 12);
@sz     = @z[@zslice];

@grade = map { $smean[$_] + $sdev[$_] * $sz[$_] } (0 .. 3);

$sz = -100;
for (0 .. 3) {
    if ($sz[$_] > $sz) { $best = $_; $sz = $sz[$_]; }
}

$rb = RadioButtons([@ssub], $best, labels => 'ABC');

BEGIN_PGML
  
[$p] took 4 courses last semester: [$ssub[0]], [$ssub[1]], [$ssub[2]], and [$ssub[3]].
The means and standard deviations for the final exams, and [$p]'s scores are given 
in the table below. Convert [$p->their] scores into [`z`]-scores. 

[#
    [.Subject.][.Mean.][.Std.Dev. .][.[$p]'s score.][. [$p]'s [`z`]-score .]{headerrow=>1}*
    [. [$ssub[0]] .] [.[$smean[0]].] [.[$sdev[0]].][. [$grade[0]] .] [. [_]{$sz[0]} .]*
    [. [$ssub[1]] .] [.[$smean[1]].] [.[$sdev[1]].][. [$grade[1]] .] [. [_]{$sz[1]} .]*
    [. [$ssub[2]] .] [.[$smean[2]].] [.[$sdev[2]].][. [$grade[2]] .] [. [_]{$sz[2]} .]*
    [. [$ssub[3]] .] [.[$smean[3]].] [.[$sdev[3]].][. [$grade[3]] .] [. [_]{$sz[3]} .]*
#]{align => '|c|c|c|c|c|', padding => 0.3, horizontalrules => 1}

On what exam did [$p] have the highest relative score? [_]{$rb}

END_PGML

BEGIN_PGML_SOLUTION
Recall that the [`z`]-score for a value [`x`] that comes from a distribution with mean [`\bar{x}`] and standard deviation [`s`] is 
[``` z= \frac{x - \bar{x}}{s} ```]

Using this formula with the values in the table results in 

- [$ssub[0]]: [$sz[0]]
- [$ssub[1]]: [$sz[1]]
- [$ssub[2]]: [$sz[2]]
- [$ssub[3]]: [$sz[3]]

To answer the highest relative score, look for the largest [`z`]-score.  This occurs for him in [$rb].
END_PGML_SOLUTION

ENDDOCUMENT();       # This should be the last executable line in the problem.