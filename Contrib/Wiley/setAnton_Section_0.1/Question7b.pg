# ************************************
#   Comments + Keyword Clarification

#    Anton, Calculus, 0.1.7b
# ************************************
# DESCRIPTION
# Evaluate function values at specific values of x for piecewise continuous
#    f(x) = A/x , x >  Val
#           Bx  , x <= Val

# ENDDESCRIPTION
## DBsubject('Calculus')
## DBchapter('Before Calculus')
## DBsection('Functions')
## KEYWORDS('Functions', 'Piecewise', 'Domain')
## TitleText1('Calculus')
## EditionText1('9')
## AuthorText1('Anton')
## Section1('0.1')
## Problem1('7b')
## Author('')
## Institution('John Wiley & Sons')
#***************************************************************
#***************************************************************
DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'contextPiecewiseFunction.pl', 'contextFraction.pl', 'PGcourse.pl');

Context("Numeric")->flags->set(reduceConstantFunctions=>0);
Parser::Number::NoDecimals;
#****************************************************
#  Create piecewise function.
#    f1 = A/x,  f2 = Bx
#****************************************************
$A = random(2,3);
$B = random(2,5);
$F1 = Compute("$A/x");
$F2 = Compute("$B x")->reduce;
$Xbound = random(3,4);
$X1 = random(5,7);
$X2 = $Xbound;
$SQRTX = Compute("sqrt(x)");
#*************************************************
#   Make sure that sqrt(CONST) is not evaluated
#*************************************************
$SQRTX1 = $SQRTX->substitute(x=>"$X1");
#**************
#   Answers
#**************
$CT2 = Context("Fraction-NoDecimals")->flags->set(reduceConstants=>0);
$F0 = Compute("0");
$FX1 = $F1->eval(x=>$X1);
$FNEGX1 = $F2->eval(x=>-$X1);
$FX2 = $F2->eval(x=>$X2);
$FSQRTX1 = $F2->eval(x=>"$SQRTX1");

@opts = ("f(0)", "f($X1)", "f(-$X1)", "f($X2)", "f(\sqrt{$X1})");
@ans = ($F0, $FX1, $FNEGX1, $FX2, $FSQRTX1);

#***********************************************************
#   Create a piecewise function using the functions above
#***********************************************************\
Context("PiecewiseFunction");
$Fpiece = Formula("$F1 if x > $Xbound else $F2 if x <= $Xbound");
Context("Numeric");

BEGIN_PGML
Find [` f(0), f([$X1]), f(-[$X1]), f([$X2]), `] and [` f([$SQRTX1]) `] for:

[``` \small{f(x) = [$Fpiece]} ```]

a) [`[$opts[0]] = \;`] [_]{$ans[0]}

b) [`[$opts[1]] = \;`] [_]{$ans[1]}

c) [`[$opts[2]] = \;`] [_]{$ans[2]}

d) [`[$opts[3]] = \;`] [_]{$ans[3]}

e) [`[$opts[4]] = \;`] [_]{$ans[4]}

END_PGML


BEGIN_PGML_SOLUTION

To evaluate a function at a specific value of the input variable [` x `], replace all instances of
the variable [` x `] with the input value and evaluate the resulting expression.
In the case of a piecewise function such as this one, you must first determine which "branch"
of the function to use, based upon the definition of the function and the input value of [` x`].
For [`f([$X1]), [$X1] > [$Xbound] `] and so the upper portion of the definition is used. 

In the remaining cases the input value is [` \le [$Xbound]`], so the lower portion of the
definition is used. Therefore,

a) [`` f(0) = [$B](0) = [$F0] ``] 

b) [``f(-[$X1]) = [$B] (-[$X1]) = [$FNEGX1]``]

c) [``f([$X2]) = [$B] ([$X2]) = [$FX2]``]

d) [`` f\left([$SQRTX1]\right) = [$B] \left([$SQRTX1]\right)``]

e) [`` f\left([$X1]\right) = \frac{[$A]}{[$X1]} ``]

END_PGML_SOLUTION

ENDDOCUMENT();