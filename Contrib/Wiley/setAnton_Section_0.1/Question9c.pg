# ************************************
#   Comments + Keyword Clarification

#    Anton, Calculus, 0.1.9c
# ************************************
# DESCRIPTION
# Determine the domain and range of f(x) = sqrt(x^2 - B)

# ENDDESCRIPTION
## DBsubject('Calculus')
## DBchapter('Before Calculus')
## DBsection('Functions')
## KEYWORDS('Functions', 'Domain', 'Range')
## TitleText1('Calculus')
## EditionText1('9')
## AuthorText1('Anton')
## Section1('0.1')
## Problem1('9b')
## Author('')
## Institution('John Wiley & Sons')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Numeric");
#****************************************************
#  Create function of form sqrt(x^2 - B)
#****************************************************
$A = random(0, 9);
#***********************************************************************
#  Create array of non-perfect squares and use $A as index into array
#***********************************************************************
@Bvals = (2, 3, 5, 6, 7, 11, 13, 14, 15, 17);
$B     = $Bvals[$A];
$Func  = Formula("sqrt(x^2 - $B)");
#**************
#   Answers
#**************
Context("Interval")->flags->set(reduceConstantFunctions => 0);
$Domain = Compute("(-inf,-sqrt($B)] U [sqrt($B),inf)");
$Range  = Compute("[0,inf)");

BEGIN_PGML
Find the domain and range of the function [``f(x) = [$Func] ``]. Express each in
interval notation.

a) Domain: [_]{$Domain}

b) Range: [_]{$Range}

[@ helpLink('interval') @]*
END_PGML

BEGIN_PGML_SOLUTION
For a square root function such as [`f(x) = [$Func]`], the domain is restricted to
all values of [`x`] that do not produce a negative value inside the radical.
Therefore, the domain of this function includes all real values of [`x`] such that 
[`x^2 -[$B] \ge 0`], or [`x^2 \ge [$B]`].
  
This inequality is satisfied for [`x \le -\sqrt{[$B]}`] or [`x \ge \sqrt{[$B]}`].
Expressed in interval form, this is
[`(-\infty,-\sqrt{[$B]}] \cup [\sqrt{[$B]},\infty)`]. 
  
By the definition of the square root, the result is strictly nonnegative. Therefore, the range of 
[`f(x) = [$Func]`] is [`y \ge 0`]. Expressed in interval form, this is 
[`[$Range]`].  

END_PGML_SOLUTION

ENDDOCUMENT();
