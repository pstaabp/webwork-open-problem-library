# ************************************
#   Comments + Keyword Clarification

#    Anton, Calculus, 0.1.8a
# ************************************
# DESCRIPTION
# Evaluate function values at specific values of x for g(x) = (x + A)/(x - A)

# ENDDESCRIPTION
## DBsubject('Calculus')
## DBchapter('Before Calculus')
## DBsection('Functions')
## KEYWORDS('Functions', 'Rational')
## TitleText1('Calculus')
## EditionText1('9')
## AuthorText1('Anton')
## Section1('0.1')
## Problem1('7a')
## Author('')
## Institution('John Wiley & Sons')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'contextFraction.pl', 'PGcourse.pl');

Context("Numeric");
#********************************************
#  Create function of form (x + A)/(x - A)
#********************************************
$A    = random(1, 5);
$Func = Formula("(x + $A)/(x - $A)");
$X1   = non_zero_random(-7, -$A - 1);
$X2   = -$A;
$X3   = Formula("pi")->reduce;
$X4   = -$A - 0.1;

Context()->variables->add(t => "Real");
$C     = random(1, 6);
$Tfunc = Compute("t^2 - $C");

Context("Fraction")->variables->add(t => "Real");

$n       = $X1 + $A;
$d       = $X1 - $A;
$FX1     = Compute("$n/$d")->reduce;
$FX2     = $Func->eval(x => $X2);
$FX3     = $Func->substitute(x => $X3);
$FX4     = $Func->eval(x => $X4);
$n       = Compute("10*($X4 + $A)");
$d       = Compute("10*($X4 - $A)");
$FX4frac = Compute("$n/$d")->reduce;
$c1      = $A - $C;
$c2      = -$A - $C;
$FT      = Formula("(t^2 + $c1)/(t^2 + $c2)")->reduce;
#*******************
#   Display stuff
#*******************
Context()->flags->set(reduceConstants => 0);
$FX1disp = Formula("($X1 + $A)/($X1 - $A)");
$FX2disp = Formula("($X2 + $A)/($X2 - $A)");
$FX3disp = $FX3;
$FX4disp = Formula("($X4 + $A)/($X4 - $A)");
$FTdisp  = $Func->substitute(x => $Tfunc);
#******************************
#   Make a neatly lined list
#******************************

# $Qlist = new_aligned_list(ans_rule_len=>15, numbered=>0, tex_spacing=>"3pt");
# $Qlist->qa("f($X1)",    $FX1->cmp,
#            "f($X2)",    $FX2->cmp,
#            "f($X3)",    $FX3->cmp,
#            "f($X4)",    $FX4->cmp,
#            "f($Tfunc)", $FT->cmp);
# *********************
#   Problem Statement
# *********************

@opts = ("f($X1)", "f($X2)", "f(" . $X3->TeX . ")", "f($X4)", "f$Tfunc");
@ans  = ($FX1, $FX2, $FX3, $FX4, $FT);

# Strings in Tex form (formula)

BEGIN_PGML
Find [`f([$X1]), f([$X2]), f([$X3]), f([$X4]),`] [`f([$Tfunc]) `]
for [``f(x) = [$Func] ``]. If necessary, use *pi* to
represent [`\pi `].

a) [`[$opts[0]] = \;`] [_]{$ans[0]}

b) [`[$opts[1]] = \;`] [_]{$ans[1]}

c) [`[$opts[2]] = \;`] [_]{$ans[2]}

d) [`[$opts[3]] = \;`] [_]{$ans[3]}

e) [`[$opts[4]] = \;`] [_]{$ans[4]}

END_PGML

BEGIN_PGML_SOLUTION
To evaluate a function at a specific value of the input variable [`x`], replace all instances of
the variable [`x`] with the input value and evaluate the resulting expression.
  

a) [`` f([$X1]) =[$FX1disp] = [$FX1]``]
     
b) [`` f([$X2]) =[$FX2disp] = [$FX2]``]

c) [``f([$X3]) =[$FX3disp]``]

d) [``f([$X4]) =[$FX4disp] = [$FX4frac]``]

e) [``f([$Tfunc]) =[$FTdisp] = [$FT]``]

END_PGML_SOLUTION

ENDDOCUMENT();
