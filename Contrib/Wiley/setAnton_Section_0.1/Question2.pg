# ************************************
#   Comments + Keyword Clarification

#    Anton, Calculus, 0.1.2
# ************************************
# DESCRIPTION
# Evaluate function values using the given table of (x,y) values

# ENDDESCRIPTION
## DBsubject('Calculus')
## DBchapter('Before Calculus')
## DBsection('Functions')
## KEYWORDS('Functions', 'Polynomial')
## TitleText1('Calculus')
## EditionText1('9')
## AuthorText1('Anton')
## Section1('0.1')
## Problem1('2')
## Author('')
## Institution('John Wiley & Sons')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Numeric");

#*************************************
#   Create array of numeric strings
#      X values will be 8 consecutive values starting at a random negative value
#      The y values will be random, with the restrictions:
#         o Two will be the same
#         o No others will duplicate
#*************************************

$Xstart = random(-5, -2);
@x      = map { $Xstart + $_ } (0 .. 7);
do {
    @y    = map { random(-10, 10) } (1 .. 8);
    %seen = {};
    } until scalar(grep { !$seen{$_}++ } @y) ==
    8;    # ensures that there are no duplicates

# find min/max values
($ymin, $ymax) = (10, -10);
($xmin, $xmax) = ($x[0], $x[0]);
for my $k (0 .. 7) {
    ($ymax, $xmax) = ($y[$k], $x[$k]) if ($y[$k] > $ymax);
    ($ymin, $xmin) = ($y[$k], $x[$k]) if ($y[$k] < $ymin);
}

# make two the same, but not the max or min
do {
    @same = random_subset(2, 0 .. 7);    # select two to be equal.
} until ($y[ $same[0] ] != $ymin && $y[ $same[1] ] != $ymin)
    && ($y[ $same[0] ] != $ymax && $y[ $same[1] ] != $ymax);

$y[ $same[0] ] = $y[ $same[1] ];

# Pick all negative values.
for my $k (0 .. 7) {
    push(@xneg, $x[$k]) if $y[$k] <= 0;
}

# Pick  a non existent value of y:
do {
    $no_y  = random(-10, 10);
    @yvals = grep { $_ == $no_y } @y;
} until @yvals == 0;

$XvalspartA = List("$x[$same[0]],$x[$same[1]]");
$XvalpartB  = Compute("DNE");
$YvalpartC  = Compute("$y[4]");
$XvalpartD  = List(@xneg);
$YvalpartE  = Compute("$ymin");
$XvalpartE  = Compute("$xmin");
$YvalpartF  = Compute("$ymax");
$XvalpartF  = Compute("$xmax");

$tab = DataTable(
    [ [ '\(x\)', @x ], [ '\(y\)', @y ], ],
    horizontalrules => 1,
    align           => '|' . ('c|' x 9),
    padding         => 0.25
);

BEGIN_PGML
Use the table below to answer the following questions. If there is more than one answer to a question,
enter as a comma-separated list of values. Enter *DNE* if there is no answer.

[$tab]*

a) For what values of [`x`] is [`y = [$y[$same[0]]]`]? [_]{$XvalspartA}

b) For what values of [`x`] is [`y=[$no_y]`]? [_]{$XvalpartB}

c) For what values of [`y`] is [`x = [$x[4]]`]? [_]{$YvalpartC}

d) For what values of [`x`] is [`y \leq 0 `]? [_]{$XvalpartD}

e) What is the minimum value of [`y`]?  [_]{$YvalpartE}

        At what value of [`x`] does it occur? [_]{$XvalpartE}

f) What is the maximum value of [`y`]? [_]{$YvalpartF}

        At what value of [`x`] does it occur?,  [_]{$XvalpartF}

END_PGML

BEGIN_PGML_SOLUTION
Referring to the table:

a) [` y = [$y[$same[0]]]`] at [`x = [$XvalspartA]`].

b) There is no value for [`x`] where [`y=[$no_y]`].

c) When [` x = [$x[4]]`], [`y = [$y[4]]`].

d) [` y \le 0`] when [`x = [$XvalpartD] `].

e) The minimum value of [`y`] is [`[$ymin]`].
    This occurs at [` x = [$XvalpartE] `].

f) The maximum value of [`y`] is [`[$ymax]`].
    This occurs at [` x = [$XvalpartF] `].
END_PGML_SOLUTION

ENDDOCUMENT();
