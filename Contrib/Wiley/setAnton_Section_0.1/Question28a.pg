# ************************************
#   Comments + Keyword Clarification

#    Anton, Calculus, 0.1.28a
# ************************************
# DESCRIPTION
# Express the function f(x) = A + |2x - B| in piecewise form, removing the absolute values.

# ENDDESCRIPTION
## DBsubject('Calculus')
## DBchapter('Before Calculus')
## DBsection('Functions')
## KEYWORDS('Functions', 'Polynomial')
## TitleText1('Calculus')
## EditionText1('9')
## AuthorText1('Anton')
## Section1('0.1')
## Problem1('28a')
## Author('')
## Institution('John Wiley & Sons')

DOCUMENT();
loadMacros(
    'PGstandard.pl',               'PGML.pl',
    'contextPiecewiseFunction.pl', 'plots.pl',
    'contextFraction.pl',          'PGcourse.pl'
);

Context("Numeric");
Parser::Number::NoDecimals;
#***********************************
#  Create function $A + |2x - $B|
#***********************************
$A    = random(1, 4);
$B    = random(1, 7, 2);
$Func = Formula("$A + abs(2x - $B)");
Context("Fraction");
$Xvert = Compute("$B/2")->reduce;
$Xleft = Compute("$Xvert - 1")->reduce;
$Yleft = $Func->eval(x => $Xleft)->reduce;
$F1int = Compute("$A + $B")->reduce;
Context("Numeric");
$F1 = Formula("-2 x + $F1int")->reduce('(-x)+y' => 0);
Context("Fraction");
$Xright = Compute("$Xvert + 1")->reduce;
$Yright = $Func->eval(x => $Xright)->reduce;
$F2int  = Compute("$A - $B")->reduce;
Context("Numeric");
$F2 = Formula("2 x + $F2int")->reduce;

BEGIN_PGML
Express the function [`` f(x) = [$Func] ``] in piecewise form without using absolute values. _Suggestion_: It may help to generate the graph of the function.

[```f(x) = 
   \begin{cases}
    f_1 &x < a \\
    f_2 &x \ge a
   \end{cases}
```]

a) [` a=\;`] [_]{$XVert}

b) [`f_1 = \; `] [_]{$F1}

c) [`f_2 = \; `] [_]{$F2}

END_PGML

$plot = Plot(
    xmin            => -10,
    xmax            =>  10,
    xtick_delta     =>  2,
    xminor          =>  1,
    ymin            => -10,
    ymax            =>  10,
    ytick_delta     =>  5,
    yminor          =>  4,
    rounded_corners =>  1,
);
$plot->add_function(
    [ $F1, 'x', -10,    $B / 2, color => 'blue' ],
    [ $F2, 'x', $B / 2, 10,     color => 'blue' ],
);

$altText =
    "A graph of the function $Func. To the left of the point "
    . "($Xvert, $Yvert) it is a line with "
    . "slope -2.  To the right it is a line with slope 2.";

BEGIN_PGML_SOLUTION
Graph of [``f(x) = [$Func] ``]

>>[![$altText]!]{$plot}{300}<<

The minimum value of this function will occur when the expression inside the absolute value equals 0.
This occurs at [`x = [$Xvert] `], so there will be a "vertex" at the point
[`([$Xvert],[$Yvert]) `]. It is natural then to separate the function at [`x = [$Xvert] `].

For [`x < [$Xvert], |2x - [$B]| = -(2x - [$B]) `]. Therefore,
[```[$A] + |2x - [$B]| = [$A] - (2x - [$B]) = -2x + [$F1int] .```]
For [`x \ge [$Xvert], |2x - [$B]| = 2x - [$B] `]. Therefore,
[```[$A] + |2x - [$B]| = [$A] + 2x - [$B] = 2x + [$F2int] .```]

Therefore, the function can be rewritten in piecewise form as:
[```f(x) =
   \begin{cases}
    [$F1] &x < [$Xvert] \\
    [$F2] &x \ge [$Xvert]
   \end{cases}
```]

END_PGML_SOLUTION

ENDDOCUMENT();
