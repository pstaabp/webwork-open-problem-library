# ************************************
#   Comments + Keyword Clarification

#    Anton, Calculus, 0.1.3
# ************************************
# DESCRIPTION
# Given 4 graphs, determine whether each one represents y as a function of x.

# ENDDESCRIPTION
## DBsubject('Calculus')
## DBchapter('Before Calculus')
## DBsection('Functions')
## KEYWORDS('Functions', 'Vertical Line Test')
## TitleText1('Calculus')
## EditionText1('9')
## AuthorText1('Anton')
## Section1('0.1')
## Problem1('3')
## Author('')
## Institution('John Wiley & Sons')

DOCUMENT();
loadMacros(
    'PGstandard.pl',  'PGML.pl', 'plots.pl',
    'parserPopUp.pl', 'PGcourse.pl'
);

Context("Numeric");
#**************************************
#   Create 4 graphs:

#  (a) y = Ax^3
#  (b) y = Ae^(-x^2)
#     ("bell" curve)
#  (c) y = (+/-) ln(A/x), x > 0
#     (rotated "bell" curve)
#  (d) y = (+/-) C/B sqrt(B^2 - x^2)
#     (Ellipse)
#**************************************
$A          = non_zero_random(-4, 4);
$A0         = non_zero_random(-3, 3);
$B          = random(1, 4, 2);
$C          = random(1, 4, 2);

for my $k (0 .. 3) {$plot[$k] = Plot();}
$plot[0]->add_function("$A x^3", 'x', -5,  5, color => 'blue');
$plot[1]->add_function("$A0 e^(-x^2)", 'x', -5,  5, color => 'blue');
$plot[2]->add_function(["$A e^(-t^2)", 't'], 't', -5,5, color => 'blue');
$plot[3]->add_function(["$B cos(t)","$C sin(t)"], t, 0, 2*pi, color => 'blue');
@shuffle = random_subset(4,0..3);

@dd = map { DropDownTF( $_)} (1,1,0,0);

@altText = (
    'A plot of a cubic curve ',
    'A plot of a ' . ($A0 < 0 ? 'upside down' : '') . 'bell/normal curve.',
    'A plot of a sideways bell curve.',
    'A plot of an ellipse'
);

BEGIN_PGML
Determine if each graph defines [`y`] as a function of [`x`].


   [#
        [.*A* [_]{$dd[$shuffle[0]]} .]
           [. [![$altText[$shuffle[0]]]!]{$plot[$shuffle[0]]}{250} .]
        [.*B* [_]{$dd[$shuffle[1]]} .]
           [. [![$altText[$shuffle[1]]]!]{$plot[$shuffle[1]]}{250} .]*
        [.*C* [_]{$dd[$shuffle[2]]} .]
            [. [![$altText[$shuffle[2]]]!]{$plot[$shuffle[2]]}{250} .]
        [.*D* [_]{$dd[$shuffle[3]]} .]
       [. [![$altText[$shuffle[3]]]!]{$plot[$shuffle[3]]}{250} .]*
    #]{padding => 0.25}

END_PGML

@curve_cross = ('once', 'once', 'twice', 'twice');
@ans = ('is', 'is', 'is not', 'is not');

BEGIN_PGML_SOLUTION

If [` y `] is a function of [`x`], then for each [`x`] there exists
only _one_ [`y`] value. If given a graph, this is best determined by
using the _vertical line test_.

a) In this case any vertical line crosses the curve [$curve_cross[$shuffle[0]]], therefore [`y`] [$ans[$shuffle[0]]] a function of [`x`]. 

b) In this case any vertical line crosses the curve [$curve_cross[$shuffle[1]]], therefore [`y`] [$ans[$shuffle[1]]] a function of [`x`]. 

c) In this case any vertical line crosses the curve [$curve_cross[$shuffle[2]]], therefore [`y`] [$ans[$shuffle[2]]] a function of [`x`]. 

d) In this case any vertical line crosses the curve [$curve_cross[$shuffle[3]]], therefore [`y`] [$ans[$shuffle[3]]] a function of [`x`]. 


END_PGML_SOLUTION

ENDDOCUMENT();
