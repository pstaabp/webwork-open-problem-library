# ************************************
#   Comments + Keyword Clarification

#    Anton, Calculus, 0.1.28b
# ************************************
# DESCRIPTION
# Express the function f(x) = A|x - B| - |x + C| in piecewise form, removing the absolute values.

# ENDDESCRIPTION
## DBsubject('Calculus')
## DBchapter('Before Calculus')
## DBsection('Functions')
## KEYWORDS('Functions', 'Polynomial')
## TitleText1('Calculus')
## EditionText1('9')
## AuthorText1('Anton')
## Section1('0.1')
## Problem1('28b')
## Author('')
## Institution('John Wiley & Sons')
DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'plots.pl', 'PGcourse.pl');

Context("Numeric");
#******************************************
#  Create function $A|x - $B| - |x + $C|
#******************************************
$A    = random(2, 5);
$B    = random(1, 4);
$C    = random(1, 4);
$Func = Formula("$A abs(x - $B) - abs(x + $C)");
#*****************************
#   Where the graph "bends"
#*****************************
$Xvert1 = Compute("-$C");
$Yvert1 = $Func->eval(x => -$C);
$Xvert2 = Compute("$B");
$Yvert2 = $Func->eval(x => $B);
#*************************************************
#   Create graph ranges based upon these values
#*************************************************
$Xmingr   = $Xvert1 - 5;
$Xmaxgr   = $Xvert2 + 5;
$Xgrids   = $Xmaxgr - $Xmingr;
$Ymingr   = $Yvert2 - 5;
$Ymaxgr   = $Yvert1 + 5;
$Ygrids   = $Ymaxgr - $Ymingr;
$Funcstr  = "$A abs(x - $B) - abs(x + $C)";
$Vert1str = "($Xvert1,$Yvert1)";
$Vert2str = "($Xvert2,$Yvert2)";

#  Make sure lines display as mx + b
Context()->reduction->set('(-x)-y' => 0, '(-x)+y' => 0);
#****************************************************************
#   Leftmost line (use "vertex" point and point 1 unit to left)
#****************************************************************
$Xleft = Compute("$Xvert1 - 1");
$Yleft = $Func->eval(x => $Xleft);
$M1    = Compute("($Yleft - $Yvert1)/($Xleft - $Xvert1)");
$F1int = Compute("$Yvert1 - $M1*$Xvert1");
$F1    = Compute("$M1 x + $F1int")->reduce;
#****************************************************
#   Center line (use first and 2nd "vertex" points)
#****************************************************
$M2    = Compute("($Yvert1 - $Yvert2)/($Xvert1 - $Xvert2)");
$F2int = Compute("$Yvert2 - $M2*$Xvert2");
$F2    = Compute("$M2 x + $F2int")->reduce;
#******************************************************************
#   Rightmost line (use "vertex" point and point 1 unit to right)
#******************************************************************
$Xright = Compute("$Xvert2 + 1");
$Yright = $Func->eval(x => $Xright);
$M3     = Compute("($Yright - $Yvert2)/($Xright - $Xvert2)");
$F3int  = Compute("$Yvert2 - $M3*$Xvert2");
$F3     = Compute("$M3 x + $F3int")->reduce;

@opts = ("a", "b", "f_1", "f_2", "f_3");
@ans  = ($Xvert1, $Xvert2, $F1, $F2, $F3);

# *********************
#   Problem Statement
# *********************

# Strings in Tex form (formula)

BEGIN_PGML
Express the function [` f(x) = [$Func] `] in piecewise form without using absolute values.  _Suggestion_: It may help to generate the graph of the function.

[``` f(x) =
   \begin{cases}
     f_1 & x \le a   \\
     f_2 & a < x < b \\
     f_3 & x \ge b
  \end{cases}
```]

a) [`[$opts[0]] = \;`] [_]{$ans[0]}

b) [`[$opts[1]] = \;`] [_]{$ans[1]}

c) [`[$opts[2]] = \;`] [_]{$ans[2]}

d) [`[$opts[3]] = \;`] [_]{$ans[3]}

e) [`[$opts[4]] = \;`] [_]{$ans[4]}

END_PGML

$plot = Plot(
    xmin            => $Xvert1 - 5,
    xmax            => $Xvert2 + 5,
    xtick_delta     => 5,
    xminor          => 4,
    ymin            => $Yvert2 - 5,
    ymax            => $Yvert1 + 5,
    ytick_delta     => 5,
    yminor          => 4,
    rounded_corners => 1,
);
$plot->add_function(
    [ $F1, 'x', $Xvert1 - 5, $Xvert1,     color => 'blue' ],
    [ $F2, 'x', $Xvert1,     $Xvert2,     color => 'blue' ],
    [ $F3, 'x', $Xvert2,     $Xvert2 + 5, color => 'blue' ]
);

$altText = "A graph of the function $Func. To the left of the point "
    . "($Xvert1, " . $F1->eval(x=>$Xvert1) . ") it is a line with "
    . "slope $M1.  It is then a line to the point ($Xvert2, " 
    . $F2->eval(x=>$Xvert2) . "). Then to the right it is a line with slope $M3.";
BEGIN_PGML_SOLUTION
The graph of [`f(x) = [$Func] `] is

>>[![$altText]!]{$plot}{300}<<

The function [`[$Func] `] will have "turning points" at the places where either of the expressions
inside the absolute value equals 0. This occurs at [`x = [$Xvert1] `] and
[`x = [$Xvert2] `]. To express this function in piecewise form, we will separate 
it into three parts and use these two points as the boundaries.

For [`x \le [$Xvert1], |x + [$C]| = -(x + [$C])`] and [`|x - [$B]| = -(x - [$B]) `]. Therefore,
[```[$Func] = -[$A](x - [$B]) + (x + [$C]) = [$F1].```]

For [`[$Xvert1] < x < [$Xvert2], |x + [$C]| = x + [$C]`] and [`|x - [$B]| = -(x - [$B])`]. Therefore,
[```[$Func] = -[$A](x - [$B]) - (x + [$C]) = [$F2] .```]

For [`x \ge [$Xvert2], |x + [$C]| = x + [$C] `] and [`|x - [$B]| = x - [$B] `]. Therefore,
[```[$Func] = [$A](x - [$B]) - (x + [$C]) = [$F3].```]

Therefore, the function can be rewritten in piecewise form as:
[```f(x) =
  \begin{cases}
     [$F1] & x \le [$Xvert1] \\
     [$F2] & [$Xvert1] < x < [$Xvert2] \\
     [$F3] & x \ge [$Xvert2]
  \end{cases}
```]

END_PGML_SOLUTION

ENDDOCUMENT();
