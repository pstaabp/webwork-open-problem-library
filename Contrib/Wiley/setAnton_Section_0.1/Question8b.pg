# ************************************
#   Comments + Keyword Clarification

#    Anton, Calculus, 0.1.8b
# ************************************
# DESCRIPTION
# Evaluate function values at specific values of x for piecewise continuous
#    f(x) = sqrt(x + A) , x >= Val
#           B,            x <  Val

# ENDDESCRIPTION
## DBsubject('Calculus')
## DBchapter('Before Calculus')
## DBsection('Functions')
## KEYWORDS('Functions', 'Piecewise', 'Domain')
## TitleText1('Calculus')
## EditionText1('9')
## AuthorText1('Anton')
## Section1('0.1')
## Problem1('8b')
## Author('')
## Institution('John Wiley & Sons')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'contextPiecewiseFunction.pl', 'PGcourse.pl');

Context("Numeric");
#********************************
#  Create piecewise function.
#    f1 = sqrt(x + A),  f2 = B
#********************************
$A = random(1,9);
$B = non_zero_random(-9,9);
$F1 = Formula("sqrt(x + $A)");
$F2 = Formula("$B");
$Xbound = $A;
$X1 = random($A+1,9);
$X2 = -$A;
$X3 = Formula("pi")->reduce;
$X4 = -$A - 0.1;
#**************
#   Answers
#**************

#********************************
#   1st x value > Boundary val
#********************************
Context()->flags->set(reduceConstants=>0);
$FX1 = $F1->eval(x=>$X1);
$FX1disp = $F1->substitute(x=>$X1);
$num = Compute("$X1 + $A");
$FX1simp = sqrt($X1+$A) == int(sqrt($X1+$A)) ? sqrt($X1+$A) : "\sqrt{" . ($X1+$A) . "}";
#********************************
#   2nd x value < Boundary val
#********************************
$FX2 = Compute("$B");
$FX2disp = $FX2;
#*********************************************
#   3rd x value (pi) may be >< Boundary val
#*********************************************
if ($X3 >= $Xbound)
{
  $INEQ = "> $Xbound";
  $UL = "upper";
  $FX3 = $F1->substitute(x=>$X3);
}
else
{
  $INEQ = "< $Xbound";
  $UL = "lower";
  $FX3 = Compute("$B");
}
$FX3disp = $FX3;
#********************************
#   4th x value < Boundary val
#********************************
$FX4 = Compute("$B");
$FX4disp = $FX4;


#***********************************************************
#   Create a piecewise function using the functions above
#***********************************************************\
Context("PiecewiseFunction");
$Fpiece = Formula("$F1 if x > $Xbound else $F2 if x <= $Xbound");
Context("Numeric");

BEGIN_PGML
Find [`f([$X1]), f([$X2]), f([$X3]),`]  and [`f([$X4]) `] for :

[```f(x) = [$Fpiece] ```]

You may keep radicals in any answers where appropriate. Use *pi* to
represent [`\pi `].

a) [` f([$X1]) = `] [_]{$FX1}

b) [` f([$X2]) = `] [_]{$FX2}

c) [` f([$X3]) = `] [_]{$FX3}

d) [` f([$X4]) = `] [_]{$FX4}

END_PGML

BEGIN_PGML_SOLUTION
To evaluate a function at a specific value of the input variable [`x`], replace all instances of
the variable [`x`] with the input value and evaluate the resulting expression.
In the case of a piecewise function such as this one, you must first determine which "branch"
of the function to use, based upon the definition of the function and the input value of [`x`].
  
For [`f([$X1]), [$X1] > [$Xbound]`] and so the upper portion of the definition is used. Therefore,
[```f([$X1]) = [$FX1disp] = [$FX1simp]. ```]
For [`f([$X2]), [$X2] < [$Xbound] `] and so the lower portion of the definition is used. Therefore,
[```f([$X2]) = [$FX2disp]. ```]
For [`f([$X3]), [$X3] [$INEQ] `] and so the [$UL] portion of the definition is used. Therefore,
[```f([$X3]) = [$FX3disp]. ```]
For [`f([$X4]), [$X4] < [$Xbound] `] and so the lower portion of the definition is used. Therefore,
[```f([$X4]) = [$FX4disp]. ```]
END_PGML_SOLUTION

ENDDOCUMENT();