# ************************************
#   Comments + Keyword Clarification

#    Anton, Calculus, 0.1.7a
# ************************************
# DESCRIPTION
# Evaluate function values at specific values of x for f(x) = Ax^2 - B
# ENDDESCRIPTION
## DBsubject('Calculus')
## DBchapter('Before Calculus')
## DBsection('Functions')
## KEYWORDS('Functions', 'Polynomial')
## TitleText1('Calculus')
## EditionText1('9')
## AuthorText1('Anton')
## Section1('0.1')
## Problem1('7a')
## Author('')
## Institution('John Wiley & Sons')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context("Numeric");
#****************************************************
#  Create function of form Ax^2 - B
#****************************************************
$A     = random(2, 9);
$B     = random(1, 10);
$Func  = Compute("$A x^2 - $B");
$X1    = random(2, 3);
$X2    = $X1 + 1;
$SQRTX = Compute("sqrt(x)");
#*********************************************
#   Make sure that sqrt(2) is not evaluated
#*********************************************
Context()->flags->set(reduceConstantFunctions => 0);
$SQRTX1 = $SQRTX->substitute(x => "$X1");
#**********************
#   Add "t" variable
#**********************
Context()->variables->add(t => "Real");
$C     = random(2, 6, 1);
$Tfunc = Compute("$C t");
#**************
#   Answers
#**************
$F0      = Compute("-$B");
$FX1     = $Func->eval(x => $X1);
$FNEGX1  = $Func->eval(x => -$X1);
$FX2     = $Func->eval(x => $X2);
$FSQRTX1 = $Func->eval(x => "$SQRTX1");
$D       = Compute("$A * $C^2");
$FT      = Compute("$D t^2 - $B")->reduce;
#******************************
#   Make a neatly lined list
#******************************
# $Qlist =
#     new_aligned_list(ans_rule_len => 15, numbered => 0, tex_spacing => "3pt");
# $Qlist->qa(
#     "\( f(0)} \)",           $F0->cmp,
#     "\( f($X1)} \)",         $FX1->cmp,
#     "\( f(-$X1)} \)",        $FNEGX1->cmp,
#     "\( f($X2)} \)",         $FX2->cmp,
#     "\( f(\sqrt{$X1})} \)", $FSQRTX1->cmp,
#     "\( f($C t)} \)",        $FT->cmp
# );
#*****************************************************************************
#   Prevent the student from entering $A (Val)^2 - B and having WW evaluate
#*****************************************************************************
Context()->parens->remove("(");
# *********************
#   Problem Statement
# *********************

@opts = (
    "\( f(0) =\; \)",
    "\( f($X1)=\; \)",
    "\( f(-$X1)=\; \)",
    "\( f($X2)=\; \)",
    "\( f(\sqrt{$X1})=\; \)",
    "\( f($C t)=\; \)"
);
@ans = ($F0, $FX1, $FNEGX1, $FX2, $FSQRTX1, $FT);

# Strings in Tex form (formula)

BEGIN_PGML
Find [` f(0), f([$X1]), f(-[$X1]), f([$X2]), f([$SQRTX1]), `]
and [` f([$Tfunc]) `] for [` f(x) = [$Func] `]. If appropriate, leave answers in radical form.

a) [$opts[0]]* [_]{$ans[0]}

b) [$opts[1]]* [_]{$ans[1]}

c) [$opts[2]]* [_]{$ans[2]}

d) [$opts[3]]* [_]{$ans[3]}

e) [$opts[4]]* [_]{$ans[4]}

f) [$opts[5]]* [_]{$ans[5]}
END_PGML

BEGIN_PGML_SOLUTION
To evaluate a function at a specific value of the input variable [` x `], replace all instances of the variable [`x`] with the input value and evaluate the resulting expression.
  
a) [`` f(0) = [$A] (0)^2 - [$B] = -[$B] ``]

b) [`` f([$X1]) = [$A] ([$X1])^2 - [$B] = [$FX1] ``]

c) [`` f(-[$X1]) = [$A] (-[$X1])^2 - [$B] = [$FNEGX1] ``]

d) [`` f([$X2])  = [$A] ([$X2])^2 - [$B] = [$FX2] ``]

e) [`` f([$SQRTX1]) = [$A] ([$SQRTX1])^2 - [$B] = [$FSQRTX1] ``]

f) [`` f([$Tfunc]) = [$A] ([$Tfunc])^2 - [$B] = [$FT] ``]
END_PGML_SOLUTION

ENDDOCUMENT();
