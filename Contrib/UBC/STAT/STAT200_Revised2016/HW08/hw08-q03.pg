##DESCRIPTION
## A propotional hypothesis test determining the proportion of high school graduates.
##ENDDESCRIPTION
## DBsubject('Statistics')
## DBchapter('Hypothesis tests')
## DBsection('One sample proportion')
## Level(3)
## KEYWORDS('sample proportion', 'hypothesis tests', 'type I error', 'type II error')

##Attempts: Four.
##Tagged by Nelson Chen. Jul 7, 2016.

DOCUMENT();

loadMacros(
    'PGstandard.pl',         'PGML.pl',
    'parserRadioButtons.pl', 'parserCheckboxList.pl',
    'PGcourse.pl'
);

$rb1 = RadioButtons(
    [ [
        "The proportion of all British Columbians (aged above 25) who are high "
            . "school graduates.",
        "All British Columbians aged above 25.",
        "Whether a British Columbian is a high school graduate.",
