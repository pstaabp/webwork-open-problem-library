# DESCRIPTION
# A problem that asks students to determine the population, variable,
# data, sample, statistic and parameter from a situation.

# This problem is derived from a homework problem in Introductory Statistics,
# licensed by OpenStax under a Creative Commons Attribution License (CC BY 4.0).
# Modified for WeBWorK by Michael Stassen   mstassen(at)fitchburgstate(dot)edu
# ENDDESCRIPTION

## DBsubject(Statistics)
## DBchapter(Experimental design)
## DBsection(Concepts)
## Keywords('population', 'variable', 'sample', 'parameter','statistic')
## Institution(Fitchburg State University)
## Author(Michael Stassen)

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'parserMatchList.pl', 'PGcourse.pl');

$ml = MatchList(
    [
        [ 'Population', 'All clients of the fitness center' ],
        [
            'Variable',
            'Amount of time a client exercises in the center in a week'
        ],
        [ 'Sample', 'The 50 randomly selected clients' ],
        [
            'Parameter',
            'The mean amount of time a client exercises in the center per week'
        ],
        [ 'Data', 'The 50 recorded amounts of time' ],
        [
            'Statistic',
            'The mean amount of time the 50 selected clients exercise in the center per week'
        ],
    ],
    extra => [ "People who exercise", "All clients of fitness centers" ],
    last  => ['None of the Above']
);

$showPartialCorrectAnswers = 0;

BEGIN_PGML
A fitness center is interested in the mean amount of time a client exercises in
the center per week. They randomly select 50 clients and record their time spent exercising for a week. Match each term with the corresponding part of the study.

[_]*{$ml}

END_PGML

$explanations = {
    Population => "the population is the complete group of interest",
    Variable   =>
        "each member of the population or sample has a value of the variable",
    Sample    => "the sample is the selected subset of the population",
    Parameter => "a parameter is a descriptive measure of the population",
    Data      => "the data is the set of recorded values of the variable",
    Statistic => "a statistic is a descriptive measure of the sample data"
};

$questions = $ml->questions;
$answers   = $ml->choices;

BEGIN_PGML_SOLUTION
1. For [$questions->[0]], the answer is *[$answers->[0]]****, because [$explanations->{$questions->[0]}].
2. For [$questions->[1]], the answer is *[$answers->[1]]****, because [$explanations->{$questions->[1]}].
3. For [$questions->[2]], the answer is *[$answers->[2]]****, because [$explanations->{$questions->[2]}].
4. For [$questions->[3]], the answer is *[$answers->[3]]****, because [$explanations->{$questions->[3]}].
5. For [$questions->[4]], the answer is *[$answers->[4]]****, because [$explanations->{$questions->[4]}].
6. For [$questions->[5]], the answer is *[$answers->[5]]****, because [$explanations->{$questions->[5]}].

END_PGML_SOLUTION

COMMENT('This problem is derived from an OpenStax problem');

ENDDOCUMENT();
