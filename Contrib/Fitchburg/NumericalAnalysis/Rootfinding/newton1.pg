##DESCRIPTION
##  Use Newton's method to find a root.
##ENDDESCRIPTION

##KEYWORDS("Newton's method", 'root')

## DBsubject('Numerical Analysis')
## DBchapter('Rootfinding')
## DBsection("Newton's Method")
## Date('2/3/2018')
## Author('Peter Staab')
## Institution('Fitchburg State University')

DOCUMENT();

loadMacros(
    'PGstandard.pl',        'PGML.pl',
    'PGnumericalmacros.pl', 'niceTables.pl',
    'PGcourse.pl'
);

$a1 = random(2, 4);
$a2 = random(2, 4);
$k1 = 0.1 * random(1, 9);
$k2 = 0.1 * random(1, 9);

$x0 = 0.5 * random(0, 10);

$f  = Compute("$a1*cos($k1*x)+$a2*sin($k2*x)");
$df = $f->D('x');

$newton = newton($f, $x0, eps => 1e-12);
@x      = @{ $newton->{iterations} };

$rows =
    [ [ '\(n\)', '\(x_n\)' ] ];
push(@$rows, [ "\($_\)", PGML::Format("[_]{$x[$_]}") ]) for (0 .. 4);
$tab = LayoutTable(
    $rows,
    align      => '|c|c|',
    padding => [0.5, 0.5],
    horizontalrules => 1
);

BEGIN_PGML

Perform Newton's Method to find a root of

[`` f(x) =  [$a1] \cos([$k1]x)+[$a2]\sin([$k2]x)``]

For the first 4 iterations.  Start with [`x_0=[$x[0]]`].

[@ $tab @]*

END_PGML


############################
#  Solution

# create f(x_n) and f'(x_n)

$x0 = $x[0];

$fexp = $f->TeX;
$fexp =~ s/x/x_n/g;
$f0 = $f->TeX;
$f0 =~ s/x/($x0)/g;

$dfexp = $df->TeX;
$dfexp =~ s/x/x_n/g;
$df0 = $df->TeX;
$df0 =~ s/x/($x0)/g;

$rows2 =
    [ [ '\(n\)', '\(x_n\)' ] ];
push(@$rows2, [ "\($_\)", "\($x[$_]\)" ]) for (0 .. 4);

BEGIN_PGML_SOLUTION

For this, we use the standard Newton's Method formula:

[`` x_{n+1} = x_n - \frac{f(x_n)}{f'(x_n)} = x_n - \frac{[$fexp]}{[$dfexp]}``]

For example,

[`` x_1 = [$x[0]]- \frac{[$f0]}{[$df0]}=[$x[1]] ``]

Continuing,  you get the following:

[@ LayoutTable(
	$rows2,
	align      => '|c|c|',
    padding => [0.5, 0.5],
    horizontalrules => 1
);
 @]*

END_PGML_SOLUTION

ENDDOCUMENT();
