##DESCRIPTION
##  Numerically Differentiating functions
##ENDDESCRIPTION

##KEYWORDS('numerical differentiation')

## DBsubject('Numerical Analysis')
## DBchapter('Integration and Differentiation')
## DBsection('Numerical Differentiation')
## Date('2/3/2018')
## Author('Peter Staab')
## Institution('Fitchburg State University')

# updated 2023.03.08
DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

$choice = random(1, 5);

$h = 1 / (2**random(1, 3));

if ($choice == 1) {
    $k  = 0.25 * non_zero_random(-8, 8);
    $f  = Compute("exp($k*x)");
    $x0 = 0;
} elsif ($choice == 2) {
    $k  = non_zero_random(-3, 3);
    $f  = Compute("sin($k*x)");
    $p  = random(1, 4);
    $x0 = Compute("$p*pi/4");
} elsif ($choice == 3) {
    $k  = non_zero_random(-3, 3);
    $f  = Compute("cos($k*x)");
    $p  = random(1, 4);
    $x0 = Compute("$p*pi/4");
} elsif ($choice == 4) {
    $k  = non_zero_random(-3, 3);
    $f  = Compute("tan($k*x)");
    $x0 = 0;
} elsif ($choice == 5) {
    $k  = non_zero_random(1, 3);
    $f  = Compute("asin($k*x)");
    $x0 = 0;
}

$for2  = ($f->eval(x => $x0 + $h) - $f->eval(x => $x0)) / $h;
$back2 = ($f->eval(x => $x0) - $f->eval(x => $x0 - $h)) / $h;

$for3 =
    (-3 * $f->eval(x => $x0) +
        4 * $f->eval(x => $x0 + $h) -
        $f->eval(x => $x0 + 2 * $h)) /
    (2 * $h);
$back3 =
    (3 * $f->eval(x => $x0) -
        4 * $f->eval(x => $x0 - $h) +
        $f->eval(x => $x0 - 2 * $h)) /
    (2 * $h);
$center3 = ($f->eval(x => $x0 + $h) - $f->eval(x => $x0 - $h)) / (2 * $h);

$fpp =
    ($f->eval(x => $x0 + $h) - 2 * $f->eval(x => $x0) + $f->eval(x => $x0 - $h))
    / ($h * $h);

BEGIN_PGML

Let

[`` f(x) = [$f->TeX] ``]

and [` h=[$h]`] and [` x_0=[$x0]`].  Use the appropriate difference formula to find the stated.

* 2-point forward difference for [`f'(x_0)`]: [__________________]{$for2}
* 2-point backward difference for [`f'(x_0)`]: [__________________]{$back2}
* 3-point forward difference for [`f'(x_0)`]: [__________________]{$for3}
* 3-point backward difference for [`f'(x_0)`]: [__________________]{$back3}
* 3-point center difference for [`f'(x_0)`]: [__________________]{$center3}
* 3-point center difference for [`f''(x_0)`]: [__________________]{$fpp}

END_PGML

BEGIN_PGML_SOLUTION

This is just using the correct difference formulas:

* 2-point forward difference for [`f'(x_0)`]:

[`` f'(x_0) \approx \frac{f(x_0+h)-f(x_0)}{h} = [$for2] ``]

* 2-point backward difference for [`f'(x_0)`]:

[`` f'(x_0) \approx \frac{f(x_0)-f(x_0-h)}{h} = [$back2] ``]

* 3-point forward difference for [`f'(x_0)`]:

[`` f'(x_0) \approx \frac{-f(x_0+2h)+4f(x_0+h)-3f(x_0)}{2h} = [$for3] ``]

* 3-point backward difference for [`f'(x_0)`]:

[`` f'(x_0) \approx \frac{-3f(x_0)+4f(x_0-h)-f(x_0-2h)}{2h} = [$back3] ``]

* 3-point center difference for [`f'(x_0)`]:

[`` f'(x_0) \approx \frac{f(x_0+h)-f(x_0-h)}{2h} = [$center3] ``]

* 3-point center difference for [`f''(x_0)`]:

[`` f''(x_0) \approx \frac{f(x_0+h)-2f(x_0)+f(x_0-h)}{h^2} = [$fpp] ``]

END_PGML_SOLUTION

ENDDOCUMENT();
