##DESCRIPTION
##  Numerically Differentiating functions
##ENDDESCRIPTION

##KEYWORDS('numerical differentiation')

## DBsubject('Numerical Analysis')
## DBchapter('Integration and Differentiation')
## DBsection('Composite Newton-Cotes Formulas')
## Date('2/3/2018')
## Author('Peter Staab')
## Institution('Fitchburg State University')

DOCUMENT();

loadMacros('PGstandard.pl',  'PGML.pl', 'niceTables.pl', 'PGcourse.pl');


sub S {
    my $n   = shift;
    my $sum = 0.0;
    for (my $j = 0; $j <= $n; $j++) {
        $sum += (-1)**($j) / (2 * $j + 1);
    }
    return 4 * $sum;
}

@A = ();

for ($j = 0; $j < 5; $j++) {
    $A[$j][0] = S(2**($j + 1));
}

for ($i = 1; $i < 5; $i++) {
    for ($j = $i; $j < 5; $j++) {
        $A[$j][$i] = 2**($i) / (2**($i) - 1) * $A[$j][ $i - 1 ] -
            1 / (2**($i) - 1) * $A[ $j - 1 ][ $i - 1 ];
    }
}

$relerror = Compute("abs(($A[4][4]-pi)/pi)");
$revalue  = $relerror->eval(x => 0);


BEGIN_PGML

It can be shown that

>>[`` S(k) = 4 \sum_{j=0}^k \frac{(-1)^j}{2j+1}``] <<

converges to [`\pi`], but very slowly.  In fact if we define [`h=1/k`], then this
method converges with order [`O(h)`].  In this problem we accelerate this using
Richardson extrapolation.

Create a 5 by 5 richardson extrapolation table.  The first column [`j=1`] should
be [`A_1(h) = S(2^n)`] and the remaining columns should be calculated using:

[`` A_n(h) = \frac{2^{j-1}}{2^{j-1}-1} A_{n-1}(h/2) - \frac{1}{2^{j-1}-1} A_{n-1}(h) ``]

[@
  DataTable([
    ['\(n\)','\(j=1\)','\(j=2\)','\(j=3\)','\(j=4\)','\(j=5\)'],
    ['1',ans_rule(4),'','','',''],
    ['2',ans_rule(4),ans_rule(4),'','',''],
    ['3',ans_rule(4),ans_rule(4),ans_rule(4),'',''],
    ['4',ans_rule(4),ans_rule(4),ans_rule(4),ans_rule(4),''],
    ['5',ans_rule(4),ans_rule(4),ans_rule(4),ans_rule(4),ans_rule(4)],
  ],
  padding => [0.5, 0.5],
  align => '|c|c|c|c|c|c|', horizontalrules => 1);
@]*

Using the estimate in the lower right corner, find the relative error:
[@ ans_rule(15)@]*

END_PGML

for ($j = 0; $j < 5; $j++) {
    for ($i = 0; $i <= $j; $i++) {
        ANS(Compute($A[$j][$i])->cmp);
    }
}
ANS($relerror->cmp);

BEGIN_PGML_SOLUTION

[@
DataTable([
    ['\(n\)','\(j=1\)','\(j=2\)','\(j=3\)','\(j=4\)','\(j=5\)'],
    ['1',$A[0][0],'','','',''],
    ['2',$A[1][0],$A[1][1],'','',''],
    ['3',$A[2][0],$A[2][1],$A[2][2],'',''],
    ['4',$A[3][0],$A[3][1],$A[3][2],$A[3][3],''],
    ['5',$A[4][0],$A[4][1],$A[4][2],$A[4][3],$A[4][4]],
  ],
  allcellcss => 'padding: 3px',
  align => '|c|c|c|c|c|c|', horizontalrules => 1);
@]*

The relative error is

[`` \left|\frac{[$A[4][4]]-\pi}{\pi}\right| = [$revalue] ``]

END_PGML_SOLUTION

ENDDOCUMENT();
