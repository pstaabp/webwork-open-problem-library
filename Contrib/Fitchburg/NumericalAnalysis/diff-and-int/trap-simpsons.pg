##DESCRIPTION
##  Numerically Differentiating functions
##ENDDESCRIPTION

##KEYWORDS('numerical differentiation')

## DBsubject('Numerical Analysis')
## DBchapter('Integration and Differentiation')
## DBsection('Newton-Cotes Formulas')
## Date('2/3/2018')
## Author('Peter Staab')
## Institution('Fitchburg State University')

# updated 2023.03.08
DOCUMENT();

loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGML.pl');

TEXT(beginproblem());
Context("Numeric");

$choice = random(1, 5);
if ($choice == 1) {
    $k = -0.25 * non_zero_random(1, 8);
    $f = Compute("exp($k*x^2)");
    $a = random(-3, 3);
    $b = $a + random(1, 2);
} elsif ($choice == 2) {
    $k = random(1, 5);
    $f = Compute("sin(x*pi/$k)/x");
    $a = 0.25 * random(1, 4);
    $b = $a + 0.25 * random(1, 6);
} elsif ($choice == 3) {
    $k = random(1, 5);
    $f = Compute("cos(x*pi/$k)/x");
    $a = random(1, 4);
    $b = $a + random(1, 2);
} elsif ($choice == 4) {
    $a = random(-5, -2);
    $b = $a + random(2, 5);
    $f = Compute("1/(1+x^2)");
} elsif ($choice == 5) {
    $a = random(-5, -2);
    $b = $a + random(2, 5);
    $f = Compute("x/(1+x^6)");
}

$trap = 0.5 * ($b - $a) * ($f->eval(x => $a) + $f->eval(x => $b));

$h = ($b - $a) / 2;

$simp = $h / 3 *
    ($f->eval(x => $a) + 4 * $f->eval(x => $a + $h) + $f->eval(x => $b));

$h = ($b - $a) / 3;

$three8 =
    3 * $h / 8 *
    ($f->eval(x => $a) +
        3 * $f->eval(x => $a + $h) +
        3 * $f->eval(x => $a + 2 * $h) +
        $f->eval(x => $b));

$h = ($b - $a) / 4;

$boole =
    $h / 45 *
    (14 * $f->eval(x => $a) +
        64 * $f->eval(x => $a + $h) +
        24 * $f->eval(x => $a + 2 * $h) +
        64 * $f->eval(x => $a + 3 * $h) +
        14 * $f->eval(x => $b));

BEGIN_PGML

Evaluate

[`` \int_{[$a]}^{[$b]} [$f->TeX] \, dx ``]

Using either the Trapezoid Rule or Simpson's rule:

* trapezoid approximation: [__________________]{$trap}
* simpson's rule approximation: [__________________]{$simp}
* 3/8 rule approximation: [__________________]{$three8}
* Boole's rule approximation: [__________________]{$boole}

Note: neither of these use the composite rule.

END_PGML

############################
#  Solution

BEGIN_PGML_SOLUTION

* Trapezoid Rule

Since [`h=b-a`], then [`h=[@ $b-$a@] `] and

[`` I_1(f) = \frac{h}{2} \left( f(a) + f(b) \right) = [$trap] ``]

* Simpson's Rule

Since [`h=\frac{b-a}{2}`], then [`h=[@ ($b-$a)/2@] `] and

[`` I_2(f) = \frac{h}{2} \left( f(a) + 4f(a+h)+ f(b) \right) = [$simp] ``]

* 3/8 Rule

Since [`h=\frac{b-a}{3}`], then [`h=[@ ($b-$a)/3@] `] and

[`` I_3(f) = \frac{3h}{8} \left( f(a) + 3f(a+h)+ 3f(a+2h)+ f(b) \right) = [$three8] ``]

* Boole's Rule

Since [`h=\frac{b-a}{4}`], then [`h=[@ ($b-$a)/4@] `] and

[`` I_3(f) = \frac{h}{45} \left( 14f(a) +64f(a+h)+ 24f(a+2h)+ 64 f(a+3h)+14 f(b) \right) = [$boole] ``]

END_PGML_SOLUTION

ENDDOCUMENT();
