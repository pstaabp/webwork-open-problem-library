##DESCRIPTION
##
##ENDDESCRIPTION

##KEYWORDS('algebra', 'inequality', 'fraction')

## DBsubject('Numerical Analysis')
## DBchapter('Interpolation')
## DBsection('Newton Divided Difference')
## Date('3/3/2018')
## Author('Peter Staab')
## Institution('Fitchburg State University')

DOCUMENT();

loadMacros(
    'PGstandard.pl',        'PGML.pl',
    'PGnumericalmacros.pl', 'niceTables.pl',
    'PGcourse.pl'
);

# For this problem with round off, often 0 is about 1 x 10^{-16}, so we need to check absolute error.
Context()->flags->set(
    tolerance => 0.0001,
    tolType   => 'absolute',
);

$which = random(1, 3);
if ($which == 1) {
    $k = random(2, 3);
    $f = Compute("sin($k*x)")->reduce;
    ($a, $b) = (0, Compute("2*pi"));
} elsif ($which == 2) {
    $k = random(0.5, 2, 0.5);
    $f = Compute("x*exp(-$k*x)")->reduce;
    ($a, $b) = (random(0, 2), random(3, 5));
} elsif ($which == 3) {
    $k = random(1, 3);
    $f = Compute("$k*sqrt(x)")->reduce;
    ($a, $b) = (random(0, 2), random(3, 5));
}

@x = map { $a + $_ * ($b - $a) / 4 } (0 .. 4);
@y = map { $f->eval(x => $_)->value } @x;

$c = newtonDividedDifference(~~@x, ~~@y);

$tab = DataTable(
    [
        [ '\(x_n\)', '\(y_n\)',        '',                 '', '', '' ],
        [ $x[0],       PGML('[_]{$y[0]}'), '',                 '', '', '' ],
        [ '',          '',            PGML('[_]{$c->[1][0]}'), '', '', '' ],
        [ $x[1], PGML('[__]{$y[1]}'), '', PGML('[_]{$c->[2][0]}'), '', '' ],
        [
            '', '', PGML('[_]{$c->[1][1]}'), '',
            PGML('[_]{$c->[3][0]}'), ''
        ],
        [
            $x[2], PGML('[_]{$y[2]}'),
            '',    PGML('[_]{$c->[2][1]}'),
            '',    PGML('[_]{$c->[4][0]}')
        ],
        [
            '', '', PGML('[_]{$c->[1][2]}'), '',
            PGML('[_]{$c->[3][1]}'), ''
        ],
        [ $x[3], PGML('[_]{$y[3]}'), '', PGML('[_]{$c->[2][2]}'), '', '' ],
        [ '',    '',                 PGML('[_]{$c->[1][3]}'), '', '', '' ],
        [ $x[4], PGML('[_]{$y[4]}'), '',                      '', '', '' ]
    ],
    texalignment    => '|c|c|c|c|c|c|',
    horizontalrules => 1,
    padding         => [ 0.25, 0.25 ]
);

$poly =
    Compute("$c->[0][0]+"
        . "$c->[1][0]*(x-$x[0])+ "
        . "$c->[2][0]*(x-$x[0])*(x-$x[1])+"
        . "$c->[3][0]*(x-$x[0])*(x-$x[1])*(x-$x[2])+"
        . "$c->[4][0]*(x-$x[0])*(x-$x[1])*(x-$x[2])*(x-$x[3])");
BEGIN_PGML

Use a Netwon Divided Difference table to find the interpolation of
[`f(x)=[$f]`] with 5 equally-space points ([`n=4`]) on the interval
[`[[$a],[$b]]`].

[$tab]*

Lastly, use the divided-difference table above to find the interpolated
polynomial through the point [`(x_i,y_i)`] for [`i=0,1,2,3,4`].

[% This polynomial is very sensitive to the coefficients, so we have a
 low tolerance. %]

[`P(x)=`][___]{$poly->cmp(
	tolerance => 0.01,
	tolType   => 'relative'
)}

END_PGML

$tab2 = DataTable(
    [
        [ '\(x_n\)', '\(y_n\)', '',         '',         '',         '' ],
        [ $x[0],       $y[0],       '',         '',         '',         '' ],
        [ '',          '',          $c->[1][0], '',         '',         '' ],
        [ $x[1],       $y[1],       '',         $c->[2][0], '',         '' ],
        [ '',          '',          $c->[1][1], '',         $c->[3][0], '' ],
        [ $x[2],       $y[2], '',         $c->[2][1], '',         $c->[4][0] ],
        [ '',          '',    $c->[1][2], '',         $c->[3][1], '' ],
        [ $x[3],       $y[3], '',         $c->[2][2], '',         '' ],
        [ '',          '',    $c->[1][3], '',         '',         '' ],
        [ $x[4],       $y[4], '',         '',         '',         '' ]
    ],
    texalignment    => '|c|c|c|c|c|c|',
    horizontalrules => 1,
    padding         => [ 0.25, 0.25 ]
);

BEGIN_PGML_SOLUTION

For the first column, use

[`` f[x_i,x_{i+1}] = \frac{f[x_{i+1}]-f[x_i]}{x_{i+1}-x_i} ``]

For example, the second one down should be:

[`` f[x_1,x_2] = \frac{f(x_2)-f(x_1)}{x_2-x_1} = \frac{[$y[2]]-[$y[1]]}{[$x[2]]-[$x[1]]} = [$c->[0][1]] ``]

In the 2nd column, use

[`` f[x_i,x_{i+1},x_{i+2}] = \frac{f[x_{i+2},x_{i+1}]-f[x_{i+1},x_i]}{x_{i+2}-x_i} ``]

For example,

[`` f[x_0,x_{1},x_{2}] = \frac{f[x_{2},x_{1}]-f[x_{1},x_0]}{x_{2}-x_0}=
\frac{[$c->[0][2]]-[$c->[0][1]]}{[$x[2]]-[$x[0]]} = [$c->[1][2]]``]

Continuing for all of the other divided differences, we get the following table:

[$tab2]*

And lastly, to find the polynomial that interpolates the data, we use the formula

[`` f[x_0] + f[x_0,x_1](x-x_0) + f[x_0,x_1,x_2](x-x_0)(x-x_1) +\cdots + f[x_0,x_1,\ldots,x_n] (x-x_0) \cdots (x-x_{n-1}) ``]

and in this case, the result is

[`` [$poly] ``]

END_PGML_SOLUTION

ENDDOCUMENT();
