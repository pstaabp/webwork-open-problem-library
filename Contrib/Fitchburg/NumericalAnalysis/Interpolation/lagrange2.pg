##DESCRIPTION
##  Find the cubic interpolant through 3 equally-spaced points on an interval
##ENDDESCRIPTION

##KEYWORDS('interpolation', 'cubic')

## DBsubject('Numerical Analysis')
## DBchapter('Interpolation')
## DBsection('Lagrange Interpolation')
## Date('2/3/2018')
## Author('Peter Staab')
## Institution('Fitchburg State University')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'scaffold.pl');
Context('Numeric');

$k  = random(0.25, 2, 0.25);
$C  = random(0.25, 2, 0.25);
$kx = nicestring([$k], ['x']);

$f = Compute("$C*exp($k*x)")->reduce;

$a = random(1, 3, 0.5);
$h = 0.25 * random(1, 2);
$b = $a + 3 * $h;

@x = map { $a + $h * $_ } (0 .. 3);

$L0 = Compute(
    "(x-$x[1])*(x-$x[2])*(x-$x[3])/(($x[0]-$x[1])*($x[0]-$x[2])*($x[0]-$x[3]))"
);
$L1 = Compute(
    "(x-$x[0])*(x-$x[2])*(x-$x[3])/(($x[1]-$x[0])*($x[1]-$x[2])*($x[1]-$x[3]))"
);
$L2 = Compute(
    "(x-$x[0])*(x-$x[1])*(x-$x[3])/(($x[2]-$x[0])*($x[2]-$x[1])*($x[2]-$x[3]))"
);
$L3 = Compute(
    "(x-$x[0])*(x-$x[1])*(x-$x[2])/(($x[3]-$x[0])*($x[3]-$x[1])*($x[3]-$x[2]))"
);

@y = map { $f->eval(x => $_) } @x;

$poly = Compute("$y[0]*$L0+$y[1]*$L1+$y[2]*$L2+$y[3]*$L3");

$a0  = $poly->eval(x => 0);
$df  = $poly->D('x');
$a1  = $df->eval(x => 0);
$d2f = $df->D('x');
$a2  = $d2f->eval(x => 0) / 2.0;
$d3f = $d2f->D('x');
$a3  = $d3f->eval(x => 0) / 6.0;

Scaffold::Begin();

BEGIN_PGML

This problem will use Lagrange Interpolation to find the interpolation through

[`` f(x) = [$C] e^{[$kx]}``]

on 4 equally-spaced points (that is [`n=3`]) on [` [[$a],[$b]] `].

END_PGML

Section::Begin('Part A: find the Lagrange polynomials');

BEGIN_PGML

Find the four Lagrange Interpolants through the points
[`[$x[0]],[$x[1]],[$x[2]],[$x[3]]`]:

[`L_{3,0}(x) = `] [_]{$L0}{20}

[`L_{3,1}(x) = `] [_]{$L1}{20}

[`L_{3,2}(x) = `] [_]{$L2}{20}

[`L_{3,3}(x) = `] [_]{$L3}{20}

END_PGML

BEGIN_PGML_SOLUTION

The general form of a Lagrange polynomial that is 1 at [`x_j`] and 0 through
all [`x_i`] for [`i=1\ldots n, i \neq j`] is

[`` L_{n,j} = \frac{\prod_{i=1,i \neq j}^n (x-x_i)}{\prod_{i=1,i \neq j}^n (x_j-x_i)} ``]

For [` x_0 = [$x[0]], \quad x_1 = [$x[1]], \quad x_2 = [$x[2]], \quad x_3 = [$x[3]] `],

[`` L_{3,0} = \frac{(x-[$x[0]])(x-[$x[2]])(x-[$x[3]])}{([$x[0]]-[$x[1]])
([$x[0]]-[$x[2]])([$x[0]]-[$x[3]])} ``]

[`` L_{3,1} = \frac{(x-[$x[0]])(x-[$x[2]])(x-[$x[3]])}{([$x[1]]-[$x[0]])
([$x[1]]-[$x[2]])([$x[1]]-[$x[3]])} ``]

[`` L_{3,2} = \frac{(x-[$x[0]])(x-[$x[1]])(x-[$x[3]])}{([$x[2]]-[$x[0]]])
([$x[2]]-[$x[1]])([$x[2]]-[$x[3]])} ``]

[`` L_{3,3} = \frac{(x-[$x[0]])(x-[$x[1]])(x-[$x[2]])}{([$x[3]]-[$x[0]])
([$x[2]]-[$x[0]])([$x[3]]-[$x[0]])} ``]


END_PGML_SOLUTION

Section::End();

Section::Begin('Part B: Find the interpolating polynomial');

BEGIN_PGML

Use Lagrange Interpolation to find the interpolation through

[`` f(x) = [$C] e^{[$kx]}``]

on 4 equally-spaced points (that is [`n=3`]) on [` [[$a],[$b]] `].

[________________________________________________________________]{$poly}

END_PGML

$red_poly = Formula("$a3 x^3 + $a2 x^2 + $a1 x + $a0")->reduce;

BEGIN_PGML_SOLUTION

And using Lagrange polynomials, the interpolating polynomials is

[`` P(x) = \sum_{j=0}^n y_j L_{n,j} ``]

so for this problem,

[`` P(x) = [$y[0]] L_{3,0}(x) + [$y[1]] L_{3,1}(x) + [$y[2]] L_{3,2}(x)
+ [$y[3]] L_{3,3}(x) ``]

[`` P(x) = [$red_poly] ``]

END_PGML_SOLUTION

Section::End();
Scaffold::End();

ENDDOCUMENT();
