##DESCRIPTION
##  Find the quadratic interpolant through 3 distinct points.
##ENDDESCRIPTION

##KEYWORDS('interpolation', 'quadratic')

## DBsubject('Numerical Analysis')
## DBchapter('Interpolation')
## DBsection('Lagrange Interpolation')
## Date('2/3/2018')
## Author('Peter Staab')
## Institution('Fitchburg State University')

DOCUMENT();

loadMacros("PGstandard.pl", "PGML.pl", "PGpolynomialmacros.pl", "PGcourse.pl");
Context('Numeric')->noreduce('(-x)-y', '(-x)+y');

($x0, $x1, $x2) = (0, random(1, 5), random(-5, 1));
($a, $b, $c) = (non_zero_random(-2, 2), random(1, 6), random(1, 6));

$quad = Compute("$a*x^2+$b*x+$c")->reduce;

$y0 = $quad->eval(x => $x0);
$y1 = $quad->eval(x => $x1);
$y2 = $quad->eval(x => $x2);

BEGIN_PGML

Find the quadratic function that passes through the points [` ([$x2],[$y2]) `],
[`([$x0],[$y0])`] and [`([$x1],[$y1]) `].

The quadratic is [`q(x)=`] [_____]{$quad}

END_PGML

Context()->variables->are(a => 'Real', b => 'Real', c => 'Real');

$quad1 = Formula("a ($x1)^2 + b $x1 + c")->reduce;
$quad2 = Formula("a ($x2)^2 + b $x2 + c")->reduce;
Context()->variables->are(x => 'Real');

BEGIN_PGML_SOLUTION
Let
[`` q(x) = ax^2+bx+c ``]
be a generic quadratic function.  It must satisfy

[``` q([$x0])=[$y0], \quad q([$x1])=[$y1], \quad q([$x2])=[$y2] ```]

or

[```
\begin{aligned}
c & = [$y0] \\
[$quad1] & = [$y1] \\
[$quad2] & = [$y2] 
\end{aligned}
```]

Solving these three equations simulataneously results in

[`` a=[$a], \quad b=[$b], \quad c=[$c] ``]

Resulting in the quadratic

[`` q(x) = [$quad] ``]

END_PGML_SOLUTION

ENDDOCUMENT();
