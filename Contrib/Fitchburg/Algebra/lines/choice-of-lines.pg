## DESCRIPTION
## This problem asks the student to identify a line from a graph.
## ENDDESCRIPTION

## DBsubject(Algebra)
## DBchapter(Linear equations and functions)
## DBsection(Graphs of lines)
## Date(September 5, 2008)
## Institution(Fitchburg State University)
## Author(Peter Staab)
## Level(1)
## KEYWORDS('lines')

DOCUMENT();    # This should be the first executable line in the problem.

loadMacros(
    'PGstandard.pl',  'PGML.pl',
    'plots.pl',       'contextFraction.pl',
    'parserPopUp.pl', 'PGcourse.pl'
);
Context("Fraction");

do {
    $a1 = random(1, 6);
    $b1 = random(1, 6);
    $c1 = random(4, 6);
} until gcd($a1, $b1, $c1) == 1;

$xi1 = Compute("$c1/$a1");
$yi1 = Compute("$c1/$b1");

do {
    $m2 = non_zero_random(-3, 3);
    $b2 = random(-4, 4);
} until $m2 * $b1 != -$a1;

$h = random(1, 5);

do {
    $a4 = random( 1,  6);
    $b4 = random(-6, -1);
    $c4 = -1 * random(4, 12);
} until gcd($a4, $b4, $c4) == 1;

$xi4 = Compute("$c4/$a4");
$yi4 = Compute("$c4/$b4");

# Place the labels on the graphs
if ((2 * $b1 + $c1) / $a1 > -7 && (2 * $b1 + $c1) / $a1 < 7) {
    $xlab1 = (1 * $b1 + $c1) / $a1;
    $ylab1 = -1;
} else {
    $xlab1 = 5;
    $ylab1 = (-5 * $a1 + $c1) / $b1;
}

if ((-2 * $a4 + $c4) / $b4 > -7 && (-2 * $a4 + $c4) / $b4 < 7) {
    $xlab4 = 2;
    $ylab4 = (-2 * $a4 + $c4) / $b4;
} else {
    $xlab4 = (5 * $b4 + $c4) / $a4;
    $ylab4 = -5;
}

$plot = Plot(
    xmin            => -8.5,
    xmax            =>  8.5,
    xtick_delta     =>  2,
    xminor          =>  1,
    ymin            => -8.5,
    ymax            =>  8.5,
    ytick_delta     =>  2,
    yminor          =>  1,
    rounded_corners => 1
);

$plot->add_function(
    [ "-$a1/$b1 x + $c1 / $b1", 'x', -9, 9, color => 'darkblue' ],
    [ "$m2 x + $b2",            'x', -9, 9, color => 'darkgreen' ],
    [ "$h",                     'x', -9, 9, color => 'magenta' ],
    [ "-$a4/$b4 x + $c4 / $b4", 'x', -9, 9, color => 'salmon' ]
);
$plot->add_label(
    [ $xlab1, $ylab1, 'A', color => 'darkblue', h_align => 'right' ],
    [
        -1, $m2 * (-1) + $b2, 'B',
        color   => 'darkgreen',
        h_align => 'left',
        v_align => 'bottom'
    ],
    [ 7,      $h,     'C', color => 'magenta', v_align => 'bottom' ],
    [ $xlab4, $ylab4, 'D', color => 'salmon',  h_align => 'right' ],
);

$alttext =
    "A graph of four lines.  Line A passes through the points "
    . "($xi1,0) and (0,$yi1).  Line B has slope $m2 and y-intercept $b2. "
    . "Line C is horizontal and has y-intercept of $h.  Line D has intercepts "
    . "($xi4,0) and (0, $yi4)";

@lines =
    ("$a1 x + $b1 y = $c1", "y=$m2 x + $b2", "y=$h", "$a4 x + $b4 y = $c4");

@order   = random_subset(4, 0 .. 3);
@options = ('A' .. 'D');
@dd      = map { DropDown(~~@options, $options[ $order[$_] ]) } (0 .. 3);

BEGIN_PGML

>>[![$alttet]!]{$plot}{300}<<

Identify the graphs of the lines by letter:

1. [_]{$dd[0]} [`[$lines[$order[0]]]`]

2. [_]{$dd[1]} [`[$lines[$order[1]]]`]

3. [_]{$dd[2]} [`[$lines[$order[2]]]`]

4. [_]{$dd[3]} [`[$lines[$order[3]]]`]

END_PGML

BEGIN_PGML_SOLUTION
For each of the lines in the answer, you should identify if the line is
vertical, horizontal or oblique.

In this case, the line [`[$lines[2]]`] is horizontal. The answer is [$options[$order[0]]].

The line [`[$lines[1]]`] in slope-intercept form, and the slope is [$m2]
with y-intercept of [$b2].  It appears that the [$sc[1]] line has this slope and y-intercept. The answer is [$options[$order[1]]].

For the other two lines, they are nearly in intercept form, so we should do
that.  The line [`[$lines[0]]`] is:
[```
\begin{aligned}
[$a1] x + [$b1] y & = [$c1] \\
\frac{[$a1]}{[$c1]} x + \frac{[$b1]}{[$c1]} y & = 1 \\
\frac{x}{[$xi1]} + \frac{y}{[$yi1]} & = 1
\end{aligned}
```]
so the x-intercept is [`[$xi1]`] and the y-intercept is [`[$yi1]`].  The answer is [$options[$order[2]]].

We could just use process of elimination to find the last line, but lets
repeat the process above.  The last line is
[```
\begin{aligned}
[$a4] x + [$b4] y & = [$c4] \\
\frac{[$a4]}{[$c4]} x + \frac{[$b4]}{[$c4]} y & = 1 \\
\frac{x}{[$xi4]} + \frac{y}{[$yi4]} & = 1
\end{aligned}
```]
so the x-intercept is [$c4]/[$a4] and the y-intercept is [$c4]/[$b4].
The answer is [$options[$order[3]]].

END_PGML_SOLUTION

ENDDOCUMENT();
