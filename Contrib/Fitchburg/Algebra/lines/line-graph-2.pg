## DESCRIPTION
## This problem asks student to estimate the slope of a line from a graph.
## ENDDESCRIPTION

## DBsubject(Algebra)
## DBchapter(Linear equations and functions)
## DBsection(Graphs of lines)
## Date(September 5, 2008)
## Institution(Fitchburg State University)
## Author(Peter Staab)
## Level(1)
## KEYWORDS('lines','slope')

DOCUMENT(); 

loadMacros('PGstandard.pl', 'PGML.pl', 'plots.pl', 'parserPopUp.pl', 'PGcourse.pl');

Context('Numeric');

sub describeSlope {
    my $m = shift;
    return '\(m\) is Undefined' unless defined($m);
    return
        abs($m - 1) < 0.001   ? '\(m=1\)'
        : abs($m + 1) < 0.001 ? '\(m=-1\)'
        : abs($m) < 0.001     ? '\(m=0\)'
        : $m > 0 && $m < 1    ? '\(0<m<1\)'
        : $m > 1              ? '\(m>1\)'
        : $m < 0 && $m > -1   ? '\(-1<m<0\)'
        : $m < -1             ? '\(m<-1\)'
        :                       '';
}

@line_choices = map {"\($_\)"}
    ('m<-1', 'm=-1', '-1<m<0', 'm=0', 'm>0', '0<m<1', 'm=1', 'm>1');
push(@line_choices, '\(m\) is Undefined');

do {
    @b      = map { random(-20, 20) / 4 } (0 .. 3);
    @alpha  = map { random(0,   360, 15) } (0 .. 3);
    @m      = map { $_ == 90 || $_ == 270 ? undef : tan($_ * pi / 180) } @alpha;
    @m_desc = map { describeSlope($_) } @m;

    # ensure that no answer is repeated.
    %m = map { $_ => 1 } @m_desc;
} until scalar(keys %m) == 4;

@dd =
    map { DropDown(~~@line_choices, describeSlope($m[$_]), useHTMLSelect => 0) }
    (0 .. 3);

for (0 .. 3) {
    $plot[$_] = Plot(
        xmin            => -6.5,
        xmax            =>  6.5,
        xtick_delta     =>  1,
        xminor          =>  0,
        ymin            => -6.5,
        ymax            =>  6.5,
        ytick_delta     =>  1,
        yminor          =>  0,
        rounded_corners => 1
    );
    if ($m[$_]) {
        $plot[$_]->add_function("$m[$_] x + $b[$_]",
            'x', -6.5, 6.5, color => 'darkgreen');
    } else {
        $c = random(-5, 5);
        $plot[$_]->add_dataset([ $c, -7 ], [ $c, 7 ], color => 'darkgreen');
    }
}

BEGIN_PGML

For each of the following determine what best fits the slope:

[#
    [.[!!]{$plot[0]}{250}.][.[!!]{$plot[1]}{250}.]*
    [.a) [_]{$dd[0]} .][. b) [_]{$dd[1]} .]*
    [.[!!]{$plot[2]}{250}.][.[!!]{$plot[3]}{250}.]*
    [.c) [_]{$dd[2]} .][. d) [_]{$dd[3]} .]*
#]{padding => 0.5}

END_PGML

BEGIN_PGML_SOLUTION

Recall that a horizontal line has slope of 0.

If the line runs from the SW to the NE (or rises from left to right), then the slope
is a positive number.  A slope of +1 rises one unit for every one unit of run.
(For example the 45 degree line [`y=x`] has slope 1.)  If a line is not as steep as
this line, then it must have slope between 0 and 1. If a line still has positive slope
but is steeper than the [` y=x `] line then the slope is greater than one.

If a line runs from the NW to the SE (or falls from left to right), then the slope
is a negative number.  The line [` y=-x`] has a slope of -1 and falls one unit for
each unit of run. If a line with negative slope is less steep than [` y=-x `] then
its slope is between -1 and 0, and such a line that is steeper will have a slope less than -1.

a) [`[$dd[0]]`]
b) [`[$dd[1]]`]
c) [`[$dd[2]]`]
d) [`[$dd[3]]`]

END_PGML_SOLUTION

ENDDOCUMENT();    # This should be the last executable line in the problem.