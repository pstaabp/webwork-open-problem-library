##DESCRIPTION
##  Proof of scalar distribution for matrix addition.
##ENDDESCRIPTION

##KEYWORDS('algebra', 'inequality', 'fraction')

## DBsubject('Linear Algebra')
## DBchapter('Matrices')
## DBsection('Matrix Algebra')
## Date('10/3/2020')
## Author('Peter Staab')
## Institution('Fitchburg State University')

########################################################################

DOCUMENT();

loadMacros("PGstandard.pl", "PGML.pl", "draggableProof.pl", "PGcourse.pl");

Context("Numeric");

$CorrectProof = DraggableProof(
    [
        "Let \(A=[a_{ij}]\) and \(B=[b_{ij}]\)",
        "\(k(A+B) = k([a_{ij}]+[b_{ij}])\)",
        "\(k(A+B) = k([a_{ij}+b_{ij}])\)",
        "\(k(A+B) = [k(a_{ij}+b_{ij}])\)",
        "\(k(A+B) = [ka_{ij} +kb_{ij}] \)",
        "\(k(A+B) = [ka_{ij}] + [kb_{ij}] \)",
        "\(k(A+B) = k[a_{ij}]+ k[b_{ij}]\)",
        "\(k(A+B) = kA+kB\)"
    ],
    [],
    SourceLabel => "Choose from these",
    TargetLabel => "Place them in the order for proper proof",
);

BEGIN_PGML

Let [`k`] be a scalar and [`A`] and [`B`] be [`m \times n`] matrices.  Prove the following:

[`` k(A+B) = kA + kB ``]

Note: you may not need to use all of the statements.

[__]{$CorrectProof}


END_PGML
ENDDOCUMENT();
