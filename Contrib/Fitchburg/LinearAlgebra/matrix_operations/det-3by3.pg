## DESCRIPTION
## Asks the student to calculated the determinant of a 3 by 3 matrix.
## ENDDESCRIPTION


## DBsubject(Linear algebra)
## DBchapter(Determinants)
## DBsection(Computing determinants)
## Date(September 5, 2008)
## Institution(Fitchburg State University)
## Author(Peter Staab)
## KEYWORDS('determinant','3 by 3 matrix')

# updated 2022.10.29

DOCUMENT();    # This should be the first executable line in the problem.
loadMacros('PGstandard.pl', 'PGML.pl', 'PGcourse.pl');

Context('Numeric');

sub submatrix {
    my ($A, $rows, $cols) = @_;
    my $B = [ [] ];
    for my $i (0 .. scalar(@$rows) - 1) {
        for my $j (0 .. scalar(@$rows) - 1) {
            $B->[$i][$j] = $A->element($rows->[$i], $cols->[$j]);
        }
    }
    return Matrix($B);
}

do {
    $A = Matrix([
        [ random(-3, 3), random(-3, 3), random(-3, 3) ],
        [ random(-3, 3), 0,             random(-3, 3) ],
        [ random(-3, 3), random(-3, 3), random(-3, 3) ]
    ]);
} until $A->det != 0;

$A11 = submatrix($A, [ 2, 3 ], [ 2, 3 ]);
$A12 = submatrix($A, [ 2, 3 ], [ 1, 3 ]);
$A13 = submatrix($A, [ 2, 3 ], [ 1, 2 ]);
$d1  = $A11->det;
$d2  = $A12->det;
$d3  = $A13->det;

BEGIN_PGML
Let

[```   A= [$A] ```]

then [` |A| = `] [____]{Real($A->det)}
END_PGML

BEGIN_PGML_SOLUTION
For a [`3 \times 3`] matrix, one can either use row operations to do this or row expansions.
For the latter, one can expand about any row or column.  If we expand about the top row 
then 
[``` 
\begin{aligned}
|A| & = (-1)^{1+1} ([$A->element(1,1)] )\text{det}\left([$A11]\right) 
+ (-1)^{1+2} ([$A->element(1,2)] )\text{det}\left([$A12]\right) 
+ (-1)^{1+3}([$A->element(1,3)] ) \text{det}\left([$A13]\right) \\
& = (1)([$A->element(1,1)] )([$d1]) 
+ (-1)([$A->element(1,2)] )([$d2]) 
+ (1)([$A->element(1,3)] )([$d3]) = [$A->det] 
\end{aligned}
```]
END_PGML_SOLUTION

ENDDOCUMENT();
