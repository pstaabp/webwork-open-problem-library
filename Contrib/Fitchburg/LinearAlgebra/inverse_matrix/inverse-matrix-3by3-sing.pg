## DBsubject(Linear algebra)
## DBchapter(Matrices)
## DBsection(Inverses)
## Date(September 5, 2008)
## Institution(Fitchburg State University)
## Author(Peter Staab)
## KEYWORDS('lines')

DOCUMENT();
loadMacros(
    'PGstandard.pl',             'PGML.pl',
    'parserRadioMultiAnswer.pl', 'PGcourse.pl'
);

Context('Matrix');

do {
    $A = Matrix([
        [ random(-3, 3), random(-3, 3), random(-3, 3) ],
        [ random(-3, 3), random(-3, 3), random(-3, 3) ],
        [ random(-3, 3), random(-3, 3), random(-3, 3) ]
    ]);
    $det = $A->det;

} until ($det == 0);

$rma = RadioMultiAnswer(
    [
        [ 'The inverse exists and \(A^{-1} =\;\) %s*', $A ],
        ['The inverse does not exist.']
    ],
    1
);

BEGIN_PGML
Find the inverse of
[``` A = [$A]```]

[_]{$rma}

END_PGML

$Aaug = Matrix([
    [ $A->element(1, 1), $A->element(1, 2), $A->element(1, 3), 1, 0, 0 ],
    [ $A->element(2, 1), $A->element(2, 2), $A->element(2, 3), 0, 1, 0 ],
    [ $A->element(3, 1), $A->element(3, 2), $A->element(3, 3), 0, 0, 1 ],
]);

$P1 = Matrix([ 1 / $A->element(1, 1), 0, 0 ], [ 0, 1, 0 ], [ 0, 0, 1 ]);
$P2 = Matrix(
    [ 1, 0, 0 ],
    [ -$A->element(2, 1), 1, 0 ],
    [ -$A->element(3, 1), 0, 1 ]
);

$A1 = $P2 * $P1 * $Aaug;

# there is a row of zeros, swap
$P3 =
    $A1->element(2, 2) == 0 && $A1->element(2, 3) == 0
    ? Matrix([ [ 1, 0, 0 ], [ 0, 0, 1 ], [ 0, 1, 0 ] ])
    : Matrix([ [ 1, 0, 0 ], [ 0, 1, 0 ], [ 0, 0, 1 ] ]);
$A2 = $P3 * $A1;

if ($A2->element(3, 2) == 0 && $A2->element(3, 3) == 0) {
    $A3 = $A2;
} else {
    $P4 =
        $A1->element(2, 2) == 0
        ? Matrix([ [ 1, 0, 0 ], [ 0, 1 / $A2->element(3, 3), 0 ], [ 0, 0, 1 ] ])
        : Matrix([
            [ 1, 0, 0 ], [ 0, 1 / $A1->element(2, 2), 0 ], [ 0, 0, 1 ] ]);
    $P5 =
        $A1->element(3, 2) == 0
        ? Matrix([ [ 1, 0, 0 ], [ 0, 1, 0 ], [ 0, -$A1->element(3, 3), 1 ] ])
        : Matrix([ [ 1, 0, 0 ], [ 0, 1, 0 ], [ 0, -$A1->element(3, 2), 1 ] ]);
    $A3 = $P5 * $P4 * $A2;
}
BEGIN_PGML_SOLUTION
The easiest way to solve this is to row reduce the augment matrix with
[`A`] on the left and [`I`] on the right or
[```[$Aaug]```]

[```[$A1]```]

[```[$A2]```]

[```[$A3]```]

And since the left half of this matrix cannot be converted to the identity
matrix, [`A`] does not have an inverse.

Note: an alternative way to solve this is to take the determinant of [`A`],
which is 0, indicating that the inverse does not exist.
END_PGML_SOLUTION
ENDDOCUMENT();
