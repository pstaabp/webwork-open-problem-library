## DBsubject(Linear algebra)
## DBchapter(Matrices)
## DBsection(Inverses)
## Date(September 5, 2008)
## Institution(Fitchburg State University)
## Author(Peter Staab)
## KEYWORDS('lines')

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'parserRadioMultiAnswer.pl', 'PGcourse.pl');

Context('Matrix');

do {
  $A = Matrix([
    [random(-3,3), random(-3,3), random(-3,3)],
    [random(-3,3), random(-3,3), random(-3,3)],
    [random(-3,3), random(-3,3), random(-3,3)]
  ]);
$det = $A->det;

} until ($det != 0 && abs($det) <= 4);

$Ainv = $A->inverse;

$rma = RadioMultiAnswer([
  ['The inverse exists and \(A^{-1} =\;\) %s*', $Ainv],
  ['The inverse does not exist.']
], 0);

BEGIN_PGML
Find the inverse of
[``` A = [$A]```]

[_]{$rma}

END_PGML

$Aaug = Matrix([
  [$A->element(1,1), $A->element(1,2), $A->element(1,3),1,0,0],
  [$A->element(2,1), $A->element(2,2), $A->element(2,3),0,1,0],
  [$A->element(3,1), $A->element(3,2), $A->element(3,3),0,0,1],
]);

BEGIN_PGML_SOLUTION
The easiest way to solve this is to row reduce the augment matrix with
[`A`] on the left and [`I`] on the right or
[```[$Aaug]```]

Row reducing this reduces this to
[```[$Ainv*$Aaug] ```]
and the inverse is on the right half of this matrix, therefore,
[```A^{-1} = [$Ainv]```]
END_PGML_SOLUTION

ENDDOCUMENT();
