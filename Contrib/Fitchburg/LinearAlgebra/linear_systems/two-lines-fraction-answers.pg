# DESCRIPTION
# A problem that asks the student to find
# the formula of a line through two points.
# ENDDESCRIPTION

## DBsubject(Linear algebra)
## DBchapter(Systems of linear equations)
## DBsection(Systems with 2 variables)
## Institution(Fitchburg State University)
## Author(Peter Staab)
## KEYWORDS('lines, linear systems')

DOCUMENT();

loadMacros(
    'PGstandard.pl',             'PGML.pl',
    'parserRadioMultiAnswer.pl', 'MatrixReduce.pl',
    'PGcourse.pl'
);

Context("Fraction")->variables->add(y => 'Real');
Context()->noreduce('(-x)+y', '(-x)-y');

sub submatrix {
    my ($A, $rows, $cols) = @_;
    my $B = [ [] ];
    for my $i (0 .. scalar(@$rows) - 1) {
        for my $j (0 .. scalar(@$rows) - 1) {
            $B->[$i][$j] = $A->element($rows->[$i], $cols->[$j]);
        }
    }
    return Matrix($B);
}

# Find a matrix and vector b without integer solutions.
do {
    $A = apply_fraction_to_matrix_entries(Matrix([
        [ non_zero_random(-4, 4), non_zero_random(-4, 4), random(-6, 6) ],
        [ non_zero_random(-4, 4), non_zero_random(-4, 4), random(-6, 6) ]
    ]));
    $det  = submatrix($A, [ 1 .. 2 ], [ 1 .. 2 ])->det;
    $rref = rref($A);
    } until abs($det) > 1
    && abs($det) <= 4
    && (int($rref->element(1, 3)) != $rref->element(1, 3)
        || int($rref->element(2, 3)) != $rref->element(2, 3));

$line1 = Formula($A->element(1, 1) . 'x+' . $A->element(1, 2) . 'y')->reduce;
$line2 = Formula($A->element(2, 1) . 'x+' . $A->element(2, 2) . 'y')->reduce;

$x0 = $rref->element(1,3);
$x1 = $rref->element(2,3);
Context('Point');
$pt = Compute("($x0,$x1)");

$rma = RadioMultiAnswer(
    [
        ['The linear system has no solution'],
        ['The linear system has an infinite number of solutions.'],
        [
            'The linear system has a single solution %s.  Write your answer as a point.',
            $pt
        ]
    ],
    2
);

BEGIN_PGML

What is the solution to the linear system? 

[``` \begin{aligned} 
[$line1] & = [$A->element(1,3)]\\
[$line2] & = [$A->element(2,3)]
\end{aligned}
```]

[_]{$rma}

END_PGML

BEGIN_PGML_SOLUTION
This solution is found using Gauss-Jordan Elimination.  First start with it augmented matrix:
[```
[$A] ```]

Performing row-reduction to get:
[``` [$rref] ```]

This shows the solution is the single point 
[```
\begin{aligned}
x & = [$rref->element(1,3)]\\
y & = [$rref->element(2,3)]
\end{aligned}
```]
END_PGML_SOLUTION

ENDDOCUMENT();    # This should be the last executable line in the problem.
