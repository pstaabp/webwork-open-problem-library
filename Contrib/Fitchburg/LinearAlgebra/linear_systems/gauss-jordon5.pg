## DESCRIPTION
## Find the solution to a system of 3 equations and 3 variables.
## ENDDESCRIPTION

## KEYWORDS('lines')

## DBsubject('Linear Algebra')
## DBchapter('Systems of Linear Equations')
## DBsection('Systems with 3 variables')
## Date('September 5, 2008')
## Author('Peter Staab')
## Institution('Fitchburg State University')

# updated on 2022.10.29

DOCUMENT();
loadMacros(
    'PGstandard.pl',             'PGML.pl',
    'parserRadioMultiAnswer.pl', 'contextFraction.pl',
    'MatrixReduce.pl',           'PGcourse.pl'
);

Context('Numeric')->variables->add(y => 'Real', z => 'Real');
Context()->noreduce('(-x)+y', '(-x)-y');

$zerov = Vector([ 0, 0, 0 ]);
# Find a nice matrix with zero determinant that does not repeat rows or column or has zero rows/columns.
do {
    $A = Matrix([
        [ random(-5, 5), random(-5, 5), random(-5, 5) ],
        [ random(-5, 5), random(-5, 5), random(-5, 5) ],
        [ random(-5, 5), random(-5, 5), random(-5, 5) ],
    ]);
    } until $A->det == 0
    && $A->row(1) != $zerov
    && $A->row(2) != $zerov
    && $A->row(3) != $zerov
    && Vector($A->column(1)) != $zerov
    && Vector($A->column(2)) != $zerov
    && Vector($A->column(3)) != $zerov
    && $A->row(1) != $A->row(2)
    && $A->row(1) != $A->row(3)
    && $A->row(2) != $A->row(3)
    && $A->column(1) != $A->column(2)
    && $A->column(1) != $A->column(3)
    && $A->column(2) != $A->column(3);

$x = Matrix([ [ random(-4, 4) ], [ random(-4, 4) ], [ random(-4, 4) ] ]);
$b = $A * $x;

@lines = map {
    Formula($A->element($_, 1) . 'x+'
            . $A->element($_, 2) . 'y+'
            . $A->element($_, 3)
            . 'z')->reduce
} (1 .. 3);

$rma = RadioMultiAnswer(
    [
        ['There is no solution to the linear system'],
        ['There are an infinite number of solutions to the linear system.'],
        [
            'There is a single solution to the linear system in the form %s',
            ''
        ]
    ],
    0
);

BEGIN_PGML
Solve the follow linear system using the Gauss-Jordon method:

[```
\begin{aligned}
[$lines[0]] & = [@ $b->element(1,1) @] \\
[$lines[1]] & = [@ $b->element(2,1) @] \\
[$lines[2]] & = [@ $b->element(3,1) @]
\end{aligned}
```]

Select the following result about the solution to this linear system.

[____]{$rma}
END_PGML

Context('Fraction');    # for fraction arithmetic

# augmented matrix to be reduced
$aug = Matrix([
    [
        $A->element(1, 1),
        $A->element(1, 2),
        $A->element(1, 3),
        $b->element(1, 1)
    ],
    [
        $A->element(2, 1),
        $A->element(2, 2),
        $A->element(2, 3),
        $b->element(2, 1)
    ],
    [
        $A->element(3, 1),
        $A->element(3, 2),
        $A->element(3, 3),
        $b->element(3, 1)
    ]
]);

$aug_red = rref($aug);

BEGIN_PGML_SOLUTION

First, start with the augmented coefficient matrix or
[``` [$aug] ```]

and then perform Gauss-Jordon reduction to get 
[``` [$aug_red] ```]

There is a free variable in this case, so there are infinitely many solution to
this linear system.
END_PGML_SOLUTION
COMMENT(
    'The solution to this nonhomogeneous system has an infinite number of points.'
);

ENDDOCUMENT();    # This should be the last executable line in the problem.
