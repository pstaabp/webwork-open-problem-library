## DESCRIPTION
## Find the solution to a system of 3 equations and 3 variables with infinite number of solutions.
## ENDDESCRIPTION

## KEYWORDS('linear system', 'infinite number of solutions', 'vector form')

## DBsubject('Linear Algebra')
## DBchapter('Systems of Linear Equations')
## DBsection('Systems with 3 variables')
## Date('September 5, 2008')
## Author('Peter Staab')
## Institution('Fitchburg State University')

# updated on 2022.11.13

DOCUMENT();    # This should be the first executable line in the problem.
loadMacros('PGstandard.pl', 'PGML.pl', 'MatrixReduce.pl', 'PGcourse.pl');

Context('Vector')->variables->are(
    x => 'Real',
    y => 'Real',
    z => 'Real',
    t => 'Real',
    s => 'Real'
);
Context()->noreduce('(-x)+y', '(-x)-y');

do {
    ($a1, $a2, $a3) = (random(-4, 4), random(-4, 4), random(-4, 4));
    $b1 = non_zero_random(-5, 5);
    $A  = Matrix([ [ $a1, $a2, $a3, $b1 ], [ 0, 0, 0, 0 ], [ 0, 0, 0, 0 ] ]);
    ($k1, $k2) =
        (list_random(-4 .. -2, 2 .. 4), list_random(-4 .. -2, 2 .. 4));
    $A = row_add($A, 2, 1, $k1);
    $A = row_add($A, 3, 1, $k2);
} until $k1 != $k2 && Vector($a1, $a2, $a3) != Vector(0, 0, 0);

@lines = map {
    Formula($A->element($_, 1) . 'x+'
            . $A->element($_, 2) . 'y+'
            . $A->element($_, 3)
            . 'z')->reduce
} (1 .. 3);

if ($A->element(1, 1) != 0) {
    $v0 = Vector($b1 / $A->element(1, 1), 0, 0);
    $v1 = Vector(-1 * $A->element(1, 2) / $A->element(1, 1), 1, 0);
    $v2 = Vector(-1 * $A->element(1, 3) / $A->element(1, 1), 0, 1);

} elsif ($A->element(1, 2) != 0) {
    $v0 = Vector(0, $b1 / $A->element(1, 2), 0);
    $v1 = Vector(1, -1 * $A->element(1, 1) / $A->element(1, 2), 0);
    $v2 = Vector(0, -1 * $A->element(1, 3) / $A->element(1, 2), 1);
} else {
    $v0 = Vector(0, 0, $b1 / $A->element(1, 3));
    $v1 = Vector(1, 0, -1 * $A->element(1, 1) / $A->element(1, 3));
    $v2 = Vector(0, 1, -1 * $A->element(1, 2) / $A->element(1, 3));
}

$ans   = Compute("$v0+$v1 t + $v2 s");
$check = sub {
    my ($correct, $student, $ansHash) = @_;
    my $s0 = $student->eval(t => 0, s => 0);
    my $dt = $student->D('t')->eval(t => 0, s => 0);
    my $ds = $student->D('s')->eval(t => 0, s => 0);
    if ($dt == Vector(0, 0, 0)) {
        Value->Error('Your solution must have the parameter t');
        return 0;
    }
    if ($ds == Vector(0, 0, 0)) {
        Value->Error('Your solution must have the parameter s');
        return 0;
    }
    if ($ds->isParallel($dt)) {
        Value->Error(
            'The vectors associated with s and t must be linearly indpendent.');
        return 0;
    }
    my $A = Vector($a1, $a2, $a3);
    return $A . $s0 == $b1 && $A . $dt == 0 && $A . $ds == 0 ? 1 : 0;
};

BEGIN_PGML
The following linear system has an infinite number of solutions:

[```\begin{aligned}
[$lines[0]] & = [$A->element(1,4)] \\
[$lines[1]] & = [$A->element(2,4)] \\
[$lines[2]] & = [$A->element(3,4)] \\
\end{aligned} ```]


Let [`\vec{x}=\langle x,y,z \rangle`] be the solution to the linear system.
Write the solution in the
form [`\vec{x}=\vec{u}+t\vec{v} `] or [` \vec{x} = \vec{u} + t \vec{v} + s \vec{w} `]
depending on the number of free parameters.

[` \vec{x} = `] [_____]{$ans->cmp(checker => $check)}

END_PGML

Context('Fraction');
$aug = apply_fraction_to_matrix_entries($A);

$aug_red = rref($aug);

Context('Numeric')->variables->add(y => 'Real', t => 'Real', s => 'Real');
Context()->noreduce('(-x)+y', '(-x)-y');
if ($aug_red->element(1, 1) == 0 && $aug_red->element(1, 2) == 0) {
    $free_vars = 'x, y';
    $eqn_x     = Formula('t');
    $eqn_y     = Formula('s');
    $eqn_z     = Formula($aug_red->element(1, 4))->reduce;
} elsif ($aug_red->element(1, 1) == 0) {
    $free_vars = 'x, z';
    $eqn_x     = Formula('t');
    $eqn_y =
        Formula($aug_red->element(1, 4) . '-' . $aug_red->element(1, 3) . 's')
        ->reduce;
    $eqn_z = Formula('s');
} else {
    $free_vars = 'y, z';
    $eqn_x =
        Formula($aug_red->element(1, 4) . '-'
            . $aug_red->element(1, 2) . 't-'
            . $aug_red->element(1, 3)
            . 's')->reduce;
    $eqn_y = Formula('t');
    $eqn_z = Formula('s');
}

BEGIN_PGML_SOLUTION
For this write down the augmented matrix as
[``` [$aug] ```]
and row reduce it to 
[``` [$aug_red] ```]
and note that the last two rows are zero and the variables [`[$free_vars]`] are free.
The equations then are:
[``` 
\begin{aligned}
x & = [$eqn_x] \\
y & = [$eqn_y] \\
z & = [$eqn_z] \\
\end{aligned}
```]
So the solution in vector form is [`[$ans]`]
END_PGML_SOLUTION
COMMENT('The solution has two free variables.');

ENDDOCUMENT();
