## DESCRIPTION
## WeBWorK Demo
## ENDDESCRIPTION

## KEYWORDS('lines')
## Tagged by jjh2b

## DBsubject('WeBWorK')
## DBchapter('Linears and Linear Function')
## DBsection('Problem')
## Date('September 5, 2008')
## Author('Peter Staab')
## Institution('Fitchburg State University')

DOCUMENT();    # This should be the first executable line in the problem.
loadMacros("PGstandard.pl", 'PGML.pl', 'parserRadioMultiAnswer.pl',,
    'contextFraction.pl', 'MatrixReduce.pl', 'PGcourse.pl');

Context('Vector')->variables->add(t => 'Real');
Context()->noreduce('(-x)+y', '(-x)-y');

$zerov = Vector(0, 0, 0);
# Find a nice matrix with zero determinant that does not repeat rows or column or has zero rows/columns.
do {
    $A = Matrix([
        [ random(-5, 5), random(-5, 5), random(-5, 5) ],
        [ random(-5, 5), random(-5, 5), random(-5, 5) ],
        [ random(-5, 5), random(-5, 5), random(-5, 5) ],
    ]);
    } until $A->det == 0
    && $A->row(1) != $zerov
    && $A->row(2) != $zerov
    && $A->row(3) != $zerov
    && Vector($A->column(1)) != $zerov
    && Vector($A->column(2)) != $zerov
    && Vector($A->column(3)) != $zerov
    && $A->row(1) != $A->row(2)
    && $A->row(1) != $A->row(3)
    && $A->row(2) != $A->row(3)
    && $A->column(1) != $A->column(2)
    && $A->column(1) != $A->column(3)
    && $A->column(2) != $A->column(3);

$x = Vector(random(-4, 4), random(-4, 4), random(-4, 4));
$b = $A * $x;

@lines = map {
    Formula($A->element($_, 1) . 'x+'
            . $A->element($_, 2) . 'y+'
            . $A->element($_, 3)
            . 'z')->reduce
} (1 .. 3);

Context('Fraction');    # for fraction arithmetic

# augmented matrix to be reduced
$aug = apply_fraction_to_matrix_entries(Matrix([
    [
        $A->element(1, 1),
        $A->element(1, 2),
        $A->element(1, 3),
        Matrix($b)->element(1)
    ],
    [
        $A->element(2, 1),
        $A->element(2, 2),
        $A->element(2, 3),
        Matrix($b)->element(2)
    ],
    [
        $A->element(3, 1),
        $A->element(3, 2),
        $A->element(3, 3),
        Matrix($b)->element(3)
    ]
]));

$aug_red = rref($aug);

Context('Vector')->variables->add(t => 'Real');
Context()->noreduce('(-x)+y', '(-x)-y');


$eqn_x = Formula($aug_red->element(1, 4) . '-' . $aug_red->element(1, 3) . 't')->reduce;
$eqn_y = Formula($aug_red->element(2, 4) . '-' . $aug_red->element(2, 3) . 't')->reduce;
$sol   = Vector($eqn_x, $eqn_y, 't');

$rma = RadioMultiAnswer(
    [
        ['There is no solution to the linear system'],
        [ 'The solution to the linear system is %s', $sol ]
    ],
    1
);

BEGIN_PGML
Solve the follow linear system using the Gauss-Jordon method:

[``` \begin{aligned}
[$lines[0]] & = [@ Matrix($b)->element(1) @] \\
[$lines[1]] & = [@ Matrix($b)->element(2)-1@] \\
[$lines[2]] & = [@ Matrix($b)->element(3) @]
\end{aligned} ```]

[_]{$rma}

If there is a free variable in your solution use [`t`] as the variable and enter it as a vector like [| <2+t, 3-2t, 7+t/2>|]

END_PGML

BEGIN_PGML_SOLUTION

First, start with the augmented coefficient matrix or
[``` [$aug] ```]

and then perform Gauss-Jordon reduction to get 
[``` [$aug_red] ```]

Since there is a free variable, the [`z=t`] and the top two equations can be written
[```
\begin{aligned}
x & = [$eqn_x] \\
y & = [$eqn_y] \\
\end{aligned}```]

and therfore the solution is [` [$sol] `].
END_PGML_SOLUTION
COMMENT('A linear system with infinite number of solutions that require a free variable.');
ENDDOCUMENT();    # This should be the last executable line in the problem.
