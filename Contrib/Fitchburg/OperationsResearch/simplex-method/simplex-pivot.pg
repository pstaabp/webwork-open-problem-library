## DBsubject('WeBWorK')
## DBchapter('Linears and Linear Function')
## DBsection('Problem')
## Date('September 5, 2008')
## Author('Peter Staab')
## Institution('Fitchburg State University')
# updated 2023.08.20

DOCUMENT();
loadMacros('PGstandard.pl', 'PGML.pl', 'tableau.pl', 'PGcourse.pl');

Context('Point');

# Do not show which answers are incorrect.
$showPartialCorrectAnswers = 0;

#pick the pivot row and col

$col = random(1, 3);
$row = random(1, 3);
$ans = Point($row, $col);

# select random values for the bottom row

if ($col == 1) {
    do {
        ($a, $b, $c) = (random(1, 6), random(1, 6), random(1, 6));
    } until ($a > $b && $a > $c);
} elsif ($col == 2) {
    do {
        ($a, $b, $c) = (random(1, 6), random(1, 6), random(1, 6));
    } until ($b > $a && $b > $c);
} else {
    do {
        ($a, $b, $c) = (random(1, 6), random(1, 6), random(1, 6));
    } until ($c > $b && $c > $a);
}

($a1, $b1, $c1) = (random(1, 5), random(1, 5), random(1, 6));
($a2, $b2, $c2) = (random(1, 5), random(1, 5), random(1, 6));
($a3, $b3, $c3) = (random(1, 5), random(1, 5), random(1, 6));

if ($col == 1) {
    if ($row == 1) {
        $a1 = random(1, 2);
        ($d1, $d2, $d3) = (2 * $a1, random(3, 5) * $a2, random(3, 5) * $a3);
    } elsif ($row == 2) {
        $a2 = random(1, 2);
        ($d1, $d2, $d3) = (random(3, 5) * $a1, 2 * $a2, random(3, 5) * $a3);
    } else {
        $a3 = random(1, 2);
        ($d1, $d2, $d3) = (random(3, 5) * $a1, random(3, 5) * $a2, 2 * $a3);
    }
} elsif ($col == 2) {

    if ($row == 1) {
        $b1 = random(1, 2);
        ($d1, $d2, $d3) = (2 * $b1, random(3, 5) * $b2, random(3, 5) * $b3);
    } elsif ($row == 2) {
        $b2 = random(1, 2);
        ($d1, $d2, $d3) = (random(3, 5) * $b1, 2 * $b2, random(3, 5) * $b3);
    } else {
        $b3 = random(1, 2);
        ($d1, $d2, $d3) = (random(3, 5) * $b1, random(3, 5) * $b2, 2 * $b3);
    }
} else {
    if ($row == 1) {
        $c1 = random(1, 2);
        ($d1, $d2, $d3) = (2 * $c1, random(3, 5) * $c2, random(3, 5) * $c3);
    } elsif ($row == 2) {
        $c2 = random(1, 2);
        ($d1, $d2, $d3) = (random(3, 5) * $c1, 2 * $c2, random(3, 5) * $c3);
    } else {
        $c3 = random(1, 2);
        ($d1, $d2, $d3) = (random(3, 5) * $c1, random(3, 5) * $a2, 2 * $c3);
    }
}

$tab = Tableau->new(
    A =>
        Matrix([ [ $a1, $b1, $c1 ], [ $a2, $b2, $c2 ], [ $a3, $b3, $c3 ] ]),
    b => Vector($d1, $d2, $d3),
    c => Vector($a,  $b,  $c)
);

# Now begin with the Problem Statement

BEGIN_PGML

If the following linear programming problem is written as a simplex tableau:

[@ lop_display($tab) @]*

Determine the pivot row and column for this tableau. List your solution as (row, col).  For example if it is the 2nd row, 3rd column, type (2,3):  [_]{$ans}

END_PGML

ENDDOCUMENT();
