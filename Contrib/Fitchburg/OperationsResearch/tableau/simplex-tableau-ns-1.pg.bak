## DESCRIPTION
## WeBWorK Demo 
## ENDDESCRIPTION

## KEYWORDS('lines')
## Tagged by jjh2b

## DBsubject('WeBWorK')
## DBchapter('Linears and Linear Function')
## DBsection('Problem')
## Date('September 5, 2008')
## Author('Peter Staab')
## Institution('Fitchburg State College')
## TitleText1('')
## EditionText1('')
## AuthorText1('')
## Section1('')
## Problem1('')

DOCUMENT();        # This should be the first executable line in the problem.
loadMacros("PGstandard.pl",
"MathObjects.pl",
"PGmatrixmacros.pl"
);


Context("Numeric");


# Do not show which answers are incorrect.
$showPartialCorrectAnswers = 0;


$a1 = random(2,6);
$b1 = random(2,6);
$c1 = random(2,6);
$d1 = 5*random(2,6);


$a2 = random(2,6);
$b2 = random(2,6);
$c2 = random(2,6);
$d2 = 3*$d1;

$a3 = random(2,6);
$b3 = random(2,6);
$c3 = random(2,6);

$fstr = nicestring([$a3,$b3,$c3],[x_1,x_2,x_3]);

# Now begin with the Problem Statement 

TEXT(beginproblem());
BEGIN_TEXT
The following linear programming problem is a $BBOLD nonstandard $EBOLD problem: 

$PAR
Maximize \(f(x_1,x_2,x_3) = $fstr \) subject to $BR
\(
\begin{cases}
\begin{eqnarray}
$a1 x_1 + $b1 x_2 + $c1 x_3 \leq $d1 \\
$a2 x_1 + $b2 x_2 + $c2 x_3 \geq $d2 \\
\end{eqnarray}
\end{cases}
\)
$PAR
Write the simplex tableau down for this problem:

\{answer_matrix(3,7,5);\} 

END_TEXT

Context()->normalStrings;

# Enter the correct answers to be checked against the answers to the students.

ANS(Real($a1)->cmp);
ANS(Real($b1)->cmp);
ANS(Real($c1)->cmp);
ANS(Real(1.0)->cmp);
ANS(Real(0.0)->cmp);
ANS(Real(0.0)->cmp);
ANS(Real($d1)->cmp);


ANS(Real($a2)->cmp);
ANS(Real($b2)->cmp);
ANS(Real($c2)->cmp);
ANS(Real(0.0)->cmp);
ANS(Real(-1.0)->cmp);
ANS(Real(0.0)->cmp);
ANS(Real($d2)->cmp);

ANS(Real(-$a3)->cmp);
ANS(Real(-$b3)->cmp);
ANS(Real(-$c3)->cmp);
ANS(Real(0.0)->cmp);
ANS(Real(0.0)->cmp);
ANS(Real(1.0)->cmp);
ANS(Real(0.0)->cmp);


# That's it.


ANS(Real(3)->cmp);
ANS(Real(7)->cmp);

ENDDOCUMENT();        # This should be the last executable line in the problem.
